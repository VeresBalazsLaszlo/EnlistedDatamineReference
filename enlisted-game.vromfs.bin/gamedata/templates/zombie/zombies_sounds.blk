plasma_shell_spawn_sound{
  _use:t="oneshot_scene_net_sound"

  _group{
    _tags:t="server"
    oneshot_scene_net_sound__desc:t="ballsShellSpawn"
  }
}

special_weapon_box_sound{
  _use:t="sound_effect"

  _group{
    _tags:t="sound"
    sound_effect__path:t="events/z/enemy/effects/chest"
  }

  "specialWeaponBoxSound:tag"{
    _tags:t="sound"
  }
}

zombie_mode_soldier_loot_sound_paths{

  "human_loot_sound__paths:shared:object"{
    _tags:t="sound"

    "buyAmmo:object"{
      watched:t="events/z/ui/buy_ammo"
    }

    "buyWeapon:object"{
      watched:t="events/z/ui/buy_weapon"
    }
  }
}

zombie_managed_sound{
  _use:t="base_managed_sound"

  _group{
    _tags:t="sound"
    managed_sound__type:t="zombie"
    managed_sound__maxInstances:i=6
  }
}

zombie_loud_managed_sound_override{

  _group{
    _tags:t="sound"
    managed_sound__type:t="zombieloud"
    managed_sound__maxInstances:i=4
  }
}

zombie_spitfire_prop_managed_sound_override{
  _use:t="zombie_loud_managed_sound_override"
}

zombie_crater_managed_sound{
  _use:t="base_managed_sound"

  _group{
    _tags:t="sound"
    managed_sound__type:t="crater"
    managed_sound__maxInstances:i=3
  }
}

zombie_ability_activated_sound{

  _group{
    _tags:t="sound"
    zombie_ability_activated_sound__path:t=""
  }
}

zombie_giant_ability_activated_sound{
  _use:t="zombie_ability_activated_sound"

  _group{
    _tags:t="sound"
    zombie_ability_activated_sound__path:t="events/z/enemy/walker/z_giant/voice_fx/ability_activated"
  }
}

zombie_aggro_voice{

  _group{
    _tags:t="sound"
    zombie_aggro_voice__soundTag:t="isAggressive"
    zombie_aggro_voice__phrase:t="seeDanger"
  }
}

zombie_aggro_net_sound_state{
  zombie_aggro_net_sound_state__isAggressive:b=no
  _replicated:t="zombie_aggro_net_sound_state__isAggressive"
  _tracked:t="zombie_aggro_net_sound_state__isAggressive"
}

zombie_cry_near_hero{

  _group{
    _tags:t="sound"
    zombie_cry_near_hero__isNearHero:b=no
    zombie_cry_near_hero__nextCheckAfter:r=0.0
    zombie_cry_near_hero__nextCryAfter:r=0.0
    zombie_cry_near_hero__distThreshold:r=4.0
    zombie_cry_near_hero__checkCooldown:r=0.5
    zombie_cry_near_hero__cryCooldown:r=5.0
    zombie_cry_near_hero__phrase:t="seeDanger"
  }
}

base_nzombie_sound{
  _use:t="common_human_sound_components"
  _use:t="human_sound_geomtree_nodes"
  _use:t="zombie_managed_sound"
  _use:t="human_voice_effects"
  _use:t="base_human_steps_sound"
  _use:t="human_steps_sound_paths"
  _use:t="base_human_voice_sound"
  _use:t="human_hit_cry_sound"
  _use:t="human_death_sound"
  _use:t="zombie_aggro_voice"
  _use:t="zombie_aggro_net_sound_state"
  _use:t="zombie_cry_near_hero"
  _use:t="human_hit_net_sound"
  _use:t="human_hit_sound_paths"
  _use:t="projectile_hit_human_fx_sound"
  _use:t="human_idle_sound"

  _group{
    _tags:t="sound"
    sound_control__range:r=40.0
  }

  "human_voice_effect__allOrderedEffects:shared:list<t>"{
    _tags:t="sound"
    id:t="dead"
  }
}

zombie_rush_zombie_sound{
  _use:t="base_nzombie_sound"
  _use:t="base_human_melee_impact_sound"

  _group{
    _tags:t="sound"
    human_steps_sound__animSpeedMul:r=8.0
    human_steps_sound__distanceToVolumeEnemy:p4=0.0, 0.0, 3.0, 3.0
    human_steps_sound_generator__enableAlways:b=yes
  }

  _group{
    _tags:t="sound"

    "human_voice_sound__path:shared:object"{
      isAggressive:b=yes
      path:t="events/z/enemy/walker/z/voice_fx"
    }

    "human_voice_sound__descs:shared:object"{

      "death:object"{
        name:t="death"
      }

      "melee:object"{
        name:t="melee"
      }

      "attack:object"{
        name:t="melee/hands"
      }

      "seeDanger:object"{
        name:t="seedanger"
      }

      "hitCry:object"{
        name:t="hit"
      }
    }

    "human_voice_sound__irqs:shared:object"{

      "zombie_attack_sound:object"{
        phrase:t="attack"
      }
    }
  }

  _group{
    _tags:t="sound"

    "human_idle_sound__paths:shared:object"{

      "idleState:object"{
        other:t="events/z/enemy/walker/z/voice_fx/idle"
      }
    }
  }

  "human_steps_sound__stepFx:shared:object"{
    _tags:t="sound"

    "run:object"{
      isAggressive:b=yes
      other:t="events/z/enemy/walker/z/voice_fx/run_to_player"
    }

    "sprint:object"{
      isAggressive:b=yes
      other:t="events/z/enemy/walker/z/voice_fx/run_to_player"
    }
  }
}

