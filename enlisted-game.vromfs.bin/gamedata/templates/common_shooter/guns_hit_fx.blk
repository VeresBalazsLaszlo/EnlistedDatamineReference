      wood_needles_snow_solid:t="hit_basic_bush_needles_snow_effect"
    }

    "global_ground_wave_fx__maxImpulses:list<r>"{
      maxImpulse:r=10.0
      maxImpulse:r=100.0
      maxImpulse:r=1000000.0
    }

    "global_ground_wave_fx__effectGroups:array"{

      "group:object"{
      }

      "group:object"{
        maxDistanceFromGun:r=3.0
        leavesCheckRadius:r=4.0
        leavesAlwaysSpawn:b=no
        defaultFx:t="hit_ground_wave_medium_dirt_effect"
        grassFx:t="hit_ground_wave_medium_grass_effect"
        leavesFx:t="hit_ground_wave_medium_leaves_effect"

        "info:object"{
          group__dirt_and_mud:t="hit_ground_wave_medium_dirt_effect"
          group__sand:t="hit_ground_wave_medium_sand_effect"
          group__snow:t="hit_ground_wave_medium_snow_effect"
          group__stone:t="hit_ground_wave_medium_stone_effect"
        }
      }

      "group:object"{
        maxDistanceFromGun:r=4.0
        leavesCheckRadius:r=4.0
        defaultFx:t="hit_ground_wave_big_dirt_effect"
        grassFx:t="hit_ground_wave_big_grass_effect"
        leavesFx:t="hit_ground_wave_big_leaves_effect"

        "info:object"{
          group__dirt_and_mud:t="hit_ground_wave_big_dirt_effect"
