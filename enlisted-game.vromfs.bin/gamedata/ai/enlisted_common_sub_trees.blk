sequencer{
  name:t="sub.chooseMaxStance"

  orderedSelector{

    chooseMinMaxStancesForCoverAttack{
    }

    sequencer{

      chooseMaxStance{
      }

      orderedSelector{

        sequencer{

          isAgentPlayerBot{
          }

          setIntVar{
            to:t="minStance"
            value:i=1
          }
        }

        setIntVar{
          to:t="minStance"
          value:i=0
        }
      }
    }
  }
}

sequencer{
  name:t="sub.deactivateWeapMod"

  deactivateWeapMod{
  }
}

sequencer{
  name:t="sub.checkDowned"

  isDowned{
  }

  setDebugSym{
    r:i=2
  }

  recalculateTree{
  }
}

sequencer{
  name:t="sub.checkBurning"

  isBurning{
  }

  setDebugSym{
    r:i=3
  }

  recalculateTree{
  }
}

sequencer{
  name:t="sub.findCover"

  getRegroupPos{
    posParam:t="regroupPosition"
  }

  getRegroupDistance{
    minDist:r=8.0
    distParam:t="regroupDistance"
  }

  findCover{
    centerParam:t="regroupPosition"
    centerRadiusParam:t="regroupDistance"
    radius:r=8.0
    dangerRadius:r=0.0
    dangerMinNoiseLevel:r=0.5
    coverPosParam:t="coverPos"
  }

  calcDistance{
    startPosParam:t="coverPos"
    endPosParam:t="regroupPosition"
    distanceParam:t="coverRegroupDistance"
  }

  checkDistance{
    posParam:t="coverPos"
    radiusParam:t="coverRegroupDistance"
    yRadius:r=2.5
  }

  copyPoint3Var{
    from:t="coverPos"
    to:t="wishPosition"
  }
}

sequencer{
  name:t="sub.findCoverAroundLeader"

  getRegroupPos{
    posParam:t="regroupPosition"
  }

  ifThenElse{

    and{

      isSquadLeaderMoving{
      }

      isAggressiveBehaviour{
      }
    }

    setRealVar{
      to:t="possibleAngle"
      value:r=180.0
    }

    setRealVar{
      to:t="possibleAngle"
      value:r=80.0
    }
  }

  orderedSelector{

    sequencer{

      findCoverAroundPoint{
        centerParam:t="regroupPosition"
        radius:r=3.0
        possibleAngleParam:t="possibleAngle"
        coverPosParam:t="coverPos"
        minDist:r=2.0
        maxOccupied:i=3
        traceVisible:b=yes
      }

      checkAllowedPosition{
        posParam:t="coverPos"
      }
    }

    sequencer{

      findCoverAroundPoint{
        centerParam:t="regroupPosition"
        radius:r=4.0
        possibleAngleParam:t="possibleAngle"
        coverPosParam:t="coverPos"
        minDist:r=3.0
        maxOccupied:i=2
        traceVisible:b=yes
      }

      checkAllowedPosition{
        posParam:t="coverPos"
      }
    }

    sequencer{

      findCoverAroundPoint{
        centerParam:t="regroupPosition"
        radius:r=3.0
        possibleAngle:r=180.0
        coverPosParam:t="coverPos"
        minDist:r=1.0
      }

      checkAllowedPosition{
        posParam:t="coverPos"
      }
    }

    sequencer{

      not{

        isLeader{
        }
      }

      getRegroupPos{
        posParam:t="prevRegroupPos"
        alternate:i=1
      }

      orderedSelector{

        sequencer{

          findCoverAroundPoint{
            centerParam:t="prevRegroupPos"
            radius:r=3.0
            possibleAngleParam:t="possibleAngle"
            coverPosParam:t="coverPos"
            minDist:r=2.0
            maxOccupied:i=3
            traceVisible:b=yes
          }

          checkAllowedPosition{
            posParam:t="coverPos"
          }
        }

        sequencer{

          findCoverAroundPoint{
            centerParam:t="prevRegroupPos"
            radius:r=4.0
            possibleAngleParam:t="possibleAngle"
            coverPosParam:t="coverPos"
            minDist:r=3.0
            maxOccupied:i=2
            traceVisible:b=yes
          }

          checkAllowedPosition{
            posParam:t="coverPos"
          }
        }

        sequencer{

          findCoverAroundPoint{
            centerParam:t="prevRegroupPos"
            radius:r=3.0
            possibleAngle:r=180.0
            coverPosParam:t="coverPos"
            minDist:r=1.0
          }

          checkAllowedPosition{
            posParam:t="coverPos"
          }
        }
      }
    }
  }

  checkAllowedPosition{
    posParam:t="coverPos"
  }

  copyPoint3Var{
    from:t="coverPos"
    to:t="wishPosition"
  }
}

sequencer{
  name:t="sub.findCoverAroundLeaderAway"

  getRegroupPos{
    posParam:t="regroupPosition"
  }

  getOrderPosition{
    posParam:t="regroupPosition"
    orderPosParam:t="spreadPos"
    traceVisible:b=yes
  }

  ifThenElse{

    and{

      isSquadLeaderMoving{
      }

      isAggressiveBehaviour{
      }
    }

    setRealVar{
      to:t="possibleAngle"
      value:r=180.0
    }

    setRealVar{
      to:t="possibleAngle"
      value:r=100.0
    }
  }

  orderedSelector{

    sequencer{

      findCoverAroundPoint{
        centerParam:t="spreadPos"
        radius:r=5.0
        possibleAngleParam:t="possibleAngle"
        coverPosParam:t="coverPos"
        minDist:r=0.0
        maxOccupied:i=1
        traceVisible:b=yes
      }

      checkAllowedPosition{
        posParam:t="coverPos"
      }
    }

    sequencer{

      findCoverAroundPoint{
        centerParam:t="spreadPos"
        radius:r=3.0
        possibleAngleParam:t="possibleAngle"
        coverPosParam:t="coverPos"
        minDist:r=0.0
        maxOccupied:i=2
        traceVisible:b=yes
      }

      checkAllowedPosition{
        posParam:t="coverPos"
      }
    }

    sequencer{

      findCoverAroundPoint{
        centerParam:t="regroupPosition"
        radius:r=5.0
        possibleAngle:r=180.0
        coverPosParam:t="coverPos"
        minDist:r=3.0
        traceVisible:b=yes
      }

      checkAllowedPosition{
        posParam:t="coverPos"
      }
    }

    sequencer{

      findCoverAroundPoint{
        centerParam:t="regroupPosition"
        radius:r=3.0
        possibleAngle:r=180.0
        coverPosParam:t="coverPos"
        minDist:r=2.0
      }

      checkAllowedPosition{
        posParam:t="coverPos"
      }
    }

    sequencer{

      not{

        isLeader{
        }
      }

      getRegroupPos{
        posParam:t="prevRegroupPos"
        alternate:i=1
      }

      getOrderPosition{
        posParam:t="prevRegroupPos"
        orderPosParam:t="spreadPos"
        traceVisible:b=yes
        alternate:i=1
      }

      orderedSelector{

        sequencer{

          findCoverAroundPoint{
            centerParam:t="spreadPos"
            radius:r=5.0
            possibleAngleParam:t="possibleAngle"
            coverPosParam:t="coverPos"
            minDist:r=0.0
            maxOccupied:i=1
            traceVisible:b=yes
          }

          checkAllowedPosition{
            posParam:t="coverPos"
          }
        }

        sequencer{

          findCoverAroundPoint{
            centerParam:t="spreadPos"
            radius:r=3.0
            possibleAngleParam:t="possibleAngle"
            coverPosParam:t="coverPos"
            minDist:r=0.0
            maxOccupied:i=2
            traceVisible:b=yes
          }

          checkAllowedPosition{
            posParam:t="coverPos"
          }
        }

        sequencer{

          findCoverAroundPoint{
            centerParam:t="prevRegroupPos"
            radius:r=5.0
            possibleAngle:r=180.0
            coverPosParam:t="coverPos"
            minDist:r=3.0
            traceVisible:b=yes
          }

          checkAllowedPosition{
            posParam:t="coverPos"
          }
        }

        sequencer{

          findCoverAroundPoint{
            centerParam:t="prevRegroupPos"
            radius:r=3.0
            possibleAngle:r=180.0
            coverPosParam:t="coverPos"
            minDist:r=2.0
          }

          checkAllowedPosition{
            posParam:t="coverPos"
          }
        }
      }
    }
  }

  checkAllowedPosition{
    posParam:t="coverPos"
  }

  copyPoint3Var{
    from:t="coverPos"
    to:t="wishPosition"
  }
}

sequencer{
