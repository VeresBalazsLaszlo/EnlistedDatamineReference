base_ju_88a_4{
  plane_phys_damage__blk:t="gamedata/units/ju_88a_4.blk"
  animchar__res:t="ju_88a_4_char"
}

ju_88a_4_wreckage{
  _use:t="base_ju_88a_4"
  _use:t="plane_wreckage"
  plane_wreckage__nodeName:t=""
  plane_wreckage__typeName:t=""
}

ju_88a_4_base{
  _use:t="plane"
  _use:t="base_ju_88a_4"
  collres__res:t="ju_88a_4_collision"
  plane_net_phys__blk:t="gamedata/units/ju_88a_4.blk"
  damage_model__blk:t="gamedata/units/ju_88a_4.blk"
  plane_collision__blk:t="gamedata/units/ju_88a_4.blk"
  plane_anim__blk:t="gamedata/units/ju_88a_4.blk"
  plane_sight__blk:t="gamedata/units/ju_88a_4.blk"
  canUseRespawnbaseType:t="aircraft_assault"
  is_seaplane:b=no
  plane_wreckage__template:t="ju_88a_4_wreckage"
  killLogName:t="ju_88a_4"
  animchar__res:t="ju_88a_4_char"
  vehicle_seats_camera_nodes__defaultNode:t=""

  _group{
    _tags:t="render"
    animchar_camera_target__node_name:t=""
    animchar_camera_target__node_offset:p3=0.0, 0.0, 0.0
  }

  "vehicle_seats_can_acquire_controls:list<i>"{
  }

  "vehicle_seats__canAcquireControls:shared:object"{

    "driver:object"{
      movement:b=yes
      turrets:b=yes
    }

    "main_gunner:object"{
      turrets:b=yes
    }
  }
}