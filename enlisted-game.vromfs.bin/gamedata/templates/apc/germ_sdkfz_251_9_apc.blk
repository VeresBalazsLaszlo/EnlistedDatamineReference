germ_sdkfz_251_9_apc{
  _use:t="germ_sdkfz_251_9_apc_common"
  _use:t="apc_settings"
  mobile_respawn__seatOffset:i=4

  "disableDMParts:list<t>"{
    part:t="gunner"
    part:t="loader"
    part:t="commander"
    part:t="machine_gunner"
    part:t="driver"
  }

  "turrets__initAmmoDistribution:array"{

    "ammo:object"{
      slot:i=0
      count:i=10
    }

    "ammo:object"{
      slot:i=1
      count:i=18
    }

    "ammo:object"{
      slot:i=4
      count:i=10
    }
  }
}

