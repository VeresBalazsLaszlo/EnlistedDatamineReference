jp_type_5_ho_ri_prototype_premium{
  _use:t="jp_type_5_ho_ri_prototype_common"
}

jp_type_5_ho_ri_prototype_common{
  _use:t="base_type_5_ho_ri_prototype"
  _use:t="jp_type_5_ho_ri_prototype_common_vehicle_sound"
  item__iconOffset:p2=0.05, 0.15
  item__iconScale:r=1.2
  commanderCockpitFpsCamMaxAngle:p2=40.0, 5.0
  gunner_cam_limit__useCockpitDir:b=yes

  "onlyRootDecorAttach:tag"{
  }

  "vehicle_seats__effectors:array"{
  }

  "vehicle_seats__seatsProvideOrder:tag"{
  }

  "vehicle_seats__seats:shared:array"{

    "seats:object"{
      name:t="commander"
      nextSeat:t="main_gunner"
      locName:t="vehicle_seats/commander"
      attachNode:t="commander"
      shouldHideOwner:b=no
      maxPosWithOpenHatch:r=1.2
      hatchRotationAxis:p3=1.7, 0.0, 0.0
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.705575, -0.541623, 0.137145] [0.531672, 0.71878, 0.103343] [-0.171722, 5.50837e-08, 0.883466] [-0.3, 0.14, 0.07]]
      seatComponent:t="isDriver"
      receiveDamageFromDMPart:t="commander"
      cameraNodeName:t="bone_turret"
      cockpitTemplate:t="jp_type_5_ho_ri_prototype_commander_cockpit"
      isHoldGunModeAllowed:b=no

      "effectors:object"{
        r.hand:t="righthand_3"
        l.hand:t="lefthand_3"
        r.foot:t="pedal_rfoot_3"
        l.foot:t="pedal_lfoot_3"
      }
    }

    "seats:object"{
      name:t="main_gunner"
      locName:t="vehicle_seats/gunner"
      attachNode:t="gunner"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.789047, -0.337131, -0.271647] [0.31877, 0.834498, -0.109743] [0.292972, -8.91184e-07, 0.850992] [-0.5, 0.03, 0.08]]
      seatComponent:t="isGunner"
      nextSeat:t="driver"
      shouldHideOwner:b=no
      receiveDamageFromDMPart:t="gunner"
      cameraNodeName:t="bone_camera_gunner"
      cockpitTemplate:t="jp_type_5_ho_ri_prototype_gunner_cockpit"
      isHoldGunModeAllowed:b=no

      "turretNames:array"{
        turret:t="turret_01"
      }

      "effectors:object"{
        r.hand:t="righthand_4"
        l.hand:t="lefthand_4"
        r.foot:t="pedal_rfoot_4"
        l.foot:t="pedal_lfoot_4"
      }
    }

    "seats:object"{
      name:t="driver"
      locName:t="vehicle_seats/driver"
      seatOwnsEntityControl:b=yes
      attachNode:t="driver"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.876937, 0.20244, -1.32295e-09] [-0.20244, 0.876937, 3.05403e-10] [1.35775e-09, -8.1322e-19, 0.9] [-0.3, -0.15, 0.0]]
      seatComponent:t="isDriver"
      shouldHideOwner:b=no
      receiveDamageFromDMPart:t="driver"
      cameraNodeName:t="bone_camera_driver"
      cameraOffset:p3=0.15, -0.0, -0.0
      cockpitTemplate:t="jp_type_5_ho_ri_prototype_driver_cockpit"
      isHoldGunModeAllowed:b=no

      "effectors:object"{
        r.hand:t="righthand_1"
        l.hand:t="lefthand_1"
        r.foot:t="pedal_rfoot_1"
        l.foot:t="pedal_lfoot_1"
      }
    }

    "seats:object"{
      name:t="loader"
      canPlaceManually:b=no
      attachNode:t="loader_01"
      locName:t="vehicle_seats/loader"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.372962, -0.292947, 0.764681] [0.128431, 0.850852, 0.263319] [-0.808404, 4.66935e-07, 0.394287] [-0.1, -0.29, -0.43]]
      seatComponent:t="isPassenger"
      shouldHideOwner:b=no
      receiveDamageFromDMPart:t="loader_01"
      cameraNodeName:t="bone_camera_driver"
      isHoldGunModeAllowed:b=no

      "loaderTurretNames:array"{
        turret:t="turret_01"
      }

      "effectors:object"{
        r.hand:t="righthand_5"
        l.hand:t="lefthand_5"
        r.foot:t="pedal_rfoot_5"
        l.foot:t="pedal_lfoot_5"
      }
    }

    "seats:object"{
      name:t="loader"
      canPlaceManually:b=no
      attachNode:t="loader_02"
      locName:t="vehicle_seats/loader"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[-0.0301678, -0.248071, -0.86461] [-0.00864995, 0.86515, -0.247924] [0.899459, -5.22286e-07, -0.0313836] [-0.04, -0.32, 0.47]]
      seatComponent:t="isPassenger"
      shouldHideOwner:b=no
      receiveDamageFromDMPart:t="loader_02"
      cameraNodeName:t="bone_camera_driver"
      isHoldGunModeAllowed:b=no

      "loaderTurretNames:array"{
        turret:t="turret_01"
      }

      "effectors:object"{
        r.hand:t="righthand_6"
        l.hand:t="lefthand_6"
        r.foot:t="pedal_rfoot_6"
        l.foot:t="pedal_lfoot_6"
      }
    }

    "seats:object"{
      attachNode:t="machine_gunner"
      locName:t="vehicle_seats/radioman"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.855979, 0.278124, 0.0] [-0.278124, 0.855979, 0.0] [0.0, 0.0, 0.900017] [-0.25, -0.32, 0.0]]
      seatComponent:t="isPassenger"
      shouldHideOwner:b=no
      receiveDamageFromDMPart:t="machine_gunner"
      cameraNodeName:t="bone_camera_driver"
      isHoldGunModeAllowed:b=no

      "effectors:object"{
        r.hand:t="righthand_2"
        l.hand:t="lefthand_2"
        r.foot:t="pedal_rfoot_2"
        l.foot:t="pedal_lfoot_2"
      }
