    }

    "turretInfo:object"{
      turretName:t="turret_03"
      turretGroup:t="cannon_turrets"
      trigger:t="cannons"
      gun:t="planegun_i_185_m82_20mm_shvaks_01"
    }

    "turretInfo:object"{
      turretName:t="turret_04"
      turretGroup:t="cannon_turrets"
      trigger:t="cannons"
      gun:t="planegun_i_185_m82_20mm_shvaks_02"
