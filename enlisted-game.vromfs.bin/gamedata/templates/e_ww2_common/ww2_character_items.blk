attachable_head_base{
  _use:t="attachable_wear_without_collres_animchar"
  _use:t="attachable_scaled_item"
  _use:t="attachable_wear_broken_bones"
  _use:t="node_collapser"
  _tracked:t="attaches_list"
  animchar__updatable:b=yes
  animchar_hider__camThreshold:r=0.3
  randomAnimStart:b=yes

  "torn_wounds__name_list:list<t>"{
    name:t="head"
  }

  "attaches_list:list<eid>"{
  }

  "skeleton_attach__remapAffectSlots:list<t>"{
    slot:t="head"
    slot:t="skined_helmet"
    slot:t="face_equipment"
    slot:t="helmet"
  }

  "updatableNodeCollapser:tag"{
  }

  "hideShadowFromCollapsedNode:tag"{
  }

  "animchar_attaches__animated:tag"{
  }

  "animcharParams:object"{
  }

  "animchar__noUpdateOnDeath:tag"{
  }

  "item__equipToSlots:array"{
    slot:t="face"
  }

  _group{
    _tags:t="render"

    "dynamic_details__groups:object"{

      "dirts:array"{
        item:t="dirt_face_01_tex"
        item:t="dirt_face_02_tex"
        item:t="dirt_face_03_tex"
        item:t="dirt_face_04_tex"
        item:t="dirt_face_05_tex"
        item:t="dirt_face_06_tex"
      }

      "bloods:array"{
        item:t="blood_face_01_tex"
        item:t="blood_face_02_tex"
        item:t="blood_face_03_tex"
        item:t="blood_face_04_tex"
        item:t="blood_face_05_tex"
      }

      "scars:array"{
        item:t="scar_01_tex"
        item:t="scar_02_tex"
        item:t="scar_03_tex"
        item:t="scar_04_tex"
        item:t="scar_05_tex"
        item:t="scar_06_tex"
        item:t="scar_07_tex"
      }

      "stubbles:array"{
        item:t="stubble_01_tex"
      }
    }

    "dynamic_details__presets:array"{

      "preset:object"{

        "dirts:object"{
          details_min:i=1
          details_max:i=1
        }

        "bloods:object"{
          details_max:i=1
        }

        "scars:object"{
          details_max:i=1
        }

        "stubbles:object"{
          details_max:i=1
        }
      }
    }
  }

  "animchar__noUpdateOnDedicated:tag"{
  }

  "isAttachableHead:tag"{
  }
}

