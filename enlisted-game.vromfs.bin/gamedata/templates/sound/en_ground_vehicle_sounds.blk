      other:t="enemy/vehicle/tank/panzer3/engine"
    }

    "vehicle_engine_sound__startPath:shared:object"{
      watched:t="player/vehicle/tank/panzer3/engine_start"
      other:t="enemy/vehicle/tank/panzer3/engine_start"
    }

    "vehicle_engine_sound__stopPath:shared:object"{
      watched:t="player/vehicle/tank/panzer3/engine_stop"
      other:t="enemy/vehicle/tank/panzer3/engine_stop"
    }
  }
}

