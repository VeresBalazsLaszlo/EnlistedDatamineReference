VehiclePhys{
  skipUpdateOnSleep:b=yes

  Mass{
    Empty:r=8000.0
    Fuel:r=100.0
    TakeOff:r=8100.0
    momentOfInertia:p3=2.0, 2.0, 5.0
    CenterOfGravity:p3=0.2, 0.2, 0.0
    AdvancedMass:b=yes
    trackMass:r=200.0
    CenterOfGravityClampY:p2=0.0, 0.45
  }

  tracks{
    animationMultiplier:r=-0.5
    height:r=0.06
    width:r=0.34
    tracksTensionK:p3=6.0, 10.0, 6.0
    trackMesh:t="us_halftrack_m16_phys_track_line"
    trackLen:r=0.1
    trackCount:i=59
    trackFadeTime:r=1.0
    trackStartOffset:r=0.13
    trackMaxHeight:r=1.07
    trackEmitSparks:b=no
  }

  collisionProps{
    cls_turret_01:t="convex_hull"
    cls_body:t="convex_hull"
  }

  engine{
    horsePowers:r=148.0
    maxRPM:r=3000.0
    minRPM:r=700.0
  }

  mechanics{
    maxBrakeForce:r=30000.0
    driveGearRadius:r=0.26
    mainGearRatio:r=1.4
    sideGearRatio:r=2.88

    gearRatios{
      ratio:r=-7.32
      ratio:r=-14.22
      ratio:r=0.0
      ratio:r=12.2
      ratio:r=6.46
      ratio:r=4.91
      ratio:r=4.3
      ratio:r=2.6
      ratio:r=2.49
      ratio:r=1.71
      ratio:r=1.0
    }
  }

  floats{
    waterCoeff:r=0.5
  }

  suspension{
    suspensionOffsets:p3=-0.12, -0.11, 0.05
    defaultGearRadius:r=0.13
    topGearRadius:r=0.091
    frontBackGearRadius:r=0.24
    defaultDampeningForce:p2=15000.0, 15000.0
    dampeningRelaxationRatio:r=0.4
    dampeningCompressionRatio:r=0.15
    brokenWheelSteeringDeflection:r=-15.0
    wheel_l_01:r=0.43
    wheel_r_01:r=0.43
    recalcWtms:b=yes

    wheels{
      wheel_r_01:b=yes
      wheel_l_01:b=yes
    }

    driven{
      wheel_l_01:b=no
      wheel_r_01:b=no
    }

    steeringDeflection{
      wheel_r_01:r=21.0
      wheel_l_01:r=21.0
      steeringTau:r=0.5
      steeringSpd:r=1.0
      steeringNeutralSpd:r=3.0
    }

    wheelsDamageWeight{
      wheel_l_01:r=0.4
      wheel_r_01:r=0.4
    }

    steeringNodes{
      wheel_r_01:t="bone_wheel_r_01"
      wheel_l_01:t="bone_wheel_l_01"
    }

    wheelsWidth{
      wheel_l_01:r=0.28
      wheel_r_01:r=0.28
    }
  }
}

