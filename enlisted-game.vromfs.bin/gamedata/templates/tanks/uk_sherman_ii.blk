      shouldHideOwner:b=yes
      ignoreAttachNodeRotation:b=yes
      hatchRotationAxis:p3=1.6, 0.0, 0.0
      attachTm:m=[[0.876954, 0.202456, 0.0] [-0.202456, 0.876954, 0.0] [0.0, 0.0, 0.90003] [-0.4, -0.4, 0.03]]
      seatComponent:t="isDriver"
