sequencer{
  name:t="sub.updateRegroupPosDefault"

  isLeader{
  }

  setDebugSym{
    act:t="L0"
  }

  setDebugSym{
    act:t="L8"
  }

  setDebugSym{
    act:t="L1"
  }

  setDebugSym{
    act:t="L2"
  }

  wait{
    range:p2=1.0, 1.0
    resetable:b=no
  }

  success{

    setSquadFormation{
      formation:t="standard"
    }
  }

  not{

    tryFollowSquadAutoRoute{
      outPosParam:t="regroupPosition"
    }
  }

  orderedSelector{

    isUnderwater{
    }

    not{

      isMortarsSquad{
      }
    }

    sequencer{

      periodicTimer{
        timeParam:t="onChangeLeaderFollowPos"
        timePeriod:p2=20.0, 30.0
      }

      orderedSelector{

        sequencer{

          subTree{
            treeName:t="sub.tryMortarSquadAttack"
          }

          ignoreChance{
            chance:r=0.5
          }
        }

        orderedSelector{

          sequencer{

            isVarsIntEqual{
              lhs:t="mortarAtPosition"
              rhs_value:i=1
            }

            ignoreChance{
              chance:r=0.6
            }

            setIntVar{
              to:t="mortarAtPosition"
              value:i=0
            }

            findPointNearCapzone{
              posParam:t="regroupPosition"
            }
          }

          sequencer{

            ignoreChance{
              chance:r=0.7
            }

            findPointInCapzone{
              posParam:t="regroupPosition"
              closestPoint:b=yes
            }

            resetNearCapzone{
            }
          }

          sequencer{

            findPointNearCapzone{
              posParam:t="regroupPosition"
              closestPoint:b=yes
            }
          }
        }
      }

      break{
      }
    }
  }

  orderedSelector{

    sequencer{

      findDanger{
        paramName:t="testEnemy"
        radiusParamName:t="enemyNearRadius"
        minDanger:r=-1.0
        tag:t="human"
      }

      periodicTimer{
        timeParam:t="onChangeLeaderFollowPos"
        timePeriod:p2=10.0, 12.5
      }
    }

    sequencer{

      periodicTimer{
        timeParam:t="onChangeLeaderFollowPos"
        timePeriod:p2=30.0, 40.0
      }
    }
  }

  orderedSelector{

    sequencer{

      findPointInCapzone{
        posParam:t="regroupPosition"
      }

      resetNearCapzone{
      }
    }

    findPointNearCapzone{
      posParam:t="regroupPosition"
    }
  }
}

