base_type_5_ho_ri_production{
  _use:t="base_tank"
  _use:t="type_5_ho_ri_production_ammo_stowages"
  killLogName:t="jp_type_5_ho_ri_production"
  animchar__res:t="type_5_ho_ri_production_char"
  animchar_fast_phys__res:t="type_5_ho_ri_production_fastphys"
  isCrewHiddenByTurret:b=no
  collres__res:t="type_5_ho_ri_production_collision"
  vehicle_net_phys__blk:t="gamedata/gen/units/tanks/type_5_ho_ri_production.blk:VehiclePhys"
  particle_phys__blk:t="gamedata/gen/units/tanks/type_5_ho_ri_production.blk:PhysSys"
  dmg_animchar__res:t="type_5_ho_ri_production_dmg_char"
  xray_resource__modelName:t="type_5_ho_ri_production"
  cockpit__zoomOutFov:r=8.5772
  cockpit__zoomInFov:r=9.2806
  cockpit__sightName:t="sight_model/ho_ri_sight"
  cockpit__sightFov:r=6.5
  drowningHeight:r=2.44
  damage_model__blk:t="gamedata/gen/units/tanks/type_5_ho_ri_production.blk"
  item__name:t="items/jp_type_5_ho_ri_production"
  skin__template:t="type_5_ho_ri_production_skins"
  losable_turret__detachBone:t="bone_turret"
  losable_turret__detachCollNode:t="cls_gun"
  losable_turret__mass:r=8000.0
  losable_turret__deviation:r=0.5
  losable_turret__rotation:r=0.5
  fire_damage__openHatchesOnExplosion:b=yes

  animchar_fast_phys{
    _tags:t="gameClient"
  }

  "turret_gun_flash_fx__flashNodes:shared:array"{
    node:t="emtr_gun_flame_01"
  }

  "turret_gun_flash_fx__flashFx:shared:array"{
    fx:t="muzzle_ground_100mm"
  }

  "turret_gun_flash_fx__flashFxScale:shared:array"{
    scale:r=1.0
  }

  "turret_control__emitterNodes:shared:array"{
    node:t="bone_gun_barrel"
  }

  "turret_control__animVars:shared:array"{

    "vars:object"{
      curYawParamName:t="turret_01_yaw"
      curPitchParamName:t="gun_01_pitch"
      aimActiveParamName:t="aim_01_active"
      paramYawSpeed:t="turret_01_yaw_speed"
      paramYawSpeedMul:t="turret_01_yaw_mul"
      paramYawAccel:t="turret_01_yaw_accel"
      paramMinYawAngle:t="turret_01_min_yaw_angle"
      paramMaxYawAngle:t="turret_01_max_yaw_angle"
      paramMinPitchAngle:t="turret_01_min_pitch_angle"
      paramMaxPitchAngle:t="turret_01_max_pitch_angle"
      paramPitchSpeed:t="gun_01_pitch_speed"
      paramPitchSpeedMul:t="gun_01_pitch_mul"
      paramPitchAccel:t="gun_01_pitch_accel"
      wishYawParamName:t="gun_01_aim:targetYaw"
      wishPitchParamName:t="gun_01_aim:targetPitch"
      gunRecoilParamName:t="gun_01_recoil"
    }
  }

  "turret_control__turretInfo:shared:array"{

    "turretInfo:object"{
      turretName:t="turret_01"
      gun:t="type_5_ho_ri_production_turret_01_105mm_type5+turret_with_several_types_of_shells+main_turret"
      barrelDm:t="gun_barrel"
      breechDm:t="cannon_breech"
      verDriveDm:t="drive_turret_v"
      horDriveDm:t="drive_turret_h"
      salt:i=1
      gunRecoilKickTime:r=0.1
      gunRecoilReturnTime:r=0.55
    }
  }
}

type_5_ho_ri_production_turret_01_105mm_type5{
  _use:t="tankgun_105mm_type5"
  gun__shootNodeName:t="bone_gun_barrel"
  turret__yawSpeed:r=6.0
  turret__pitchSpeed:r=4.0
  turret__aimNodeName:t="bone_turret"
  turret__limit:p4=-10.0, 10.0, -10.0, 20.0
  turret__minPitchForHideCrew:r=0.0

  "turret__limitsTable:list<p4>"{
    lim1:p4=-10.0, -6.0, -6.0, 20.0
    lim2:p4=-6.0, -5.0, -7.0, 20.0
    lim3:p4=-5.0, -3.0, -8.0, 20.0
    lim4:p4=-3.0, 3.0, -10.0, 20.0
    lim5:p4=3.0, 5.0, -8.0, 20.0
    lim6:p4=5.0, 6.0, -7.0, 20.0
    lim7:p4=6.0, 10.0, -6.0, 20.0
  }

  "gun__shellsAmmo:array"{
    ammo:i=26
    ammo:i=25
  }
}

type_5_ho_ri_production_ammo_stowages{
  _tags:t="server"
