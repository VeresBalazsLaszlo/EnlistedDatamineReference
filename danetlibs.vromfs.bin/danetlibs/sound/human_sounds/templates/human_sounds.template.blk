      mat:t="snow"
      mat:t="sand"
      mat:t="barbwire"
      mat:t="ice"
      mat:t="gravel"
      mat:t="leaves"
    }

    "sound_physmat__physmatToSoundmat:object"{
      barbwire:t="barbwire"
      buildings:t="concrete"
      bushes_dead:t="highgrass"
      bushes_fall:t="highgrass"
      bushes_palm:t="highgrass"
      bushes_snow:t="highgrass"
      bushes_wall:t="highgrass"
      bushes:t="highgrass"
