VehiclePhys{
  skipUpdateOnSleep:b=yes

  Mass{
    Empty:r=64500.0
    Fuel:r=500.0
    TakeOff:r=65000.0
    momentOfInertia:p3=5.0, 6.0, 8.0
    CenterOfGravity:p3=0.0, 0.5, 0.0
    AdvancedMass:b=no
    trackMass:r=3300.0
    CenterOfGravityClampY:p2=0.0, 0.7
  }

  tracks{
    animationMultiplier:r=0.68
    width:r=0.64
    height:r=0.06
    tracksTensionK:p3=3.0, 10.0, 6.0
    trackMesh:t="ger_elefant_phys_track_line"
    trackLen:r=0.26
    trackCount:i=54
    trackFadeTime:r=0.015
    trackConnector:b=yes
    trackStartOffset:r=0.03
    trackMaxSinking:r=0.02
    trackMaxHeight:r=1.1
  }

  collisionProps{
    cls_body_01:t="convex_hull"
    cls_body_02:t="convex_hull"
  }

  engine{
    horsePowers:r=625.0
    maxRPM:r=2600.0
    minRPM:r=600.0
  }

  mechanics{
    steerType:t="clutch_braking"
    maxBrakeForce:r=270000.0
    driveGearRadius:r=0.4
    mainGearRatio:r=14.5
    sideGearRatio:r=1.0
    neutralGearRatio:r=16.0

    gearRatios{
      ratio:r=-0.9
      ratio:r=-1.27
      ratio:r=-1.83
      ratio:r=-2.87
      ratio:r=-4.56
      ratio:r=-9.21
      ratio:r=0.0
      ratio:r=9.21
      ratio:r=4.56
      ratio:r=2.87
      ratio:r=1.83
      ratio:r=1.27
      ratio:r=0.9
    }
  }

  suspension{
    suspensionOffsets:p3=-0.2, -0.2, 0.1
    defaultGearRadius:r=0.37
    frontBackGearRadius:r=0.41
    defaultDampeningForce:p2=140000.0, 1400000.0
    dampeningRelaxationRatio:r=0.4
    dampeningCompressionRatio:r=0.15
    recalcWtms:b=yes
  }
}

