global_hit_fx_info{
  _use:t="global_hit_fx_info_base"
  _use:t="gun_environment_fx"

  _group{
    _hide:b=yes
    global_shatter_fx__countToTraceCount:p4=10.0, 1000.0, 0.0, 100.0
    global_shatter_fx__radiusToTraceRadius:p4=2.0, 100.0, 3.7, 15.0
    global_shatter_fx__minRadiusRatio:r=0.5
    global_shatter_fx__maxDistance:r=30.0

    "global_hit_fx__bulletTypeGroups:object"{

      "smoke:list<t>"{
        type:t="smoke_tank"
        type:t="smoke_grenade_tank"
      }

      "non_explosive:list<t>"{
        type:t="ball"
        type:t="ball_M2"
