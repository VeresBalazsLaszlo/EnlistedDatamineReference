VehiclePhys{
  skipUpdateOnSleep:b=yes

  Mass{
    Empty:r=1213.0
    Fuel:r=43.0
    TakeOff:r=1213.0
    momentOfInertia:p3=0.293535, 1.014073, 0.904327
    CenterOfGravity:p3=0.0, 0.2, 0.0
    CenterOfGravityClampY:p2=0.0, 0.2
    AdvancedMass:b=no
    trackMass:r=4.0
    engineInertialMass:r=5.0
  }

  tracks{
    animationMultiplier:r=0.5
    height:r=0.17
    width:r=0.125
    trackPhysMat:t="wheel"
  }

  collisionProps{
    cls_body:t="convex_hull"
  }

  engine{
    horsePowers:r=49.0
    maxRPM:r=4000.0
    minRPM:r=900.0
    rpmTau:r=0.1
    minTorqueLimiter:r=0.0
  }

  mechanics{
    maxBrakeForce:r=7900.0
    driveGearRadius:r=0.2
    mainGearRatio:r=4.88
    sideGearRatio:r=1.0
    tracked:b=no
    maxSpeedToEngageRearGear:r=1.0
    gearType:t="differential"

    gearRatios{
      ratio:r=-6.3
      ratio:r=0.0
      ratio:r=5.2501
      ratio:r=1.564
      ratio:r=1.0
    }
  }

  floats{
    waterCoeff:r=0.5
  }

  suspension{
    maxDisplacementOffsets:p2=-0.02, 0.02
    suspensionOffsets:p3=-0.2, -0.1, 0.09
    defaultGearRadius:r=0.2
    sinkableDist:r=0.07
    defaultDampeningForce:p2=3400.0, 3400.0
    hasSuspensionOnDriveGear:b=yes
    dampeningRelaxationRatio:r=0.2
    dampeningCompressionRatio:r=0.2
    recalcWtms:b=yes

    steeringNodes{
      wheel_r_01:t="bone_wheel_r_01"
      wheel_l_01:t="bone_wheel_l_01"
    }

    steeringDeflection{
      wheel_l_01:r=35.0
      wheel_r_01:r=35.0
      steeringTau:r=1000000.0
      steeringSpd:r=1.0
      steeringNeutralSpd:r=3.0
    }

    wheelsWidth{
      wheel_l_01:r=0.125
      wheel_l_02:r=0.125
      wheel_r_01:r=0.125
      wheel_r_02:r=0.125
    }

    driven{
      wheel_l_01:b=yes
      wheel_r_01:b=yes
      wheel_l_02:b=yes
      wheel_r_02:b=yes
    }

    wheelsDamageWeight{
      wheel_l_01:r=0.3
      wheel_r_01:r=0.3
      wheel_l_02:r=0.3
      wheel_r_02:r=0.3
    }
  }
}

PhysSys{
  find:t="^bone_suspension_(\w)_(\d+)$"

  points{

    lever{
      limitMin:p3=0.0, -1.0, 0.0
      limitMax:p3=0.0, 1.0, 0.0
      name:t="bone_suspension_c_$2"
    }

    wheel_r_01{

      searchChildren{
        occurence:i=1
        limitMin:p3=-1.0, -1.0, 0.0
        limitMax:p3=1.0, 1.0, 0.0
        parent:t="lever"
        find:t="bone_wheel_"
      }
    }

    wheel_l_01{

      searchChildren{
        occurence:i=2
        limitMin:p3=-1.0, -1.0, 0.0
        limitMax:p3=1.0, 1.0, 0.0
        parent:t="lever"
        find:t="bone_wheel_"
      }
    }
  }

  constraints{

    edge{
      to:t="wheel_r_01"
      from:t="lever"
    }

    edge{
      from:t="lever"
      to:t="wheel_l_01"
    }

    slider{
      moveNodes:b=yes
      rotateSecond:b=no
      moveSecond:b=yes
      moveOnly:b=no
      point:t="lever"
      from:t="wheel_l_01"
      to:t="wheel_r_01"
    }
  }
}

