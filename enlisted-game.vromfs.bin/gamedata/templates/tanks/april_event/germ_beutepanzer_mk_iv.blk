germ_beutepanzer_mk_iv{
  _use:t="germ_beutepanzer_mk_iv_common"
}

germ_beutepanzer_mk_iv_common{
  _use:t="base_beutepanzer_mk_iv"
  _use:t="germ_beutepanzer_mk_iv_common_vehicle_sound"
  commanderCockpitFpsCamMaxAngle:p2=40.0, 5.0
  gunner_cam_limit__useCockpitDir:b=yes

  _group{
    _tags:t="server"

    "turret_control__hasTankAiGunners:tag"{
    }
  }

  "vehicle_seats__seatsProvideOrder:tag"{
  }

  "vehicle_seats__seats:shared:array"{

    "seats:object"{
      name:t="commander"
      attachNode:t="machine_gunner"
      shouldHideOwner:b=yes
      locName:t="vehicle_seats/commander"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.8559516, -0.2781155, -0.0] [0.2781155, 0.8559516, 0.0] [0.0, -0.0, 0.9000006] [-0.13, -0.1399999, -0.02]]
      seatComponent:t="isDriver"
      receiveDamageFromDMPart:t="machine_gunner"
      cameraNodeName:t="root"
      cockpitTemplate:t="germ_beutepanzer_mk_iv_machinegunner_cockpit"
      maxPosWithOpenHatch:r=0.01
      hatchRotationAxis:p3=1.8, 0.0, 0.0
      isHoldGunModeAllowed:b=no
      useHatchEffectors:b=yes

      "turretNames:array"{
        turret:t="turret_05"
      }

      "hatchNodes:array"{
        node:t="hatch_02"
      }

      "effectors:object"{

        "l.hand:object"{
          rel_tm:m=[[-0.1731814, 0.9361334, 0.3060425] [0.825076, 0.3075864, -0.4739672] [-0.5378301, 0.1704257, -0.8256485] [2.698376, 2.090626, -0.6013489]]
          node:t="root"
        }

        "r.hand:object"{
          rel_tm:m=[[-0.1293783, 0.9436195, 0.304705] [0.9643819, 0.1912395, -0.1827576] [-0.2307241, 0.2702059, -0.9347479] [2.73098, 2.124665, -0.1387482]]
          node:t="root"
        }

        "l.foot:object"{
          rel_tm:m=[[0.7669101, -0.5928404, 0.2457383] [0.6400432, 0.734518, -0.2254586] [-0.04683819, 0.3301896, 0.9427525] [2.925882, 1.204222, -0.6574707]]
          node:t="root"
        }

        "r.foot:object"{
          rel_tm:m=[[0.770983, -0.6328351, -0.07145959] [0.6162254, 0.7696251, -0.1671761] [0.1607912, 0.08485433, 0.9833326] [2.916695, 1.204493, -0.2850647]]
          node:t="root"
        }
      }
    }

    "seats:object"{
      name:t="main_gunner"
      locName:t="vehicle_seats/gunner"
      attachNode:t="gunner_01"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.85, 0.0, 0.0] [0.0, 0.85, 0.0] [0.0, 0.0, 0.85] [-0.25, -0.25, 0.0]]
      seatComponent:t="isGunner"
      nextSeat:t="driver"
      shouldHideOwner:b=yes
      isHoldGunModeAllowed:b=no
      receiveDamageFromDMPart:t="gunner_01"
      cameraNodeName:t="bone_camera_gunner"
      cockpitTemplate:t="germ_beutepanzer_mk_iv_gunner_01_cockpit"

      "turretNames:array"{
        turretNames:t="turret_01"
      }

      "loaderTurretNames:array"{
        turret:t="turret_01"
      }
    }

    "seats:object"{
      name:t="main_gunner"
      locName:t="vehicle_seats/gunner"
      attachNode:t="gunner_02"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.85, 0.0, 0.0] [0.0, 0.85, 0.0] [0.0, 0.0, 0.85] [-0.25, -0.25, 0.0]]
      seatComponent:t="isGunner"
      nextSeat:t="driver"
      shouldHideOwner:b=yes
      isHoldGunModeAllowed:b=no
      receiveDamageFromDMPart:t="gunner_02"
      cameraNodeName:t="bone_camera_gunner"
      cockpitTemplate:t="germ_beutepanzer_mk_iv_gunner_02_cockpit"

      "turretNames:array"{
        turretNames:t="turret_02"
      }

      "loaderTurretNames:array"{
        turret:t="turret_02"
      }
    }

    "seats:object"{
      name:t="driver"
      locName:t="vehicle_seats/driver"
      seatOwnsEntityControl:b=yes
      attachNode:t="driver"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.7573594, -0.3858883, -0.0] [0.3858883, 0.7573594, 0.0] [0.0, -0.0, 0.8499982] [-0.27, -0.03, 0.0]]
      seatComponent:t="isDriver"
      nextSeat:t="extra_gunner"
      shouldHideOwner:b=no
      receiveDamageFromDMPart:t="driver"
      cameraNodeName:t="bone_camera_driver"
      cockpitTemplate:t="germ_beutepanzer_mk_iv_driver_cockpit"
      seat_anim__fireReadyLower:t="drive_driver"
      seat_anim__fireReadyLower:t="drive_driver"
      seat_anim__upper:t="drive_driver"
      seat_anim__lower:t="drive_driver"

      "effectors:object"{

        "l.hand:object"{
          rel_tm:m=[[0.7170935, -0.08985827, -0.6911598] [0.6054887, -0.4108308, 0.6816205] [-0.3451985, -0.9072739, -0.2401956] [2.734537, 1.634227, -0.1157074]]
          node:t="root"
        }

        "r.hand:object"{
          rel_tm:m=[[0.9517033, -0.1240829, 0.2808306] [0.2055575, -0.4219117, -0.8830299] [0.2280536, 0.8981056, -0.3760271] [2.740152, 1.619421, 0.4187927]]
          node:t="root"
        }

        "l.foot:object"{
          rel_tm:m=[[0.9348746, -0.353184, 0.03560904] [0.3478952, 0.8916732, -0.2896395] [0.07054441, 0.2831649, 0.9564738] [2.788813, 1.39406, 0.05276489]]
          node:t="root"
        }

        "r.foot:object"{
          rel_tm:m=[[0.9650966, -0.2492701, -0.08031664] [0.2595195, 0.9514514, 0.1655085] [0.03516105, -0.1805755, 0.9829329] [2.827269, 1.362927, 0.3074341]]
          node:t="root"
        }
      }
    }
  }
}

germ_beutepanzer_mk_iv_driver_cockpit{
  _use:t="base_driver_cockpit"
  animchar__res:t="ba_11_driver_char"
  cockpit__offset:p3=-0.4, -0.25, 0.18

  "cockpit__slitForwardOffset:list<r>"{
    slit:r=-0.05
  }

  "cockpit__visibleVehicleNodeNames:list<t>"{
    node:t="ex_armor_r_01"
    node:t="ex_armor_l_01"
  }

  "cockpit__slitZoom:array"{

    "slit:list<r>"{
      zoom:r=1.44
    }
  }

  "cockpit__slitZoomTime:list<r>"{
    slit:r=0.0
  }
}

germ_beutepanzer_mk_iv_gunner_01_cockpit{
  _use:t="base_gunner_cockpit"
  animchar__res:t="ba_11_gunner_char"
  cockpit__offset:p3=0.0, 0.0, 0.0

  "cockpit__cockpitOffsetBySlit:list<p3>"{
    item:p3=-0.4, 0.1, 0.232
  }

  "cockpit__visibleVehicleNodeNames:list<t>"{
    node:t="gun_barrel_02"
    node:t="@root"
  }

  "cockpit__slitNodeNames:list<t>"{
    slit:t="cam_front_right"
  }

  "cockpit__slitForwardOffset:list<r>"{
    slit:r=0.21
  }

  "cockpit__slitIsGun:list<b>"{
    slit:b=yes
  }

  "cockpit__attachNodeNames:list<t>"{
    node:t="bone_gun_02"
  }

  "cockpit__attachNodeIndices:list<i>"{
  }

  "cockpit__slitZoom:array"{

    "slit:list<r>"{
      zoom:r=1.9
      zoom:r=3.5
    }
  }

  "cockpit__slitZoomTime:list<r>"{
    slit:r=0.05
  }

  "cockpit__slitTemplates:list<t>"{
    slit:t="m4_gunner_sight"
  }

  "cockpit__slitEids:list<eid>"{
  }

  "cockpit__periscopeLimits:list<p4>"{
    slit:p4=-0.0, 0.0, 0.0, 0.0
  }

  "cockpit__periscopeSpeed:list<p2>"{
    slit:p2=-1.0, -1.0
  }
}

