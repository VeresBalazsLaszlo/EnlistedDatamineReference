geyser_sound{
  _use:t="sound_effect"
  geyser_sound__spawnRateThreshold:r=0.5

  _group{
    _tags:t="sound"
    sound_effect__path:t="env_effects/geyser"
  }
}

lava_sound{
  _use:t="sound_effect"

  _group{
    _tags:t="sound"
    sound_effect__path:t="env_effects/fire/lava"
  }
}

pipes_sound{
  _use:t="spline_sound"

  _group{
    _tags:t="sound"
    spline_sound__path:t="ambient/positioned/water_pipe"
  }
}

en_biome_sound_query{
  _use:t="biome_sound_query"

  _group{
    _tags:t="sound"

    "biome_sound_query__biomeNames:list<t>"{
      name:t="grass"
      name:t="swamp"
    }

    "biome_sound_query__varNames:list<t>"{
      name:t="biome_grass"
      name:t="biome_swamp"
    }
  }
}