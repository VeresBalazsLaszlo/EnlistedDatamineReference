}

jp_type_5_ho_ri_prototype_driver_cockpit{
  _use:t="base_driver_cockpit_no_slits"
  animchar__res:t="bt_7_driver_char"
  cockpit__offset:p3=0.1, -0.35, 0.05
  cockpit__minForwardOffset:r=-0.0

  "cockpit__visibleVehicleNodeNames:list<t>"{
    node:t="gun_barrel"
  }

  "cockpit__slitForwardOffset:list<r>"{
    slit:r=0.06
  }

  "cockpit__slitIsGun:list<b>"{
    slit:b=no
  }

  "cockpit__slitNodeNames:list<t>"{
    slit:t="cam_front"
  }
}

jp_type_5_ho_ri_prototype_gunner_cockpit{
  _use:t="base_gunner_cockpit"
  animchar__res:t="ba_11_gunner_char"
  cockpit__offset:p3=-0.2, -0.0631, 0.4818
