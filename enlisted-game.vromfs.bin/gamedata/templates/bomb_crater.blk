  "bomb_crater__availablePartsMask:u64"{
    value:i64=0
  }

  "bomb_crater__availableDigPartsMask:u64"{
    value:i64=0
  }

  "bomb_crater__riHandlesToRemove:list<u64>"{
  }
}

