m5a1_stuart_late_turret_01_37mm_m6{
  _use:t="tankgun_37mm_m6"
  gun__shootNodeName:t="bone_gun_barrel"
  turret__yawSpeed:r=24.0
  turret__pitchSpeed:r=4.0
  turret__aimNodeName:t="bone_turret"
  turret__limit:p4=-180.0, 180.0, -12.0, 20.0
  turret__stabilizerPitchFrictionMult:r=0.8
  turret__stabilizerPitchSpeedLimitKph:r=16.0

  "turret__limitsTable:list<p4>"{
    lim1:p4=-180.0, -135.0, -2.0, 20.0
    lim2:p4=-135.0, 135.0, -12.0, 20.0
    lim3:p4=135.0, 180.0, -2.0, 20.0
  }

  "turret__stabilizerErrorByKphSpeedTable:list<p2>"{
    row:p2=5.0, 0.0
    row:p2=10.0, 0.05
    row:p2=12.0, 0.4
  }

  "gun__shellsAmmo:array"{
    ammo:i=49
    ammo:i=49
    ammo:i=49
  }
}

