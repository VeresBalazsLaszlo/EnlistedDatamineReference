explosion_sound_effect_base{
  _use:t="sound_effect"

  _group{
    _tags:t="sound"
    sound_effect__abandonOnReset:b=yes
  }
}

explosion_firebomb_effect{
  _use:t="explosion_effect"
  _use:t="hit_env_affect_fx"
  wind_emitter__radius:r=6.0
  wind_emitter__duration:r=4.5
  wind_emitter__strength:r=10.0
  wind_emitter__phaseSin:b=yes
  wind_emitter__numWaves:i=8
  wind_emitter__phaseAttack:b=yes

  "wind_emitter__omni:tag"{
  }

  _group{
    _tags:t="render"
    effect__name:t="explosion_firebomb_cmps_fx"
