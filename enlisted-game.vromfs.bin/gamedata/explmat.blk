explMats{
  shader:t="explosion_patch_3tex"
  needMaterialTex:b=yes
  alphaMaskThresholdMin:r=0.01
  alphaMaskThresholdMax:r=0.99
  alphaMaskRangeMin:r=0.1
  alphaMaskRangeMax:r=0.3
  parallaxStrength:r=0.2
  parallaxZeroHeight:i=205
  diffuseTextureSuffix:t="_tex_d"
  normalTextureSuffix:t="_tex_n"
  materialTextureSuffix:t="_tex_m"

  brick_red{

    kinetic_non_penetration{
      sizeScale:r=16.0
      useHitDirectionForParallax:b=no

      textures{
        tex:t="ddi_building_nonpenetration_ap_brick_red_a"
      }
    }

    kinetic_sabot_non_penetration{
      sizeScale:r=16.0
      useHitDirectionForParallax:b=no

      textures{
        tex:t="ddi_building_nonpenetration_ap_brick_red_a"
      }
    }

    kinetic_discard_sabot_penetration{
      sizeScale:r=9.0
      useHitDirectionForParallax:b=no

      textures{
        tex:t="ddi_building_penetration_apfsds_brick_red_a"
      }
    }

    kinetic_discard_sabot_penetration_angled{
      sizeScale:r=9.0
      useHitDirectionForParallax:b=no

      textures{
        tex:t="ddi_building_penetration_apfsds_brick_red_a"
      }
    }

    kinetic_penetration{
      sizeScale:r=12.0
      useHitDirectionForParallax:b=no

      textures{
        tex:t="ddi_building_penetration_ap_brick_red_a"
      }
    }

    kinetic_sabot_penetration{
      sizeScale:r=12.0
      useHitDirectionForParallax:b=no

      textures{
        tex:t="ddi_building_penetration_ap_brick_red_a"
      }
    }

    explosive_non_penetration{
      sizeScale:r=32.0
      useHitDirectionForParallax:b=no

      textures{
        tex:t="ddi_building_nonpenetration_he_brick_red_a"
      }
    }

    heat_penetration{
      sizeScale:r=28.0
      useHitDirectionForParallax:b=no

      textures{
        tex:t="ddi_building_penetration_heat_brick_red_a"
      }
    }

    heat_non_penetration{
      sizeScale:r=28.0
      useHitDirectionForParallax:b=no

      textures{
        tex:t="ddi_building_penetration_heat_brick_red_a"
      }
    }

    bullet_penetration{
      sizeScale:r=20.0
      parallaxStrength:r=0.1
      parallaxZeroHeight:i=255

      textures{
        tex:t="ddi_building_bullet_penetration_brick_red_a"
        tex:t="ddi_building_bullet_penetration_brick_red_b"
      }
    }

    bullet_non_penetration{
      sizeScale:r=20.0
      stretchMax:r=1.5

      textures{
        tex:t="ddi_building_bullet_penetration_brick_red_a"
        tex:t="ddi_building_bullet_penetration_brick_red_b"
        tex:t="ddi_building_bullet_nonpenetration_brick_red_a"
      }
    }

    bullet_ricochet{
      sizeScale:r=7.0
      useHitDirectionForParallax:b=no
      angleLimit:r=10.0

      textures{
        tex:t="ddi_building_ricochet_brick_red_a"
      }
    }

    shrapnel_damage{
      useHitDirectionForParallax:b=no
      sizeScale:r=1.2

      textures{
        tex:t="dds_red_brick_a"
      }
    }

    grenade_explosion{
      sizeScale:r=5.5
      parallaxZeroHeight:i=255

      textures{
        tex:t="ddi_building_red_brick_grenade_a"
      }
    }

    bomb_hit{
      sizeScale:r=6.0

      textures{
        tex:t="ddi_building_red_brick_bomb_hit_a"
      }
    }

    bomb_explosion{
      sizeScale:r=10.0
      parallaxStrength:r=0.02
      parallaxZeroHeight:i=255
      angleLimit:r=0.0

      textures{
        tex:t="ddi_building_red_brick_bomb_explosion_a"
      }
    }
  }

