          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          parent:t="suspension_02_04"
          find:t="bone_wheel_"
        }
      }
    }

    constraints{

      projection{
        moveEdge:b=yes
