    _tags:t="sound"
    watched:t="events/moonbase/player/weapon/laser_pp"
    other:t="events/moonbase/enemy/weapon/laser_pp"
  }

  "sound_irqs:shared:object"{
    _tags:t="sound"

    "reload1:object"{
      watched:t="events/moonbase/player/weapon/laser_pp/reload1/change_ammo"
