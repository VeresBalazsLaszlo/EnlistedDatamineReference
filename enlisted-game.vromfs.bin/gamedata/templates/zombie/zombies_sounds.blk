zombie_scene_net_sounds{
  _use:t="scene_net_sound_descs"
  _use:t="replicating"
  _singleton:b=yes

  "net_sound__descs:shared:object"{

    "zombieCraterExplosion:object"{
      path:t="events/z/enemy/effects/zombie_crater_destroyed"
      range:r=50.0
    }

    "zombieArenaObjectiveActivated:object"{
      path:t="events/z/enemy/effects/altar_activate"
      range:r=100.0
    }

    "zombiePatrolSpawn:object"{
      path:t="events/z/ui/patrol_start"
      range:r=0.0
      bringToListener:b=yes
    }

    "zombieAbilityAgressiveShellsCast:object"{
      path:t="events/z/enemy/effects/ability_summoner"
      range:r=40.0
    }

    "plasmaQuickShellSpawn:object"{
      path:t="events/z/enemy/effects/ability_plasma_shell"
      range:r=40.0
    }

    "plasmaSmallQuickShellSpawn:object"{
      path:t="events/z/enemy/effects/ability_small_plasma_shell"
      range:r=40.0
    }

    "ballsShellSpawn:object"{
      path:t="events/z/enemy/effects/ability_balls"
      range:r=40.0
    }

    "exchangeSouls:object"{
      path:t="events/z/ui/exchange_souls"
    }

    "paidDoorOpen:object"{
      path:t="events/z/ui/door_opened"
      range:r=100.0
    }
  }
}

zombie_tear_off_limb_sound{
  _use:t="on_appear_sound"

  _group{
    _tags:t="sound"
    on_appear_sound__path:t="events/z/enemy/effects/torn_wound"
  }
}

zombie_battle_music_param{
  _use:t="sound_preset"
  _use:t="replicating"
  _singleton:b=yes

  _group{
    _tags:t="sound"
    zombie_battle_music_param__name:t="battle"
    zombie_battle_music_param__active:b=no
  }
}

zombie_battle_music_trigger{

  _group{
    _tags:t="sound"
    zombie_battle_music_trigger__dropAtTime:r=0.0
  }
}

zombie_near_battle_music_trigger{
  _use:t="replicating"
  _use:t="zombie_battle_music_trigger"
  _singleton:b=yes

  _group{
    _tags:t="sound"
    zombie_near_battle_music_trigger__duration:r=30.0
    zombie_near_battle_music_trigger__range:r=100.0
    zombie_near_battle_music_trigger__updateInterval:r=2.0
    zombie_near_battle_music_trigger__updateAfter:r=0.0
  }

  _group{
    _tags:t="sound"
    zombie_attack_battle_music_trigger__duration:r=30.0
  }
}

zombie_any_shell_sound{

  _group{
    _tags:t="sound"
    projectile_wiz_sound__path:t=""
  }

  "projectile_impact_sound__paths:shared:object"{
    _tags:t="sound"
    hitBullet:t="impact/shell"
    hitShell:t="impact/shell"
    ricoBullet:t="ricoShell1"
    ricoShell:t="ricoShell1"
  }
}

boss_sphere_spawn_sound{
  _use:t="oneshot_scene_net_sound"
  _use:t="zombie_any_shell_sound"

  _group{
    _tags:t="server"
    oneshot_scene_net_sound__desc:t="zombieAbilityAgressiveShellsCast"
  }
}

plasma_quick_shell_spawn_sound{
  _use:t="oneshot_scene_net_sound"
  _use:t="zombie_any_shell_sound"

  _group{
    _tags:t="server"
    oneshot_scene_net_sound__desc:t="plasmaQuickShellSpawn"
  }
}

plasma_small_quick_shell_spawn_sound{
  _use:t="oneshot_scene_net_sound"
  _use:t="zombie_any_shell_sound"

  _group{
    _tags:t="server"
    oneshot_scene_net_sound__desc:t="plasmaSmallQuickShellSpawn"
  }
