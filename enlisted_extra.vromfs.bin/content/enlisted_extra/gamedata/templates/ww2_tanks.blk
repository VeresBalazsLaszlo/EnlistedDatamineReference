t_80_gunner_optic{
  _use:t="base_vehicle_sight"
  vehicle_sight__blk:t="content/enlisted_extra/gamedata/sight/t_80_gunner_optic.blk"
  vehicle_sight__useGunDir:b=yes
  vehicle_sight__slitZoomTime:r=0.0

  "vehicle_sight__slitZoom:list<r>"{
    zoom:r=2.7
    zoom:r=12.0
  }
}

m1a1_gunner_optic{
  _use:t="base_vehicle_sight"
  vehicle_sight__blk:t="content/enlisted_extra/gamedata/sight/m1a1_gunner_optic.blk"
  vehicle_sight__useGunDir:b=yes
  vehicle_sight__slitZoomTime:r=0.0

  "vehicle_sight__slitZoom:list<r>"{
    zoom:r=3.0
    zoom:r=10.0
  }
}