gun_shot_dry_sound{

  _group{
    _tags:t="sound"
    gun_shot_dry_sound__nextTime:r=0.0
    gun_shot_dry_sound__path:t="player/weapon/_common/shot_dry_pistol"
    gun_shot_dry_sound__cooldown:r=0.15
  }
}

pistol_gun_shot_dry_sound{
  _use:t="gun_shot_dry_sound"

  _group{
    _tags:t="sound"
    gun_shot_dry_sound__path:t="player/weapon/_common/shot_dry_pistol"
  }
}

mgun_gun_shot_dry_sound{
  _use:t="gun_shot_dry_sound"

  _group{
    _tags:t="sound"
    gun_shot_dry_sound__path:t="player/weapon/_common/shot_dry_pistol"
  }
}

