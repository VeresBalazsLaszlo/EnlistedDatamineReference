PhysSys{

  group{
    find:t="^bone_suspension_(\w)_(\d+)$"

    points{

      lever{
        name:t="bone_suspension_$1_$2"
        limitMin:p3=0.0, 0.0, 0.0
        limitMax:p3=0.0, 0.0, 0.0
      }

      suspension_01_01{
        name:t="bone_suspension_$1_$2_01"
        limitMin:p3=-0.5, -0.5, 0.0
        limitMax:p3=0.5, 0.5, 0.0
      }

      wheel_01{

        searchChildren{
          parent:t="suspension_01_01"
          find:t="bone_wheel_"
          occurence:i=1
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
        }
      }

      wheel_02{

        searchChildren{
          find:t="bone_wheel_"
          parent:t="suspension_01_01"
          occurence:i=2
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
        }
      }

      suspension_01_02{
        name:t="suspension_$1_$2_02"
        limitMin:p3=-0.5, 0.0, 0.0
        limitMax:p3=0.5, 0.0, 0.0
      }
    }

    constraints{

      projection{
        point:t="suspension_01_01"
        from:t="wheel_01"
        to:t="wheel_02"
        moveEdge:b=yes
      }

      edge{
        from:t="lever"
        to:t="suspension_01_01"
        moveSecond:b=no
      }

      edge{
        moveSecond:b=no
        from:t="suspension_01_02"
        to:t="suspension_01_01"
        moveOnly:b=yes
      }

      direction{
        moveNodes:b=yes
        rotateSecond:b=no
        from:t="wheel_01"
        to:t="wheel_02"
        point:t="suspension_01_01"
      }
    }
  }

  group{
    find:t="^bone_suspension_tb_(._\d\d)$"

    points{

      suspension{
        limitMin:p3=0.0, 0.0, 0.0
        limitMax:p3=0.0, 0.0, 0.0
        name:t="bone_suspension_tb_$1"
      }

      wheel{

        searchChildren{
          occurence:i=1
          limitMin:p3=-1000.0, -1000.0, 0.0
          limitMax:p3=1000.0, 1000.0, 0.0
          parent:t="suspension"
          find:t="bone_wheel_"
        }
      }

      suspension_01_02{

        searchChildren{
          occurence:i=1
          limitMin:p3=-0.5, 0.0, 0.0
          limitMax:p3=-0.5, 0.0, 0.0
          parent:t="suspension"
          find:t="suspension_tb_"
        }
      }
    }

    constraints{

      edge{
        from:t="suspension"
        to:t="wheel"
      }
    }
  }
}