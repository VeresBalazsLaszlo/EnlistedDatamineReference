    "ammo:object"{
      slot:i=1
      fill:b=yes
    }

    "ammo:object"{
      slot:i=4
      count:i=7
    }
  }

  "vehicle_seats__seatsProvideOrder:tag"{
  }

  "vehicle_seats__effectors:array"{
  }

  "vehicle_seats__seats:shared:array"{

