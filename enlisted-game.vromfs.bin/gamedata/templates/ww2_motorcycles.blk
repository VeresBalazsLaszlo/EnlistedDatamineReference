base_bike_left_sidecar{
  _use:t="base_bike_common"
}

base_bike_right_sidecar{
  _use:t="base_bike_common"
}

base_bike_common{
  _use:t="base_bike_common_no_gun"
  _use:t="base_vehicle_attach_rules"
  _use:t="vehicle_decals"
  vehicle__turretControlComponents:t="bike_turret_control_components"

  "attach_decorators__templates:array"{
  }

  "attach_decorators__entities:list<eid>"{
  }
}

base_bike_common_no_gun{
  _use:t="base_tank_without_xray_common"
  _use:t="bike_camera_setup"
  _use:t="base_phys_modifications"
  _use:t="vehicle_anim_steering_deflection"
  _use:t="resupply_vehicle"
  _use:t="vehicle_steering_assist"
  _use:t="vehicle_autodetect_team"
  team:i=-1
  _replicated:t="team"
  phys__maxMassRatioForPushOnCollision:r=2.0
  last_driver_leave_time:r=0.0
  camera__isStabilized:b=no
  vehicle_seats_switch_time__totalSwitchTime:r=0.5
  vehicle_seats__enterTime:r=0.5
  vehicle_seats__exitTime:r=0.5
  vehicle_free_look__zoomIn:r=1.5
  item__iconOffset:p2=0.0, -0.2
  item__iconScale:r=1.15
  item__iconYaw:r=25.0
  item__iconPitch:r=-3.0
  item__iconRoll:r=15.0
  item__lightZenith:r=180.0
  item__lightAzimuth:r=140.0
  fatal_explosion_fire__ttl:r=30.0
  vehicle_kill_assist__stat:t="bikeKillAssists"
  vehicle_kill_assist__crewStat:t="bikeKillAssistsAsCrew"
  vehicle_kill_assist__engineerStat:t="builtGunBikeKillAssists"
  vehicle_kill_assist__time:r=20.0
  vehicle_kill__award:t="bikeKill"
  vehicle_kill__stat:t="bikeKills"
  vehicle_kill__crewStat:t="crewBikeKillAssists"
  vehicle_kill__engineerStat:t="builtGunBikeKills"

  "wheelsSpecialOrder:tag"{
  }

  "fatal_explosion_fx__fx:array"{

    "fx:object"{

      "dmParts:array"{
      }

      "fx:array"{

        "fx:object"{
          name:t="tank_fire_medium_template"
          emitter:t="emtr_fire_engine"
        }

        "fx:object"{
          name:t="tank_fire_small_template"
          emitter:t="emtr_fire_small_dmg_01"
        }

        "fx:object"{
          name:t="tank_fire_small_template"
          emitter:t="emtr_fire_small_dmg_02"
        }

