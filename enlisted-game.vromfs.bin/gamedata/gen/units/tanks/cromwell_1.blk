VehiclePhys{
  skipUpdateOnSleep:b=yes

  Mass{
    Empty:r=26900.0
    Fuel:r=530.0
    TakeOff:r=27430.0
    momentOfInertia:p3=4.0, 5.0, 6.0
    CenterOfGravity:p3=0.0, 0.5, 0.0
    AdvancedMass:b=yes
    trackMass:r=2000.0
