    fx:t="muzzle_air_8mm"
    fx:t="muzzle_air_8mm"
  }

  "turret_gun_flash_fx__flashFxScale:shared:array"{
    scale:r=1.0
    scale:r=1.0
    scale:r=1.0
    scale:r=1.0
  }

  "disableDMParts:list<t>"{
    part:t="droptank1"
    part:t="droptank2"
    part:t="rack_1000"
    part:t="bomb_launcher1"
    part:t="bomb_launcher2"
  }
}

