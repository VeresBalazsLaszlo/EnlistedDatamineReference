enlisted_burning_affect{
  _use:t="replicated_game_effect"

  "burning_affect:tag"{
  }

  "locked_use_object__lockStationaryGunUse:tag"{
  }

  "locked_inventory__lockPickup:tag"{
  }

  "locked_use_object__lockVehicleEnter:tag"{
  }
}

bomb_site_animation_base{
  _use:t="replicated_game_effect"
  _use:t="game_effect_sound"
  game_effect__forceAnimUpperNonCrawlState:t="upper_satchel"
  game_effect__forceAnimUpperNonCrawlStateId:i=-1
  game_effect__forceAnimUpperCrawlState:t="satchel_plant_crawl"
  game_effect__forceAnimUpperCrawlStateId:i=-1

  "game_effect__hiddenWeapon:tag"{
  }
}

spy_clothes_change_anim{
  _use:t="bomb_site_animation_base"
  game_effect__forceAnimUpperNonCrawlState:t="upper_dressing"
  game_effect__forceAnimUpperCrawlState:t="upper_dressing_crawl"
  game_effect_sound__watched:t="player/walker/ww2_soldier/items/change_suit/activate"
  game_effect_sound__other:t="enemy/walker/ww2_soldier/items/change_suit/activate"
}

bomb_site_plant_animation{
  _use:t="bomb_site_animation_base"
  game_effect__forceAnimUpperNonCrawlState:t="upper_satchel"
  game_effect__forceAnimUpperCrawlState:t="satchel_plant_crawl"
  game_effect_sound__watched:t="env_effects/bomb_site/activate_action"
  game_effect_sound__other:t="env_effects/bomb_site/activate_action"
}

bomb_site_reset_animation{
  _use:t="bomb_site_animation_base"
  game_effect__forceAnimUpperNonCrawlState:t="upper_satchel"
  game_effect__forceAnimUpperCrawlState:t="satchel_plant_crawl"
  game_effect_sound__watched:t="env_effects/bomb_site/deactivate_action"
