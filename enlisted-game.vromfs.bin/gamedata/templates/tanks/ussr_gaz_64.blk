ussr_gaz_64_seat_commander{
  _use:t="jeep_seat_commander"
  vehicle_seat__springLim:p2=0.0, 0.0

  "vehicle_seats_auto_effectors__effectorNames:list<t>"{
    node:t="r.hand"
    node:t="l.hand"
  }

  "vehicle_seats_auto_effectors__vehicleAttachNodes:list<t>"{
    node:t=""
    node:t=""
  }

  "vehicle_seats_auto_effectors__humanNodes:list<t>"{
    node:t="Bip01 R Hand"
    node:t="Bip01 L Hand"
  }
}

ussr_gaz_64{
  _use:t="ussr_gaz_64_common"
  _use:t="jeep_respawn_settings"
  _use:t="vehicle_with_attached_grenade_box_ussr"
  destroyIfNoCrewLeft:b=no
  fire_damage__timeToExplosion:r=20.0

  "dm_phys_parts__wheelsPartIds:list<i>"{
  }

  "disableDMParts:list<t>"{
    part:t="driver"
    part:t="commander"
  }

  "vehicle_seats__canAcquireControls:shared:object"{

    "driver:object"{
      movement:b=yes
      turrets:b=yes
    }

    "commander:object"{
      movement:b=yes
      turrets:b=yes
      camera:b=yes
    }

    "passenger1:object"{
      movement:b=yes
      camera:b=yes
    }
  }

  "vehicle_seats__seatTemplates:shared:object"{
    default:t="jeep_seat_fire_ready"
    driver:t="jeep_seat_driver"
    commander:t="ussr_gaz_64_seat_commander"
  }

  _group{
    _tags:t="server"

    "dependent_templates:ecs::TemplatesListToInstantiate"{
    }

    "dependent_templates_list_shared:shared:list<t>"{
      template_name:t="jeep_seat_fire_ready"
      template_name:t="jeep_seat_driver"
      template_name:t="ussr_gaz_64_seat_commander"
    }
  }

  _group{
    _tags:t="gameClient"

    "dm_parts__specialViewPartNames:shared:list<t>"{
      name:t="ex_armor_body_l_02"
    }
  }

  _group{
    _tags:t="render"
    exhaust_fx__fx:t="car_exhaust_template"
    exhaust_fx__brokenFx:t="car_broken_exhaust_template"
  }

  "attach_decorators__entities:list<eid>"{
  }

  "attach_decorators__templates:array"{

    "templates:object"{
      preinited:b=yes
      relativeTm:m=[[-0.000143782, 0.00777137, 1.06012] [-0.0187239, -1.12535, 0.00824671] [0.646081, -0.0107478, 0.000166399] [1.34354, 0.804031, -0.000678897]]
      template:t="tank_decor_box_01_decor"
      nodeName:t="root"
    }
  }

  "wheelsSpecialOrder:tag"{
  }
}

ussr_gaz_64_common{
  vehicle__mapIcon:t="map_icon_car"
  user_point__icon:t="map_icon_car"
  _use:t="jeep_brakes"
  _use:t="base_gaz_64"
  _use:t="forestall"
  _use:t="jp_type_94_isuzu_apc_common_vehicle_sound"
  _use:t="vehicle_anim_steering_deflection"
  vehicle_seats__enterTime:r=0.5
  vehicle_seats__exitTime:r=0.5
  commanderFpsCamMaxAngle:p2=40.0, 40.0
  passengerFpsCamMaxAngle:p2=40.0, 40.0
  item__iconOffset:p2=0.0, 0.05
  cockpit__zoomOutFov:r=1.5
  cockpit__zoomInFov:r=2.0
  commanderCockpitFpsCamMaxAngle:p2=40.0, 5.0
  gunner_cam_limit__useCockpitDir:b=yes
  vehicle_commander_cam__attachToVehicle:b=yes

  "jeep:tag"{
  }

  "vehicle__isExplosionFatal:b"{
    _tags:t="server"
    value:b=yes
  }

  "vehicle_seats__effectors:array"{
  }

  "dm_parts_repair_names:list<t>"{
    part:t="drive_turret_h"
    part:t="drive_turret_v"
    part:t="cannon_breech"
    part:t="engine"
    part:t="transmission"
    part:t="gun_barrel"
    part:t="gun_barrel_01"
    part:t="gun_barrel_02"
    part:t="gun_barrel_03"
    part:t="gun_barrel_04"
    part:t="gun_barrel_05"
    part:t="wheel_r_01"
    part:t="wheel_l_01"
    part:t="wheel_r_02"
    part:t="wheel_l_02"
