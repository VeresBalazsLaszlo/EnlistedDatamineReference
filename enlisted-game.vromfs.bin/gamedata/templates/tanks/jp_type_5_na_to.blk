jp_type_5_na_to_driver_cockpit{
  _use:t="base_driver_cockpit_no_slits"
  animchar__res:t="pzkpfw_iii_e_driver_char"
  cockpit__offset:p3=-0.2, -0.17, -0.05

  "cockpit__visibleVehicleNodeNames:list<t>"{
    node:t="ex_decor_r_01"
    node:t="track_r"
    node:t="ex_decor_01"
    node:t="wheel_r_drive"
    node:t="ex_decor_l_01"
    node:t="gun_barrel"
  }

  "cockpit__slitForwardOffset:list<r>"{
    slit:r=-0.05
  }

  "cockpit__slitIsGun:list<b>"{
    slit:b=no
  }

  "cockpit__slitNodeNames:list<t>"{
    slit:t="cam_front"
  }
}

jp_type_5_na_to_gunner_cockpit{
  vehicle_sight__blk:t="gamedata/sight/jp_120mm.blk"
  _use:t="base_gunner_cockpit"
  animchar__res:t="t_26_1940_gunner_char"
  cockpit__offset:p3=-0.0, -0.0, -0.0
  cockpit__minForwardOffset:r=-0.05

  "cockpit__cockpitOffsetBySlit:list<p3>"{
    slit:p3=-0.6, 0.03, 0.03
    slit:p3=-0.35, 1.0, 0.4
  }

  "cockpit__attachNodeNames:list<t>"{
    node:t="bone_camera_gunner"
    node:t="bone_turret"
  }

  "cockpit__attachNodeIndices:list<i>"{
  }

  "cockpit__visibleVehicleNodeNames:list<t>"{
    node:t="gun_barrel"
  }

  "cockpit__slitNodeNames:list<t>"{
    slit:t="cam_front_right"
    slit:t="cam_front"
  }

  "cockpit__slitForwardOffset:list<r>"{
    slit:r=0.22
    slit:r=0.2
  }

  "cockpit__slitIsGun:list<b>"{
    slit:b=yes
    slit:b=no
  }

  "cockpit__periscopeLimits:list<p4>"{
    slit:p4=-0.0, 0.0, 0.0, 0.0
    slit:p4=-90.0, 90.0, -0.0, 25.0
  }

  "cockpit__periscopeSpeed:list<p2>"{
    slit:p2=-1.0, -1.0
    slit:p2=35.0, 35.0
  }

  "cockpit__slitZoom:array"{

    "slit:list<r>"{
      zoom:r=1.9
      zoom:r=3.5
    }

    "slit:list<r>"{
      zoom:r=1.44
    }
  }

  "cockpit__slitZoomTime:list<r>"{
    slit:r=0.05
    slit:r=0.0
  }

  "cockpit__slitTemplates:list<t>"{
    slit:t="jp_120mm"
    slit:t="default_periscope"
  }

  "cockpit__slitEids:list<eid>"{
  }
}

