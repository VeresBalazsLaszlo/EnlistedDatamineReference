      damageScale:r=1.5
      angles:p2=355.0, 359.0
      countPortion:r=0.01
      onHitChanceMultFire:r=10.0
    }
  }
}

shatterDamage{
  breachConeAngle:r=45.0
}

cumulativeDamage{
  armorPower:r=100.0
  distance:r=2.5
  damage:r=170.0
  onHitChanceMultFire:r=25.0
  damageType:t="cumulative"
}

visual{
  range_percent_of_ammo:p2=100.0, 0.0
  traceFreq:i=1
  tracer:t="30mmWhite"
  trail:t="black"
}

kineticDamage{
  damageType:t="generic"
}

tracer{
  headColor:c=255, 255, 255, 120
  smokeColor:c=80, 80, 80, 186
  startHeadColor:c=255, 248, 60, 120
