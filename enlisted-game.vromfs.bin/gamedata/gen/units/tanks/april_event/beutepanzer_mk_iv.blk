      }

      limiter{
        p1:p3=-2.4, 1.7, -1.1
        p2:p3=-4.0, 0.8, -1.1
      }
    }
  }

  collisionProps{
    cls_body:t="convex_hull"
  }

  engine{
    horsePowers:r=125.0
    maxRPM:r=1000.0
    minRPM:r=500.0
  }

  mechanics{
    steerType:t="clutch_braking"
    maxBrakeForce:r=100000.0
    driveGearRadius:r=0.35
    mainGearRatio:r=44.5
    sideGearRatio:r=0.66
