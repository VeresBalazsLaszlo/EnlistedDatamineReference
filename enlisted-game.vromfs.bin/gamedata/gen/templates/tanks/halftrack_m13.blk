base_halftrack_m13{
  _use:t="base_tank"
  _use:t="halftrack_m13_ammo_stowages"
  _use:t="vehicle_physical_tracks"
  killLogName:t="us_halftrack_m13"
  animchar__res:t="halftrack_m13_char"
  animchar_fast_phys__res:t="halftrack_m13_fastphys"
  collres__res:t="halftrack_m13_collision"
  vehicle_net_phys__blk:t="gamedata/gen/units/tanks/halftrack_m13.blk:VehiclePhys"
  particle_phys__blk:t="gamedata/gen/units/tanks/halftrack_m13.blk:PhysSys"
  dmg_animchar__res:t="halftrack_m13_dmg_char"
  xray_resource__modelName:t="halftrack_m13"
  cockpit__zoomOutFov:r=2.7475
  cockpit__zoomInFov:r=5.3955
  cockpit__sightName:t="sight_model/default_tank_spg"
  cockpit__sightFov:r=20.0
  drowningHeight:r=1.752
  damage_model__blk:t="gamedata/gen/units/tanks/halftrack_m13.blk"
  item__name:t="items/us_halftrack_m13"
  physical_tracks__blk:t="gamedata/gen/units/tanks/halftrack_m13.blk"
  skin__template:t="halftrack_m13_skins"
  losable_turret__detachBone:t="bone_turret"
  losable_turret__detachCollNode:t="cls_turret_01"
  losable_turret__mass:r=4300.0
  losable_turret__deviation:r=0.4
  losable_turret__rotation:r=2.5
  fire_damage__openHatchesOnExplosion:b=yes

  animchar_fast_phys{
    _tags:t="gameClient"
  }

  _group{
    _tags:t="gameClient"
    chain_ik__blk:t="gamedata/gen/units/tanks/halftrack_m13.blk:chainIK"
  }

  "turret_gun_flash_fx__flashNodes:shared:array"{
    node:t="emtr_gun_flame_01"
    node:t="emtr_gun_flame_02"
  }

  "turret_gun_flash_fx__flashFx:shared:array"{
    fx:t="muzzle_ground_15mm"
    fx:t="muzzle_ground_15mm"
  }

  "turret_gun_flash_fx__flashFxScale:shared:array"{
    scale:r=1.0
    scale:r=1.0
  }

  "turret_control__emitterNodes:shared:array"{
    node:t="bone_gun_barrel_01"
    node:t="bone_gun_barrel_02"
  }

  "turret_control__animVars:shared:array"{

    "vars:object"{
      curYawParamName:t="turret_01_yaw"
      curPitchParamName:t="gun_01_pitch"
      aimActiveParamName:t="aim_01_active"
      paramYawSpeed:t="turret_01_yaw_speed"
      wishYawParamName:t="gun_01_aim:targetYaw"
      paramYawAccel:t="turret_01_yaw_accel"
      paramPitchSpeed:t="gun_01_pitch_speed"
      wishPitchParamName:t="gun_01_aim:targetPitch"
      paramPitchAccel:t="gun_01_pitch_accel"
      gunRecoilParamName:t="gun_01_recoil"
      paramMinYawAngle:t="turret_01_min_yaw_angle"
      paramMaxYawAngle:t="turret_01_max_yaw_angle"
      paramMinPitchAngle:t="turret_01_min_pitch_angle"
      paramMaxPitchAngle:t="turret_01_max_pitch_angle"
    }

    "vars:object"{
      curYawParamName:t="turret_02_yaw"
      curPitchParamName:t="gun_02_pitch"
      gunRecoilParamName:t="gun_02_recoil"
    }
  }

  "turret_control__turretInfo:shared:array"{

    "turretInfo:object"{
      turretName:t="turret_01"
      turretGroup:t="main_turrets"
      gun:t="halftrack_m13_turret_01_12_7mm_m2_hb_user_machinegun_for_m15+main_turret"
      barrelDm:t="gun_barrel_01"
      breechDm:t="cannon_breech_02"
      verDriveDm:t="drive_turret_v"
      horDriveDm:t="drive_turret_h"
      salt:i=1
    }

    "turretInfo:object"{
      turretName:t="turret_02"
      turretGroup:t="main_turrets"
      gun:t="halftrack_m13_turret_02_12_7mm_m2_hb_user_machinegun_for_m15"
      barrelDm:t="gun_barrel_02"
      breechDm:t="cannon_breech_01"
      verDriveDm:t="drive_turret_v"
      horDriveDm:t="drive_turret_h"
      salt:i=1
    }
  }
}

halftrack_m13_turret_01_12_7mm_m2_hb_user_machinegun_for_m15{
  _use:t="tankgun_12_7mm_m2_hb_user_machinegun_for_m15"
  gun__shootNodeName:t="bone_gun_barrel_01"
  turret__yawSpeed:r=60.0
  turret__pitchSpeed:r=60.0
  turret__aimNodeName:t="bone_turret"
  turret__limit:p4=-180.0, 180.0, -10.0, 90.0

  "turret__limitsTable:list<p4>"{
    lim1:p4=-180.0, -40.0, -5.0, 90.0
    lim2:p4=-40.0, 40.0, -2.0, 90.0
    lim3:p4=40.0, 180.0, -5.0, 90.0
  }

  "gun__shellsAmmo:array"{
    ammo:i=480
    ammo:i=480
    ammo:i=480
    ammo:i=480
    ammo:i=480
  }
}

halftrack_m13_turret_02_12_7mm_m2_hb_user_machinegun_for_m15{
  _use:t="tankgun_12_7mm_m2_hb_user_machinegun_for_m15"
  gun__shootNodeName:t="bone_gun_barrel_02"

  "gun__shellsAmmo:array"{
    ammo:i=480
    ammo:i=480
    ammo:i=480
    ammo:i=480
    ammo:i=480
  }
}

halftrack_m13_ammo_stowages{
  _tags:t="server"
  _use:t="vehicle_ammo_stowages"

  "ammo_stowage__stowageTemplates:shared:list<t>"{
    stowage:t="halftrack_m13_ammo_stowage_1"
  }
}

halftrack_m13_ammo_stowage_1{
  _use:t="ammo_stowage"

  "ammo_stowage__clusterTemplates:shared:list<t>"{
    cluster:t="halftrack_m13_ammo_cluster_1_1"
  }

  "ammo_stowage__turretNames:shared:list<t>"{
    gun:t="turret_01"
    gun:t="turret_02"
  }
}

halftrack_m13_ammo_cluster_1_1{
  _use:t="ammo_cluster"
  ammo_cluster__isShell:b=yes

  "ammo_cluster__slotNames:shared:list<t>"{
    part:t="ammo_body_l_02"
    part:t="ammo_body_r_02"
    part:t="ammo_body"
    part:t="ammo_body_r_01"
  }

  "ammo_cluster__slotsMaxAmmo:list<i>"{
    count:i=2000
    count:i=2000
    count:i=400
    count:i=400
  }
}