me_262a_1a_early{
  _use:t="me_262a_1a_early_base"
  _use:t="squad_controlled_plane"
  _use:t="me_262a_1a_early_plane_sound"
  item__name:t="items/me_262a_1a_early"

  "plane_glassCanopyNodes:list<t>"{
    name:t="fuse_dm"
  }

  "vehicle_seats__seats:shared:array"{

    "seats:object"{
      name:t="driver"
      locName:t="vehicle_seats/pilot"
      seatOwnsEntityControl:b=yes
      attachNode:t="pilot1"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[1.09, 0.0, 0.0] [0.0, 1.09, 0.0] [0.0, 0.0, 1.01] [-0.15, -0.01, -0.15]]
      seatComponent:t="isDriver"
      receiveDamageFromDMPart:t="pilot_dm"
      cameraNodeName:t=""
      cameraOffset:p3=-0.56, 0.807, -0.074
      cockpitTemplate:t="me_262a_1a_early_driver_cockpit"
      roomSpace:i=0

      "turretNames:array"{
        turret:t="turret_01"
        turret:t="turret_02"
        turret:t="turret_03"
        turret:t="turret_04"
        turret:t="turret_05"
      }

      "cockpitEffectors:object"{
        r.hand:t="stick_rhand_1"
        l.hand:t="throttle_lhand_1"
        r.foot:t="pedal_rfoot_1"
        l.foot:t="pedal_lfoot_1"
      }
    }
  }

  "turret_control__emitterNodes:shared:array"{
    node:t="bomb1"
    node:t="flare1"
    node:t="flare2"
    node:t="flare3"
    node:t="flare4"
  }

  "turret_control__animVars:shared:array"{

    "vars:object"{
      curYawParamName:t="weapon_01_yaw"
      curPitchParamName:t="weapon_01_pitch"
    }

    "vars:object"{
      curYawParamName:t="weapon_02_yaw"
      curPitchParamName:t="weapon_02_pitch"
    }

    "vars:object"{
      curYawParamName:t="weapon_03_yaw"
      curPitchParamName:t="weapon_03_pitch"
    }

    "vars:object"{
      curYawParamName:t="weapon_04_yaw"
      curPitchParamName:t="weapon_04_pitch"
    }

    "vars:object"{
      curYawParamName:t="weapon_05_yaw"
      curPitchParamName:t="weapon_05_pitch"
    }
  }

  "turret_control__turretInfo:shared:array"{

    "turretInfo:object"{
      turretName:t="turret_01"
      turretGroup:t="bomb_turrets"
      trigger:t="bombs"
      gun:t="planegun_me_262a_1a_early_sc_500_launcher_01"
    }

    "turretInfo:object"{
      turretName:t="turret_02"
      turretGroup:t="cannon_turrets"
      trigger:t="cannons"
      gun:t="planegun_me_262a_1a_early_30mm_mk108_01"
    }

    "turretInfo:object"{
      turretName:t="turret_03"
      turretGroup:t="cannon_turrets"
      trigger:t="cannons"
      gun:t="planegun_me_262a_1a_early_30mm_mk108_02"
    }

    "turretInfo:object"{
      turretName:t="turret_04"
      turretGroup:t="cannon_turrets"
      trigger:t="cannons"
      gun:t="planegun_me_262a_1a_early_30mm_mk108_03"
    }

    "turretInfo:object"{
      turretName:t="turret_05"
      turretGroup:t="cannon_turrets"
      trigger:t="cannons"
      gun:t="planegun_me_262a_1a_early_30mm_mk108_04"
    }
  }

  "turret_gun_flash_fx__flashNodes:shared:array"{
    node:t="bomb1"
    node:t="flare1"
    node:t="flare2"
    node:t="flare3"
    node:t="flare4"
  }

  "turret_gun_flash_fx__flashFx:shared:array"{
    fx:t=""
    fx:t="muzzle_air_8mm"
    fx:t="muzzle_air_8mm"
    fx:t="muzzle_air_8mm"
    fx:t="muzzle_air_8mm"
  }

  "turret_gun_flash_fx__flashFxScale:shared:array"{
    scale:r=1.0
    scale:r=1.0
    scale:r=1.0
    scale:r=1.0
    scale:r=1.0
  }

  "disableDMParts:list<t>"{
    part:t="rocket_pylon1"
    part:t="rocket_pylon2"
    part:t="rocket_pylon3"
    part:t="rocket_pylon4"
    part:t="210mm_tube_l"
    part:t="210mm_tube_r"
  }
}

base_me_262a_1a_early_sc_500_launcher{
  item__name:t="guns/de_sc500"
