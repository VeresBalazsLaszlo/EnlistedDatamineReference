entity{
  _template:t="dagdp_level_settings"
  dagdp__max_objects:i=10000
}

entity{
  _template:t="dagdp_object_group_riex"
  dagdp__name:t="leaves"

  "dagdp__params:object"{
    scale:p2=0.925, 0.225
    orientation:t="normal"
  }

  "dagdp__assets:object"{

    "autumn_leaf_pile_a:object"{
      weight:r=1.0
    }

    "autumn_leaf_pile_b:object"{
      weight:r=1.0
    }

    "autumn_leaf_pile_c:object"{
      weight:r=1.0
    }

    "autumn_leaf_pile_d:object"{
      weight:r=1.0
    }

    "autumn_leaf_pile_e:object"{
      weight:r=1.0
    }
  }
}

