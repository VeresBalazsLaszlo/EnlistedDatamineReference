    }

    "seats:object"{
      name:t="driver"
      locName:t="vehicle_seats/driver"
      seatOwnsEntityControl:b=yes
      attachNode:t="driver"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.978137, 0.207909, 0.0] [-0.207909, 0.978139, 0.0] [0.0, 0.0, 0.999992] [-0.33, -0.31, -0.02]]
