bomb_crater_terraformer{

  _group{
    _tags:t="server"
    bomb_crater_terraformer__processPartsPerFrame:i=7
    bomb_crater_terraformer__gridWidth:i=5
    bomb_crater_terraformer__railroadHalfWidth:r=3.0
    bomb_crater_terraformer__processedPartsCount:i=0
    bomb_crater_terraformer__position:p3=0.0, 0.0, 0.0
    bomb_crater_terraformer__innerRadius:r=0.0
    bomb_crater_terraformer__innerDepth:r=0.0
    bomb_crater_terraformer__outerAlt:r=0.0
    bomb_crater_terraformer__outerRadius:r=0.0
    bomb_crater_terraformer__expectedRiHandlesToRemoveCount:i=32
    bomb_crater_terraformer__mainPhysmatId:i=-1
    bomb_crater_terraformer__disableRiRemoval:b=no
    bomb_crater_terraformer__disableSmoke:b=no

    "bomb_crater_terraformer__availablePartsMask:u64"{
      value:i64=0
    }

    "bomb_crater_terraformer__availableDigPartsMask:u64"{
      value:i64=0
    }

    "bomb_crater_terraformer__riHandlesToRemove:list<u64>"{
    }
  }
}

