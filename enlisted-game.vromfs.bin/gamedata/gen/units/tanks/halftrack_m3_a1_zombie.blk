        limitMax:p3=0.5, 0.5, 0.0
        name:t="bone_suspension_$1_$2_03"
      }

      suspension_02_04{
        limitMin:p3=-0.5, -0.5, 0.0
        limitMax:p3=0.5, 0.5, 0.0
        name:t="bone_suspension_$1_$2_04"
      }

      wheel_01{

        searchChildren{
          occurence:i=1
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          parent:t="suspension_02_02"
          find:t="bone_wheel_"
        }
      }

      wheel_02{

        searchChildren{
          occurence:i=2
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
