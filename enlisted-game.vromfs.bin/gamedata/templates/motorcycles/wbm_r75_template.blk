wbm_r75_medic{
  _use:t="wbm_r75_common"
  _use:t="vehicle_with_attached_medkit_box"
  skin__template:t="wbm_r75_medic_skins"
  item__name:t="items/wbm_r75_medic"
  vehicleName:t="wbm_r75_medic"

  "animchar__objTexReplace:object"{
    "ger_camo_dunkelgelb_africa*":t="ger_camo_medic_squad*"
    "bmw_r75_tex_c*":t="bmw_r75_medic_tex_c*"
    "bmw_r75_tex_n*":t="bmw_r75_medic_tex_n*"
  }

  _group{
    _tags:t="gameClient"

    "dm_parts__specialViewPartNames:shared:list<t>"{
      name:t="ammo_body_01"
      name:t="ammo_body_02"
      name:t="ammo_body_03"
    }
  }
}

wbm_r75{
