  game_effect__forceAnimUpperNonCrawlState:t="upper_satchel"
  game_effect__forceAnimUpperCrawlState:t="satchel_plant_crawl"
  game_effect_sound__watched:t="env_effects/bomb_site/deactivate_action"
  game_effect_sound__other:t="env_effects/bomb_site/deactivate_action"
