  collres__res:t="m49a2_ammo_collision"
}

m49a2_phys_base{
  _use:t="m49a2_shell"
  _use:t="projectile_phys"
  _use:t="mine_shell_fly_sound"
  _use:t="block_rethrow_shell"
  havePairCollision:b=no
  start_omega:p3=0.0, 0.0, 0.0
  shell__expl_node:t="weapon"
  shell__active:b=yes
  shell__launchTime:r=-1.0
  shell__cleanupTime:r=30.0
  shell__fuseTime:r=2.0
  shell__explNodeIdx:i=-1
  shell__waterImpactFx:t="hit_water_medium_effect"

  "shell__explodeOnContact:tag"{
  }

  "shell__orientationByVelocity:tag"{
  }

  "client_side_delayed_destroy:tag"{
    _tags:t="netClient"
  }
}

m49a2_phys{
  _use:t="m49a2_phys_base"
  phys_obj_net_phys__blk:t="gamedata/weapons/shells/m49a2.blk"
  shell_explosion_fx__infoTemplate:t="hit_effect_group_mortar_shell_explosion"

  "shell__concussionMaxRadius:r"{
    value:r=3.6
    _tags:t="server"
  }

  _group{
    _tags:t="server"
    bullet_crater__explosiveMassOverride:r=1.0
