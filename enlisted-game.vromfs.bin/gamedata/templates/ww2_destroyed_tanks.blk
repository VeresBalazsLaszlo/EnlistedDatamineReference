  }

  phys_vars{
  }

  collres{
  }

  phys_obj_net_phys{
  }

  base_net_phys_ptr{
  }

  pair_collision__gridHolders{
  }

  "pair_collision__gridNames:list<t>"{
    h:t="humans"
    h:t="vehicles"
  }

  "collidableToPhysObj:tag"{
  }

  "collidableToHuman:tag"{
  }

  "invulnerable:tag"{
  }

  "projectilesCanRicochet:tag"{
  }

  "useVehicleHitFx:tag"{
  }

  "vehicle_tracks_visual_pos:p2"{
    _tags:t="render"
  }

  "vehicle_tracks_visual_pos_delta:p2"{
    _tags:t="render"
  }

  "explosionCover:tag"{
  }

  "blockTerraform:tag"{
  }
}

