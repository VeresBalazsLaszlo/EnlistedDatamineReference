      seatAnimUpper:t="drive_passenger"
      seatAnimLower:t="drive_passenger"
      isHoldGunModeAllowed:b=no

      "effectors:object"{
        r.hand:t="righthand_4"
        l.hand:t="lefthand_4"
        r.foot:t="pedal_rfoot_4"
        l.foot:t="pedal_lfoot_4"
      }
    }

    "seats:object"{
      name:t="loader"
      canPlaceManually:b=no
      locName:t="vehicle_seats/loader"
      attachNode:t="loader"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.371707, -0.529761, -0.761992] [0.200742, 0.847226, -0.491095] [0.906049, 0.0295895, 0.421407] [-0.17, -0.05, 0.31]]
