PhysSys{

  group{
    find:t="^bone_suspension_tb_(._\d\d)$"

    points{

      suspension{
        name:t="bone_suspension_tb_$1"
        limitMin:p3=0.0, 0.0, 0.0
        limitMax:p3=0.0, 0.0, 0.0
      }

      wheel{
        name:t="bone_wheel_tb_$1"
        limitMin:p3=-1.0, -1.0, 0.0
        limitMax:p3=1.0, 1.0, 0.0
      }
    }

    constraints{

      edge{
        from:t="suspension"
        to:t="wheel"
      }
    }
  }

  group{
    find:t="bone_suspension_(\w)_(\d+)$"

    points{

      lever{
        limitMin:p3=0.0, 0.0, 0.0
        limitMax:p3=0.0, 0.0, 0.0
        name:t="bone_suspension_$1_$2"
      }

      suspension_01{
        limitMin:p3=-1.0, -1.0, 0.0
        limitMax:p3=1.0, 1.0, 0.0
        name:t="bone_suspension_$1_$2_01"
      }

      wheel_01{

        searchChildren{
          occurence:i=1
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          parent:t="lever"
          find:t="bone_wheel_"
        }
      }

      wheel_02{

        searchChildren{
          occurence:i=1
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          parent:t="suspension_01"
          find:t="bone_wheel_"
        }
      }
    }

    constraints{

      edge{
        to:t="wheel_01"
        from:t="lever"
        moveSecond:b=no
      }

      edge{
        from:t="lever"
        to:t="suspension_01"
        rotateSecond:b=yes
      }

      edge{
        from:t="wheel_02"
        to:t="suspension_01"
        rotateSecond:b=yes
      }

      direction{
        moveNodes:b=yes
        rotateSecond:b=no
        moveSecond:b=yes
        moveOnly:b=no
        from:t="lever"
        to:t="suspension_01"
        point:t="wheel_01"
      }

      projection{
        moveEdge:b=yes
        moveEdgeNodes:b=no
        point:t="lever"
        from:t="suspension_01"
        to:t="wheel_01"
      }
    }
  }
}

