VehiclePhys{
  skipUpdateOnSleep:b=yes

  Mass{
    Empty:r=29000.0
    Fuel:r=1000.0
    TakeOff:r=30000.0
    momentOfInertia:p3=2.5, 2.5, 6.0
    CenterOfGravity:p3=0.1, 0.8, 0.0
    CenterOfGravityClampY:p2=0.0, 0.7
    AdvancedMass:b=no
    trackMass:r=2500.0
  }

  tracks{
    animationMultiplier:r=-0.68
    height:r=0.05
    width:r=0.51
    fricFrontal:p2=1.0, 0.9
    fricSideRot:p4=5.0, 0.0, 0.7, 0.3
  }

  collisionProps{
    cls_body_01:t="convex_hull"
    cls_body:t="convex_hull"
  }

  engine{
    horsePowers:r=200.0
    maxRPM:r=1900.0
    minRPM:r=600.0
  }

  mechanics{
    steerType:t="clutch_braking"
    maxBrakeForce:r=180000.0
    driveGearRadius:r=0.35
    mainGearRatio:r=22.1
    sideGearRatio:r=1.0
    neutralGearRatio:r=8.0

    gearRatios{
      ratio:r=-1.795
      ratio:r=-3.1
      ratio:r=-7.55
      ratio:r=0.0
      ratio:r=3.7
      ratio:r=1.87
      ratio:r=0.94
    }
  }

  suspension{
    suspensionOffsets:p3=-0.07, -0.04, 0.04
    defaultGearRadius:r=0.23
    topGearRadius:r=0.1
    frontBackGearRadius:r=0.35
    defaultDampeningForce:p2=180000.0, 180000.0
    dampeningRelaxationRatio:r=0.4
    dampeningCompressionRatio:r=0.15
    wheel_r_drive:r=0.35
    wheel_l_drive:r=0.35
    recalcWtms:b=yes
  }
}

