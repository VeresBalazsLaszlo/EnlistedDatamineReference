base_sherman_ii{
  _use:t="base_tank"
  _use:t="sherman_ii_ammo_stowages"
  _use:t="vehicle_physical_tracks"
  killLogName:t="uk_sherman_ii"
  animchar__res:t="sherman_II_char"
  collres__res:t="sherman_II_collision"
  vehicle_net_phys__blk:t="gamedata/gen/units/tanks/sherman_ii.blk:VehiclePhys"
  particle_phys__blk:t="gamedata/gen/units/tanks/sherman_ii.blk:PhysSys"
  dmg_animchar__res:t="sherman_II_dmg_char"
  xray_resource__modelName:t="sherman_II"
  cockpit__zoomOutFov:r=2.7475
  cockpit__zoomInFov:r=5.3955
  cockpit__sightName:t="sight_model/default_tank_spg"
  cockpit__sightFov:r=20.0
  drowningHeight:r=2.192
  damage_model__blk:t="gamedata/gen/units/tanks/sherman_ii.blk"
  item__name:t="items/uk_sherman_ii"
  physical_tracks__blk:t="gamedata/gen/units/tanks/sherman_ii.blk"
  skin__template:t="sherman_ii_skins"
  losable_turret__detachBone:t="bone_turret"
  losable_turret__detachCollNode:t="cls_turret_01"
  losable_turret__mass:r=4300.0
  losable_turret__deviation:r=0.5
  losable_turret__rotation:r=0.5
  fire_damage__openHatchesOnExplosion:b=yes

  "turret_gun_flash_fx__flashNodes:shared:array"{
    node:t="emtr_gun_flame"
    node:t="emtr_mg_flame_01"
    node:t="emtr_mg_aa_flame_01"
    node:t="emtr_mg_flame_02"
  }

  "turret_gun_flash_fx__flashFx:shared:array"{
    fx:t="muzzle_ground_60mm"
    fx:t="muzzle_ground_8mm"
    fx:t="muzzle_ground_15mm"
    fx:t="muzzle_ground_8mm"
  }

  "turret_gun_flash_fx__flashFxScale:shared:array"{
    scale:r=1.0
    scale:r=1.0
    scale:r=1.0
    scale:r=1.0
  }

  "turret_control__emitterNodes:shared:array"{
    node:t="bone_gun_barrel"
    node:t="bone_mg_gun_twin"
    node:t="bone_mg_aa_v_01"
    node:t="bone_mg_v_02"
  }

  "turret_control__animVars:shared:array"{

    "vars:object"{
      curYawParamName:t="turret_01_yaw"
      curPitchParamName:t="gun_01_pitch"
      aimActiveParamName:t="aim_01_active"
      paramYawSpeed:t="turret_01_yaw_speed"
      paramYawSpeedMul:t="turret_01_yaw_mul"
      paramYawAccel:t="turret_01_yaw_accel"
      paramMinYawAngle:t="turret_01_min_yaw_angle"
      paramMaxYawAngle:t="turret_01_max_yaw_angle"
      paramMinPitchAngle:t="turret_01_min_pitch_angle"
      paramMaxPitchAngle:t="turret_01_max_pitch_angle"
      paramPitchSpeed:t="gun_01_pitch_speed"
      paramPitchSpeedMul:t="gun_01_pitch_mul"
      paramPitchAccel:t="gun_01_pitch_accel"
      wishYawParamName:t="gun_01_aim:targetYaw"
      wishPitchParamName:t="gun_01_aim:targetPitch"
      gunRecoilParamName:t="gun_01_recoil"
      hasStabilizerParamName:t="gun_01_aim:hasStab"
      stabilizerPitchParamName:t="gun_01_aim:stabPitch"
      stabilizerErrorParamName:t="gun_01_aim:stabError"
      stabilizerPitchMultParamName:t="gun_01_aim:stabPitchMult"
    }

    "vars:object"{
      curYawParamName:t="turret_03_yaw"
      curPitchParamName:t="gun_03_pitch"
    }

    "vars:object"{
      curYawParamName:t="turret_02_yaw"
      curPitchParamName:t="gun_02_pitch"
      aimActiveParamName:t="aim_02_active"
      paramYawSpeed:t="turret_02_yaw_speed"
      paramYawSpeedMul:t="turret_02_yaw_mul"
      paramYawAccel:t="turret_02_yaw_accel"
      paramMinYawAngle:t="turret_02_min_yaw_angle"
      paramMaxYawAngle:t="turret_02_max_yaw_angle"
      paramMinPitchAngle:t="turret_02_min_pitch_angle"
      paramMaxPitchAngle:t="turret_02_max_pitch_angle"
      paramPitchSpeed:t="gun_02_pitch_speed"
      paramPitchSpeedMul:t="gun_02_pitch_mul"
      paramPitchAccel:t="gun_02_pitch_accel"
      wishYawParamName:t="gun_02_aim:targetYaw"
      wishPitchParamName:t="gun_02_aim:targetPitch"
    }

    "vars:object"{
      curYawParamName:t="turret_04_yaw"
      curPitchParamName:t="gun_04_pitch"
      aimActiveParamName:t="aim_04_active"
      paramYawSpeed:t="turret_04_yaw_speed"
      paramYawSpeedMul:t="turret_04_yaw_mul"
      paramYawAccel:t="turret_04_yaw_accel"
      paramMinYawAngle:t="turret_04_min_yaw_angle"
      paramMaxYawAngle:t="turret_04_max_yaw_angle"
      paramMinPitchAngle:t="turret_04_min_pitch_angle"
      paramMaxPitchAngle:t="turret_04_max_pitch_angle"
      paramPitchSpeed:t="gun_04_pitch_speed"
      paramPitchSpeedMul:t="gun_04_pitch_mul"
      paramPitchAccel:t="gun_04_pitch_accel"
      wishYawParamName:t="gun_04_aim:targetYaw"
      wishPitchParamName:t="gun_04_aim:targetPitch"
    }
  }

  "turret_control__turretInfo:shared:array"{

    "turretInfo:object"{
      turretName:t="turret_01"
      gun:t="sherman_ii_turret_01_75mm_m3+turret_with_several_types_of_shells+main_turret"
      barrelDm:t="gun_barrel"
      breechDm:t="cannon_breech"
      verDriveDm:t="drive_turret_v"
      horDriveDm:t="drive_turret_h"
      salt:i=1
    }

    "turretInfo:object"{
      turretName:t="turret_02"
      gun:t="sherman_ii_turret_03_7_62mm_m1919a4"
      barrelDm:t="gun_barrel_01"
      salt:i=1
    }

    "turretInfo:object"{
      turretName:t="turret_03"
      gun:t="sherman_ii_turret_02_12_7mm_m2_hb"
      barrelDm:t="gun_barrel_02"
      salt:i=1
    }

    "turretInfo:object"{
      turretName:t="turret_04"
      gun:t="sherman_ii_turret_04_7_62mm_m1919a4"
      barrelDm:t="gun_barrel_03"
      salt:i=1
    }
  }
}

sherman_ii_turret_01_75mm_m3{
  _use:t="tankgun_75mm_m3"
  gun__shootNodeName:t="bone_gun_barrel"
  turret__yawSpeed:r=24.0
  turret__pitchSpeed:r=4.0
  turret__aimNodeName:t="bone_turret"
  turret__limit:p4=-180.0, 180.0, -12.0, 18.0
  turret__stabilizerPitchFrictionMult:r=0.8
  turret__stabilizerPitchSpeedLimitKph:r=24.0

  "turret__stabilizerErrorByKphSpeedTable:list<p2>"{
    row:p2=5.0, 0.0
    row:p2=10.0, 0.05
    row:p2=12.0, 0.4
  }

  "gun__shellsAmmo:array"{
    ammo:i=18
    ammo:i=18
    ammo:i=18
    ammo:i=18
    ammo:i=18
  }
}

sherman_ii_turret_02_12_7mm_m2_hb{
  _use:t="tankgun_12_7mm_m2_hb"
  gun__shootNodeName:t="bone_mg_aa_v_01"
  turret__yawSpeed:r=90.0
  turret__pitchSpeed:r=90.0
  turret__aimNodeName:t="bone_mg_aa_h_01"
  turret__limit:p4=-60.0, 60.0, -10.0, 22.0

  "gun__shellsAmmo:array"{
    ammo:i=120
    ammo:i=120
    ammo:i=120
    ammo:i=120
    ammo:i=120
  }
}

sherman_ii_turret_03_7_62mm_m1919a4{
  _use:t="tankgun_7_62mm_m1919a4"
  gun__shootNodeName:t="bone_mg_gun_twin"

  "gun__shellsAmmo:array"{
    ammo:i=3000
  }
}

sherman_ii_turret_04_7_62mm_m1919a4{
  _use:t="tankgun_7_62mm_m1919a4"
  gun__shootNodeName:t="emtr_mg_flame_02"
  turret__yawSpeed:r=35.0
  turret__pitchSpeed:r=35.0
  turret__aimNodeName:t="bone_mg_h_02"
  turret__limit:p4=-10.0, 10.0, -10.0, 10.0

  "gun__shellsAmmo:array"{
    ammo:i=1500
    ammo:i=1500
  }
}

sherman_ii_ammo_stowages{
  _tags:t="server"
  _use:t="vehicle_ammo_stowages"

  "ammo_stowage__stowageTemplates:shared:list<t>"{
    stowage:t="sherman_ii_ammo_stowage_1"
  }
}

sherman_ii_ammo_stowage_1{
  _use:t="ammo_stowage"

  "ammo_stowage__clusterTemplates:shared:list<t>"{
    cluster:t="sherman_ii_ammo_cluster_1_1"
  }

  "ammo_stowage__turretNames:shared:list<t>"{
    gun:t="turret_01"
  }
}

sherman_ii_ammo_cluster_1_1{
  _use:t="ammo_cluster"
  ammo_cluster__isShell:b=yes

  "ammo_cluster__slotNames:shared:list<t>"{
    part:t="ammo_turret_01"
    part:t="ammo_turret_02"
    part:t="ammo_turret_03"
    part:t="ammo_turret_04"
    part:t="ammo_body_r_02"
    part:t="ammo_body_r_01"
    part:t="ammo_body_l_01"
    part:t="ammo_body"
  }

  "ammo_cluster__slotsMaxAmmo:list<i>"{
    count:i=9
    count:i=7
    count:i=3
    count:i=2
    count:i=16
    count:i=16
    count:i=16
    count:i=21
  }
}