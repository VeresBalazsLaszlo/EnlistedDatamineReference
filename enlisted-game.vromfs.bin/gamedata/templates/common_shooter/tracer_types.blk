tracer__base_tracer{
  ignitionTime:r=0.005
  burnTime:r=1.1
  smokeTime:r=1.0
  luminosity:r=10.0
  smokeColor:p4=1.0, 0.902, 0.702, 0.8
  headColor:p3=1.0, 0.667, 0.333
  startHeadColor:p3=1.0, 0.667, 0.333
  startTime:r=0.0
  smokeRadius:r=0.01
}

tracer__infantry_base{
  _use:t="tracer__base_tracer"
  ignitionTime:r=0.002
  burnTime:r=1.8
}

tracer_start__invisible{
  startHeadColor:p3=0.0, 0.0, 0.0
  startTime:r=0.0
}

tracer_start__yellow_flash{
