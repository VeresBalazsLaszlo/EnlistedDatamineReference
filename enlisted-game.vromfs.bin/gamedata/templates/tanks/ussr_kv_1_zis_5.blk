ussr_kv_1_zis_5_common{
  _use:t="base_kv_1_zis_5"
  _use:t="ussr_kv_1_zis_5_common_vehicle_sound"
  _use:t="vehicle_damage_decals_decor"
  commanderCockpitFpsCamMaxAngle:p2=40.0, 5.0
