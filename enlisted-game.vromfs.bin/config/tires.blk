omnidirectionalTextureName:t="vehicle_trails_omnidirectional_drift_c"

SpawnParams{
  finalizeTime:r=0.5

  carside_speed{
    min:r=3.0
    max:r=10.0
  }
}

VisualParams{
  shaderName:t="tires_default"
  slope:r=0.06
  maxTrackVertices:i=800
  maxTrackCount:i=128
  maxVisibleDist:r=100.0
  width:r=0.45
  widthTexturePart:r=0.33
  fadeTrackEnds:b=yes
  maxOmnidirTexBlendDelta:r=0.33

  length{
    min:r=0.75
    max:r=3.5
  }

  critical_angle{
    horizontal:r=30.0
    vertical:r=20.0
  }
}

Texture{

  normal_tracks{
    name:t="tank_trails_c"
    normalName:t="tank_trails_n"
    frames:i=8
    spacing:r=0.001
    textureLength:r=2.5
  }

  wheel_trails{
    name:t="wheel_trails_c"
    normalName:t="wheel_trails_n"
    frames:i=8
    spacing:r=0.001
    textureLength:r=2.5
  }
}