}

no_69_impact_grenade_phys{
  _use:t="impact_grenade_phys_base"
  _use:t="no_69_impact_grenade_base"
  phys_obj_net_phys__blk:t="gamedata/weapons/grenades/no_69_impact_grenade.blk"
}

no_69_impact_grenade_item{
  _use:t="impact_grenade_item_base"
  _use:t="no_69_impact_grenade_base"
  item__weight:r=0.383
  item__template:t="no_69_impact_grenade_item"
  item__userstats__pickupName:t="pickup_no_69_impact_grenade"
  item__shell:t="gamedata/weapons/grenades/no_69_impact_grenade.blk"
  item__proto:t="gamedata/weapons/grenades/no_69_impact_grenade.blk"
}

