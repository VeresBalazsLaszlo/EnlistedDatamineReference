base_willys_mb_armored{
  _use:t="base_tank"
  killLogName:t="us_willys_mb_armored"
  animchar__res:t="willys_mb_armored_char"
  collres__res:t="willys_mb_armored_collision"
  vehicle_net_phys__blk:t="gamedata/gen/units/tanks/willys_mb_armored.blk:VehiclePhys"
  particle_phys__blk:t="gamedata/gen/units/tanks/willys_mb_armored.blk:PhysSys"
  dmg_animchar__res:t="willys_mb_armored_dmg_char"
  xray_resource__modelName:t="willys_mb_armored"
  drowningHeight:r=1.75
  damage_model__blk:t="gamedata/gen/units/tanks/willys_mb_armored.blk"
  item__name:t="items/us_willys_mb_armored"
  skin__template:t="willys_mb_armored_skins"

  _group{
    _tags:t="gameClient"
    chain_ik__blk:t="gamedata/gen/units/tanks/willys_mb_armored.blk:chainIK"
  }

  "turret_gun_flash_fx__flashNodes:shared:array"{
    node:t="emtr_gun_flame_01"
    node:t="emtr_gun_flame_02"
  }

  "turret_gun_flash_fx__flashFx:shared:array"{
    fx:t="muzzle_ground_15mm"
    fx:t="muzzle_ground_15mm"
  }

  "turret_gun_flash_fx__flashFxScale:shared:array"{
    scale:r=1.0
    scale:r=1.0
  }

  "turret_control__emitterNodes:shared:array"{
    node:t="bone_gun_barrel_01"
    node:t="bone_gun_barrel_02"
  }

  "turret_control__animVars:shared:array"{

    "vars:object"{
      curYawParamName:t="turret_01_yaw"
      curPitchParamName:t="gun_01_pitch"
      aimActiveParamName:t="aim_01_active"
      paramYawSpeed:t="turret_01_yaw_speed"
      wishYawParamName:t="gun_01_aim:targetYaw"
      paramYawAccel:t="turret_01_yaw_accel"
      paramPitchSpeed:t="gun_01_pitch_speed"
      wishPitchParamName:t="gun_01_aim:targetPitch"
      paramPitchAccel:t="gun_01_pitch_accel"
      paramMinYawAngle:t="turret_01_min_yaw_angle"
      paramMaxYawAngle:t="turret_01_max_yaw_angle"
      paramMinPitchAngle:t="turret_01_min_pitch_angle"
      paramMaxPitchAngle:t="turret_01_max_pitch_angle"
    }

    "vars:object"{
      curYawParamName:t="turret_02_yaw"
      curPitchParamName:t="gun_02_pitch"
    }
  }

  "turret_control__turretInfo:shared:array"{

    "turretInfo:object"{
      turretName:t="turret_01"
      gun:t="willys_mb_armored_m8_bazooka_turret_01+main_turret"
      salt:i=1
      barrelDm:t="gun_barrel_01"
    }

    "turretInfo:object"{
      turretName:t="turret_02"
      gun:t="willys_mb_armored_m8_bazooka_turret_02+main_turret"
      salt:i=1
      barrelDm:t="gun_barrel_02"
    }
  }
}

willys_mb_armored_turret_item_01{
  _use:t="base_tank_rocket_item"
  animchar__res:t="us_m8_bazooka_rocket_char"
}

willys_mb_armored_turret_item_02{
  _use:t="base_tank_rocket_item"
  animchar__res:t="us_m8_bazooka_rocket_char"
}

willys_mb_armored_m8_bazooka_turret_01{
  _use:t="base_tank_rocket_gun"
  gun__shootNodeEmitterGenFmt:t="bone_rocket_01"
  gun__shootNodeName:t="bone_rocket_01"
  turret__yawSpeed:r=80.0
  turret__pitchSpeed:r=80.0
  turret__aimNodeName:t="bone_turret"
  turret__limit:p4=-90.0, 90.0, -10.0, 15.0
  turret__triggerGroup:i=0
  gun__projectileTemplate:t="m_8_bazooka_willys_rocket_projectile"
  gun__projectileDebugTemplate:t="m_8_bazooka_willys_rocket_projectile+bomb_projectile_debug"
  item__name:t="guns/m1_bazooka"
  gun__blk:t="gamedata/weapons/m4_sherman_calliope/m8_launcher.blk"
  gun__shotFreq:r=0.5
  gun__locName:t="m1_bazooka"
  gun__shootNodeItemTemplate:t="willys_mb_armored_turret_item_01"
  gun__maxAmmo:i=8
  gun__ammo:i=8

  "gun_sound__shotPath:shared:object"{
    _tags:t="sound"
    path:t="/weapon/antivehicle/m1_bazooka"
  }

  "gun__ammoSetsInfo:shared:array"{

    "default:array"{

      "shell:object"{
        blk:t="gamedata/weapons/shells/m6a1_bazooka_rocket.blk"
        name:t="m6a1_bazooka"
        type:t="heat_tank"
      }
    }
  }

  "gun__shellsAmmoEids:list<eid>"{
  }

  "gun__shootNodeIds:list<i>"{
  }

  "gun__shellsAmmo:array"{
    ammo:i=8
  }
}

willys_mb_armored_m8_bazooka_turret_02{
  _use:t="base_tank_rocket_gun"
  gun__shootNodeEmitterGenFmt:t="bone_rocket_02"
  gun__shootNodeName:t="bone_rocket_02"
  turret__triggerGroup:i=1
  gun__projectileTemplate:t="m_8_bazooka_willys_rocket_projectile"
  gun__projectileDebugTemplate:t="m_8_bazooka_willys_rocket_projectile+bomb_projectile_debug"
  item__name:t="guns/m1_bazooka"
  gun__blk:t="gamedata/weapons/m4_sherman_calliope/m8_launcher_01.blk"
  gun__shotFreq:r=0.5
  gun__locName:t="m1_bazooka"
  gun__shootNodeItemTemplate:t="willys_mb_armored_turret_item_02"
  gun__maxAmmo:i=8
  gun__ammo:i=8

  "gun_sound__shotPath:shared:object"{
    _tags:t="sound"
    path:t="/weapon/antivehicle/m1_bazooka"
  }

  "gun__ammoSetsInfo:shared:array"{

    "default:array"{

      "shell:object"{
        blk:t="gamedata/weapons/shells/m6a1_bazooka_rocket.blk"
        name:t="m6a1_bazooka"
        type:t="heat_tank"
      }
    }
  }

  "gun__shellsAmmoEids:list<eid>"{
  }

  "gun__shootNodeIds:list<i>"{
  }

  "gun__shellsAmmo:array"{
    ammo:i=8
  }
}