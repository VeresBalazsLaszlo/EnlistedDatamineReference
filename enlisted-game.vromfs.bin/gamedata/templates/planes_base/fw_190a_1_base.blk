base_fw_190a_1{
  plane_phys_damage__blk:t="gamedata/units/fw_190a_1.blk"
  animchar__res:t="fw_190a_1_char"
}

fw_190a_1_wreckage{
  _use:t="base_fw_190a_1"
  _use:t="plane_wreckage"
  plane_wreckage__nodeName:t=""
  plane_wreckage__typeName:t=""
}

fw_190a_1_base{
  _use:t="plane_with_cockpit"
  _use:t="base_fw_190a_1"
  collres__res:t="fw_190a_1_collision"
  plane_net_phys__blk:t="gamedata/units/fw_190a_1.blk"
  damage_model__blk:t="gamedata/units/fw_190a_1.blk"
  plane_collision__blk:t="gamedata/units/fw_190a_1.blk"
  plane_anim__blk:t="gamedata/units/fw_190a_1.blk"
  plane_sight__blk:t="gamedata/units/fw_190a_1.blk"
  canUseRespawnbaseType:t="aircraft_fighter"
  is_seaplane:b=no
  plane_wreckage__template:t="fw_190a_1_wreckage"
  killLogName:t="fw_190a_1"
  animchar__res:t="fw_190a_1_char"
  vehicle_seats_camera_nodes__defaultNode:t=""

  _group{
    _tags:t="render"
    animchar_camera_target__node_name:t=""
    animchar_camera_target__node_offset:p3=0.0, 0.0, 0.0
  }

  "vehicle_seats_can_acquire_controls:list<i>"{
  }

  "vehicle_seats__canAcquireControls:shared:object"{

    "driver:object"{
      movement:b=yes
      turrets:b=yes
    }

    "main_gunner:object"{
      turrets:b=yes
    }
  }
}