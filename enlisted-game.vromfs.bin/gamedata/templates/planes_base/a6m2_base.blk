base_a6m2{
  plane_phys_damage__blk:t="gamedata/units/a6m2.blk"
  animchar__res:t="a6m2_char"
}

a6m2_wreckage{
  _use:t="base_a6m2"
  _use:t="plane_wreckage"
  plane_wreckage__nodeName:t=""
  plane_wreckage__typeName:t=""
}

a6m2_base{
  _use:t="plane_with_cockpit"
  _use:t="base_a6m2"
  collres__res:t="a6m2_collision"
  plane_net_phys__blk:t="gamedata/units/a6m2.blk"
  damage_model__blk:t="gamedata/units/a6m2.blk"
  plane_collision__blk:t="gamedata/units/a6m2.blk"
  plane_anim__blk:t="gamedata/units/a6m2.blk"
  plane_sight__blk:t="gamedata/units/a6m2.blk"
  plane_input__autopilotImpl:t="No"
  canUseRespawnbaseType:t="aircraft_fighter"
  is_seaplane:b=no
  plane_wreckage__template:t="a6m2_wreckage"
  killLogName:t="a6m2_zero"
  animchar__res:t="a6m2_char"
  vehicle_seats_camera_nodes__defaultNode:t=""

  _group{
    _tags:t="render"
    animchar_camera_target__node_name:t=""
    animchar_camera_target__node_offset:p3=0.0, 0.0, 0.0
  }

  "vehicle_seats_can_acquire_controls:list<i>"{
  }

  "vehicle_seats__canAcquireControls:shared:object"{

    "driver:object"{
      movement:b=yes
      turrets:b=yes
    }

    "main_gunner:object"{
      turrets:b=yes
    }
  }
}