  _use:t="trails_effect_base"

  _group{
    _tags:t="render"
    effect__name:t="trail_main_small_smoke_dark_cmps_fx"
  }
}

trail_main_small_smoke_light_effect{
  _use:t="trails_effect_base"

  _group{
    _tags:t="render"
    effect__name:t="trail_main_small_smoke_light_cmps_fx"
  }
}

