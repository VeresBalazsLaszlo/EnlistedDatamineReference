  gun_anim_var__fpsGunOffsetAlong:r=0.15
  gun_anim_var__fpsGunOffsetAcross:r=0.02
  gun_anim_var__fpsGunOffsetUp:r=0.02

  _group{
    _tags:t="sound"
    gun_sound__forceOneshot:b=yes
