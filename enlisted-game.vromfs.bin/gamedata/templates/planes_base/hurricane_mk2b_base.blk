base_hurricane_mk2b{
  plane_phys_damage__blk:t="gamedata/units/hurricane_mk2b.blk"
  animchar__res:t="hurricane_mk2b_char"
}

hurricane_mk2b_wreckage{
  _use:t="base_hurricane_mk2b"
  _use:t="plane_wreckage"
  plane_wreckage__nodeName:t=""
  plane_wreckage__typeName:t=""
}

hurricane_mk2b_base{
  _use:t="plane_with_cockpit"
  _use:t="base_hurricane_mk2b"
  collres__res:t="hurricane_mk2b_collision"
  plane_net_phys__blk:t="gamedata/units/hurricane_mk2b.blk"
  damage_model__blk:t="gamedata/units/hurricane_mk2b.blk"
  plane_collision__blk:t="gamedata/units/hurricane_mk2b.blk"
  plane_anim__blk:t="gamedata/units/hurricane_mk2b.blk"
  plane_sight__blk:t="gamedata/units/hurricane_mk2b.blk"
  plane_input__autopilotImpl:t="No"
  canUseRespawnbaseType:t="aircraft_fighter"
  is_seaplane:b=no
  plane_wreckage__template:t="hurricane_mk2b_wreckage"
  killLogName:t="hurricanemkii"
  animchar__res:t="hurricane_mk2b_char"
  vehicle_seats_camera_nodes__defaultNode:t=""

  _group{
    _tags:t="render"
    animchar_camera_target__node_name:t=""
    animchar_camera_target__node_offset:p3=0.0, 0.0, 0.0
  }

  "vehicle_seats_can_acquire_controls:list<i>"{
  }

  "vehicle_seats__canAcquireControls:shared:object"{

    "driver:object"{
      movement:b=yes
      turrets:b=yes
    }

    "main_gunner:object"{
      turrets:b=yes
    }
  }
}