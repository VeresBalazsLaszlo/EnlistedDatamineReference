    "point:object"{
      type:t="rest"
      recoil:r=-1.0
      offset:p3=0.515, -0.0175, 0.0
    }

    "point:object"{
      type:t="rest"
      recoil:r=-1.0
      offset:p3=0.32, -0.155, 0.0
    }
  }
}

