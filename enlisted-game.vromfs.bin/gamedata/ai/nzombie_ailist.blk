}

sequencer{
  name:t="sub.zombieTryAntiTankWeaponAttack"

  setIntVar{
    to:t="attackTarget"
    value:i=0
  }

  setIntVar{
    to:t="tryAntiTankWeaponAttack"
    value:i=0
  }

  setIntVar{
    to:t="antiTankAttackTarget"
    value:i=0
  }

  orderedSelector{

    sequencer{

      isVarsIntEqual{
        lhs:t="tryAntiTankWeaponAttack"
        rhs_value:i=1
      }

      wait{
        range:p2=1.0, 1.0
        resetable:b=yes
      }
    }

    sequencer{

      not{

        isVarsIntEqual{
          lhs:t="antiTankAttackTarget"
          rhs_value:i=0
        }
      }

      copyIntVar{
        to:t="attackTarget"
        from:t="antiTankAttackTarget"
      }

      setIntVar{
        to:t="antiTankAttackTarget"
        value:i=0
      }

      wait{
        range:p2=1.0, 1.0
        resetable:b=yes
      }
    }

    subTree{
      name:t=""
      treeName:t="sub.checkAntiTankWeaponAttack"
    }
  }

  orderedSelector{

    sequencer{

      findWeaponSlotWithSpecAIType{
        specAIWeapTypeName:t="ROCKET_LAUNCHERS"
        toParam:t="weaponSlot"
        minAmmo:i=1
      }

      changeStance{
        stanceName:t="crouch"
      }

      changeStance{
        stanceName:t="stand"
      }

      changeStance{
        stanceName:t="crouch"
      }

      findPiercableEnemyVehicle{
        outTargetEidParam:t="shootVehicle"
        outLocalPosParam:t="shootAtLocalPos"
        weaponSlotParam:t="weaponSlot"
        shootStance:i=2
        wideTraceRadius:r=0.5
        wideTraceOffsetUp:r=0.2
        wideTraceDistance:r=10.0
        inTargetEidParam:t="attackTarget"
        outShootLocalPosParam:t="shootFromLocalPos"
        chanceToTargetHumanPlayer:r=1.0
      }

      setPosFromEntity{
        to:t="shootVehiclePos"
        from:t="shootVehicle"
      }

      rotateToPoint{
        posParam:t="shootVehiclePos"
        aimSpeedCoef:r=0.5
      }

      wait{
        range:p2=1.0, 2.0
        resetable:b=yes
      }

      wait{
        range:p2=1.0, 2.0
        resetable:b=yes
      }

      wait{
        range:p2=2.0, 3.0
        resetable:b=yes
      }

      changeWeapon{
        param:t="weaponSlot"
      }

      traceLineOfSight{
        fromLocalPosParam:t="shootFromLocalPos"
        toEidParam:t="shootVehicle"
        toLocalPosParam:t="shootAtLocalPos"
        traceDistance:r=4.0
        traceRadius:r=0.5
        traceWorld:b=no
        traceHumans:b=yes
        traceVehicles:b=yes
      }

      setIntVar{
        to:t="maxStance"
        value:i=2
      }

      subTree{
        name:t=""
        treeName:t="sub.antiTankAttackShoot"
      }

      chooseBestWeapon{
      }
    }
  }
}