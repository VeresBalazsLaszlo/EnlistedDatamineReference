orderedSelector{
  name:t="sub.checkEndCoverAttack"

  isVarsIntEqual{
    lhs:t="coverAttack"
    rhs_value:i=0
  }

  sequencer{

    checkCoverForCoverAttack{
    }

    checkAtTime{
      timeParam:t="coverAttackEnemyTime"
      range:p2=0.0, 5.0
    }

    success{

      sequencer{

        checkTargetTraceable{
          targetParam:t="coverAttackEnemy"
        }

        getTime{
          to:t="coverAttackEnemyTime"
        }
      }
    }
  }

  sequencer{

    success{

      ignoreCover{
        coverIndexParam:t="coverAttackCover"
        coverSlotParam:t="coverAttackCoverSlot"
        timeIgnore:p2=8.0, 16.0
      }
    }

    setIntVar{
      to:t="coverAttack"
      value:i=0
    }

    setIntVar{
      to:t="coverAttackType"
      value:i=0
    }

    setIntVar{
      to:t="coverAttackCover"
      value:i=-1
    }

    setIntVar{
      to:t="coverAttackCoverSlot"
      value:i=0
    }

    setIntVar{
      to:t="coverAttackEnemy"
      value:i=0
    }

    setRealVar{
      to:t="coverAttackEnemyTime"
      value:r=0.0
    }

    wait{
      range:p2=0.1, 0.2
      resetable:b=yes
    }
  }
}

orderedSelector{
  name:t="sub.tryBeginCoverAttack"

  not{

    isVarsIntEqual{
      lhs:t="coverAttack"
      rhs_value:i=0
    }
  }

  not{

    isVarsIntEqual{
      lhs:t="regroupToPit"
      rhs_value:i=0
    }
  }

  not{

    sequencer{

      reaction{
        event:t="regularCheck"

        findObstaclesAlongsidePath{
        }
      }

      reaction{
        event:t="onEnemyPlayerNear"

        orderedSelector{

          sequencer{

            findDanger{
              paramName:t="meleeEnemy"
              radiusParamName:t="enemyMeleeRadius"
              minDanger:r=0.5
              tag:t="human"
            }

            decreaseDangerLevel{
              paramName:t="dangerLevel"
              decreaseCoef:r=0.1
            }

            setIntVar{
              to:t="coverAttack"
              value:i=0
            }

            setDebugSym{
              r:i=401
            }

            recalculateTree{
            }
          }

          sequencer{

            findDanger{
              paramName:t="reactShootEnemy"
              radiusParamName:t="enemyNearRadius"
              minDanger:r=0.5
              tag:t="human"
            }

            orderedSelector{

              sequencer{

                isVarsIntEqual{
                  lhs:t="reactShootEnemy"
                  rhs:t="shootEnemy"
                }

                setRealVar{
                  to:t="enemyCloseRadius"
                  value:r=7.0
                }

                not{

                  findDanger{
                    paramName:t="closeEnemy"
                    radiusParamName:t="enemyCloseRadius"
                    minDanger:r=0.5
                    tag:t="human"
                  }
                }
              }

              sequencer{

                decreaseDangerLevel{
                  paramName:t="dangerLevel"
                  decreaseCoef:r=0.1
                }

                setIntVar{
                  to:t="coverAttack"
                  value:i=0
                }

                setDebugSym{
                  r:i=402
                }

                recalculateTree{
                }
              }
            }
          }
        }
      }

      reaction{
        event:t="onDelayedReaction"

        continue{
        }
      }

      reaction{
        event:t="onTraceableDanger"

        continue{
        }
      }

      reaction{
        event:t="onBulletNearby"

        continue{
        }
      }

      getRegroupPos{
        posParam:t="regroupPosition"
      }

      findCoverForCoverAttack{
        targetParam:t="shootEnemy"
        approachPosParam:t="regroupPosition"
      }

      setDebugSym{
        act:t="c1"
      }

      setDebugSym{
        act:t="c2"
      }

      setDebugSym{
        act:t="c3"
      }

      setDebugSym{
        act:t="c4"
      }

      setDebugSym{
        act:t="c5"
      }

      wait{
        range:p2=0.1, 0.2
        resetable:b=yes
      }

      wait{
        range:p2=0.1, 0.2
        resetable:b=yes
      }

      getCoverPosAndDir{
        coverIndexParam:t="coverAttackCover"
        coverSlotParam:t="coverAttackCoverSlot"
        outPosParam:t="coverPos"
      }

      setIntVar{
        to:t="minStance"
        value:i=2
      }

      setIntVar{
        to:t="maxStance"
        value:i=2
      }

      setIntVar{
        to:t="coverAttack"
        value:i=1
      }

      setIntVar{
        to:t="dangerNearbyBeware"
        value:i=1
      }

      detachFromStationaryGun{
      }

      changeStance{
        stanceName:t="stand"
        maxStanceParam:t="maxStance"
      }

      orderedSelector{

        not{

          passedTimeSinceControlledByPlayer{
            time:r=15.0
          }
        }

        checkReloadWeapon{
          waitReloadFinish:b=no
        }
      }

      orderedSelector{

        moveToPos{
          posParam:t="coverPos"
          sprintTimerRange:p2=10.0, 20.0
          minDistToSprint:r=3.0
          distThreshold:r=0.3
          rotateDistThreshold:r=0.5
          rotateFactors:p4=0.5, 0.3, 0.3, 0.1
          rotateStartTime:r=0.5
          avoidAiObstacles:b=no
          timeToStuck:r=0.3
          strafeNearDist:r=2.5
          jumpDownTraceCheck:p3=0.4, 1.0, 0.15
        }

        continue{
        }
      }

      orderedSelector{

        isLookingToPos{
          posParam:t="coverLookPos"
          offAngle:r=15.0
        }

        rotateToPoint{
          posParam:t="coverLookPos"
          aimSpeedCoef:r=0.5
          maxSimAngle:p2=60.0, 80.0
        }
      }

      setPosFromEntity{
        to:t="coverLookPos"
        from:t="shootEnemy"
      }

      copyIntVar{
        to:t="coverAttackEnemy"
        from:t="shootEnemy"
      }

      getTime{
        to:t="coverAttackEnemyTime"
      }

      chooseMinMaxStancesForCoverAttack{
      }

      changeStanceForCoverAttack{
        hide:b=yes
      }

      decreaseDangerLevel{
        paramName:t="dangerLevel"
        decreaseCoef:r=0.1
      }

      initPeriodicTimer{
        timeParam:t="onBulletNearbyTimer"
        timePeriod:p2=5.0, 8.0
      }

      initPeriodicTimer{
        timeParam:t="onTraceableDangerTimer"
        timePeriod:p2=5.0, 8.0
      }

      initPeriodicTimer{
        timeParam:t="onFollowPosFindDangerTimer"
        timePeriod:p2=5.0, 8.0
      }
    }
  }

  isVarsRealLess{
    lhs:t="dangerLevel"
    rhs_value:r=0.9
  }
}

orderedSelector{
  name:t="sub.performCoverAttackMoves"

  sequencer{

    isVarsIntEqual{
      lhs:t="coverAttack"
      rhs_value:i=1
    }

    wait{
      range:p2=0.1, 0.3
      resetable:b=yes
    }

    orderedSelector{

      sequencer{

        reaction{
          event:t="regularCheck"

          findObstaclesAlongsidePath{
            closeInvDoors:b=yes
          }
        }

        reaction{
          event:t="onEnemyPlayerNear"

          continue{
          }
        }

        reaction{
          event:t="onTraceableDanger"

          continue{
          }
        }

        reaction{
          event:t="onBulletNearby"

          continue{
          }
        }

        reaction{
          event:t="onDelayedReaction"

          subTree{
            treeName:t="sub.reactOnDelayedReactionUrgent"
          }
        }

        getCoverPosAndDir{
          coverIndexParam:t="coverAttackCover"
          coverSlotParam:t="coverAttackCoverSlot"
          outPosParam:t="coverPos"
        }

        setDebugSym{
          act:t="c10"
        }

        setDebugSym{
          act:t="c11"
        }

        setDebugSym{
          act:t="c12"
        }

        setDebugSym{
          act:t="c13"
        }

        setDebugSym{
          act:t="c14"
        }

        orderedSelector{

          checkDistance{
            posParam:t="coverPos"
            radius:r=1.0
            yRadius:r=1.0
          }

          subTree{
            treeName:t="sub.hideToCoverAttackCover"
          }
        }

        orderedSelector{

          ignoreChance{
            chance:r=0.3
          }

          wait{
            range:p2=0.1, 0.2
            resetable:b=yes
          }
        }

        orderedSelector{

          checkTargetTraceable{
            targetParam:t="coverAttackEnemy"
          }

          ignoreChance{
            chance:r=0.5
          }

          failed{

            sequencer{

              increaseDangerLevel{
                paramName:t="dangerLevel"
                targetParam:t="coverAttackEnemy"
              }

              increaseDangerLevel{
                paramName:t="dangerLevel"
                targetParam:t="coverAttackEnemy"
              }
            }
          }
        }

        checkReloadWeapon{
        }

        wait{
          range:p2=0.1, 0.2
          resetable:b=yes
        }

        not{

          checkTargetTraceable{
            targetParam:t="coverAttackEnemy"
          }
        }

        subTree{
          treeName:t="sub.popFromCoverAttackCover"
        }

        ifThenElse{

          and{

            checkTooManyEnemiesWatching{
            }

            ignoreChance{
              chance:r=0.5
            }
          }

          sequencer{

            setDebugSym{
              act:t="c15"
            }

            setDebugSym{
              act:t="c16"
            }

            increaseDangerLevel{
              paramName:t="dangerLevel"
              targetParam:t="coverAttackEnemy"
            }

            subTree{
              treeName:t="sub.hideToCoverAttackCover"
            }

            wait{
              range:p2=0.5, 1.0
              resetable:b=yes
            }

            break{
            }
          }

          continue{
          }
        }

        checkTarget{
          targetUnitParam:t="coverAttackEnemy"
        }

        setPosFromEntity{
          to:t="coverLookPos"
          from:t="coverAttackEnemy"
        }

        setIntVar{
          to:t="coverAttack"
          value:i=2
        }

        setIntVar{
          to:t="dangerNearbyBeware"
          value:i=1
        }

        getTime{
          to:t="coverAttackEnemyTime"
        }
      }

      sequencer{

        ignoreCover{
          coverIndexParam:t="coverAttackCover"
          coverSlotParam:t="coverAttackCoverSlot"
          timeIgnore:p2=8.0, 16.0
        }

        decreaseDangerLevel{
          paramName:t="dangerLevel"
          decreaseCoef:r=0.1
        }

        setIntVar{
          to:t="dangerNearbyBeware"
          value:i=1
        }

        setIntVar{
          to:t="coverAttack"
          value:i=0
        }
      }
    }
  }

  sequencer{

    isVarsIntEqual{
      lhs:t="coverAttack"
      rhs_value:i=2
    }

    orderedSelector{

      checkTarget{
        targetUnitParam:t="coverAttackEnemy"
      }

      not{

        sequencer{

          not{

            ignoreChance{
              chance:r=0.1
            }
          }

          ignoreCover{
            coverIndexParam:t="coverAttackCover"
            coverSlotParam:t="coverAttackCoverSlot"
            timeIgnore:p2=8.0, 16.0
          }
        }
      }

      failed{

        sequencer{

          setIntVar{
            to:t="coverAttack"
            value:i=0
          }

          decreaseDangerLevel{
            paramName:t="dangerLevel"
            decreaseCoef:r=0.1
          }
        }
      }
    }

    orderedSelector{

      not{

        orderedSelector{

          checkReloadWeapon{
            checkOnly:b=yes
          }

          not{

            isVarsRealLess{
              lhs:t="dangerLevel"
              rhs_value:r=0.9
            }
          }
        }
      }

      sequencer{

        setDebugSym{
          act:t="c17"
        }

        subTree{
          treeName:t="sub.hideToCoverAttackCover"
        }

        wait{
          range:p2=0.1, 0.2
          resetable:b=yes
        }

        break{
        }
      }
    }

    getTime{
      to:t="coverAttackEnemyTime"
    }

    setIntVar{
      to:t="dangerNearbyBeware"
      value:i=1
    }
  }

  continue{
  }
}

repeatUntilFail{
  name:t="sub.finishBuildTarget"
  count:i=1

  checkTarget{
    targetUnitParam:t="buildTarget"
    ignoreDead:b=no
  }

  findPointNearTarget{
    posParam:t="buildPosition"
    dist:p2=2.0, 2.5
    targetParam:t="buildTarget"
    traceTarget:b=no
    reusePrevPos:b=no
  }

  moveToPos{
    posParam:t="buildPosition"
    sprintTimerRange:p2=10.0, 20.0
    minDistToSprint:r=4.0
    distThreshold:r=0.5
    avoidAiObstacles:b=no
    incLadders:b=yes
    jumpDownTraceCheck:p3=0.4, 1.0, 0.15
  }

  changeStance{
    stanceName:t="crouch"
    maxStanceParam:t="maxStance"
  }

  wait{
    range:p2=1.0, 1.0
    resetable:b=yes
  }

  parallel{

    lookAtTarget{
      targetUnitParam:t="buildTarget"
      rotateBody:b=yes
      allowDead:b=yes
    }

    interactWithBuildingTarget{
      targetUnitParam:t="buildTarget"
    }
  }
}

cycle{
  name:t="sub.cycleCheckAllowedPos"

  orderedSelector{

    sequencer{

      getAgentAIPos{
        outPosParam:t="checkPos"
      }

      checkAllowedPosition{
        posParam:t="checkPos"
      }
    }

    sequencer{

      changeStance{
        stanceName:t="crouch"
      }

      orderedSelector{

        checkAtTime{
          timeParam:t="avoidLeaderSightTime"
          range:p2=0.0, 5.0
        }

        sequencer{

          getTime{
            to:t="avoidLeaderSightTime"
          }

          break{
          }
        }
      }
    }
  }
}

cycle{
  name:t="sub.cycleUpdateAttractionPos"

  orderedSelector{

    isVarsIntEqual{
      lhs:t="potentialPosType"
      rhs_value:i=1
    }

    sequencer{

      periodicTimer{
        timeParam:t="findDangerAttrationPosTimer"
        timePeriod:p2=4.0, 6.0
      }

      findDangerAttractionPos{
        posParam:t="potentialEnemyPos"
        radius:r=0.0
        minNoiseLevel:r=3.0
      }

      fixLookDirPos{
        posParam:t="potentialEnemyPos"
      }
    }

    continue{
    }
  }
}