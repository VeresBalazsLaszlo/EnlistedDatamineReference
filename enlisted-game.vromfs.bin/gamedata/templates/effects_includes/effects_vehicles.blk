tank_exhaust_template{
  _use:t="base_effect"
  _use:t="range_pauseable_effect"
  effect__emit_range_limit:r=140.0
  _tracked:t="effect__velocity"
  _tracked:t="effect__distance_scale"

  _group{
    _tags:t="render"
    effect__name:t="smoke_tank_exhaust_cmps_fx"
    effect__velocity:p3=0.0, 0.0, 0.0
    effect__distance_scale:r=1.0
  }

  _group{
    _track:b=yes
    effect__scale:r=1.0
    effect__spawnRate:r=0.0
    effect__colorMult:c=255, 255, 255, 255
  }
}

