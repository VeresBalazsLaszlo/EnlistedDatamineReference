  "isSimpleTurretCrosshair:b"{
    _tags:t="gameClient"
    value:b=yes
  }

  "last_driver:eid"{
  }

  cockpit_animchar_res_preload{
    _tags:t="gameClient"
  }

  "animchar__objTexReplace:object"{
  }

  "ownedBySquad:eid"{
  }

  "ownedByPlayer:eid"{
  }

  "vehicle_seats__canAcquireControls:shared:object"{

    "driver:object"{
      movement:b=yes
      turrets:b=yes
    }

    "commander:object"{
      movement:b=yes
      turrets:b=yes
      camera:b=yes
    }

    "passenger1:object"{
      movement:b=yes
      camera:b=yes
    }
  }

  "vehicle_seats__seatTemplates:shared:object"{
    default:t="bike_seat_fire_ready"
    driver:t="bike_seat_driver"
    commander:t="bike_seat_commander"
  }

  _group{
    _tags:t="server"

    "dependent_templates:ecs::TemplatesListToInstantiate"{
    }

    "dependent_templates_list_shared:shared:list<t>"{
      template_name:t="bike_seat_fire_ready"
      template_name:t="bike_seat_driver"
      template_name:t="bike_seat_commander"
    }
  }

  _group{
    vehicle_anim__steeringDeflectionLimit:p2=1.0, 0.0
    _tags:t="render"
  }

  _group{
    _tags:t="server"
    friendly_fire__penaltyCooldown:r=5.0
    friendly_fire__damageThreshold:r=5.0

    "friendly_fire__lastPenaltyTime:object"{
    }
  }

  "bike:tag"{
  }

  "dm_parts_repair_names:list<t>"{
    part:t="part:t="
    part:t="drive_turret_h"
    part:t="drive_turret_v"
    part:t="cannon_breech"
    part:t="engine"
