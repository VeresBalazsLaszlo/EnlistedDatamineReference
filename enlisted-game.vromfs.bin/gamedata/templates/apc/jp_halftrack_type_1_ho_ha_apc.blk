jp_halftrack_type_1_ho_ha_apc{
  _use:t="jp_halftrack_type_1_ho_ha_apc_common"
  _use:t="apc_settings"

  "animchar__objTexReplace:object"{
    "jp_camo_olive*":t="jp_camo_early_brown_yellow_lines*"
  }

  "disableDMParts:list<t>"{
    part:t="gunner"
    part:t="loader"
    part:t="commander"
    part:t="machine_gunner"
    part:t="driver"
  }
}

