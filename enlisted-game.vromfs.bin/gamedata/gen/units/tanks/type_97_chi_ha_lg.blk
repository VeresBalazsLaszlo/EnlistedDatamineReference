VehiclePhys{
  skipUpdateOnSleep:b=yes

  Mass{
    Empty:r=21870.0
    Fuel:r=130.0
    TakeOff:r=22000.0
    momentOfInertia:p3=2.5, 2.5, 6.0
    CenterOfGravity:p3=0.2, 0.5, 0.0
    AdvancedMass:b=yes
    trackMass:r=500.0
    CenterOfGravityClampY:p2=0.0, 0.7
    cls_turret:r=0.2
    cls_body:r=0.75
  }

  tracks{
    animationMultiplier:r=-0.5
    height:r=0.07
    width:r=0.25
    tracksTensionK:p3=4.0, 7.0, 1.5
    trackMesh:t="jp_type_97_chi_ha_phys_track_line"
    trackLen:r=0.122
    trackCount:i=96
    trackFadeTime:r=1.1
    trackMaxHeight:r=1.17
    trackStartOffset:r=0.02
  }

  collisionProps{
    cls_turret:t="convex_hull"
    cls_body:t="convex_hull"
  }

  engine{
    horsePowers:r=200.0
    maxRPM:r=2000.0
    minRPM:r=800.0
  }

  mechanics{
    steerType:t="clutch_braking"
    maxBrakeForce:r=60000.0
    driveGearRadius:r=0.287
    mainGearRatio:r=1.45
    sideGearRatio:r=6.315

    gearRatios{
      ratio:r=-2.0
      ratio:r=-3.56
      ratio:r=0.0
      ratio:r=5.22
      ratio:r=2.93
      ratio:r=1.68
      ratio:r=0.96
      ratio:r=0.59
    }
  }

  suspension{
    suspensionOffsets:p3=-0.2, -0.1, 0.06
    defaultGearRadius:r=0.28
    topGearRadius:r=0.13
    frontBackGearRadius:r=0.31
    defaultDampeningForce:p2=30000.0, 30000.0
    dampeningRelaxationRatio:r=0.4
    dampeningCompressionRatio:r=0.15
    recalcWtms:b=yes
  }
}

