  _use:t="base_plane_machinegun"
  _use:t="base_tu_2s_12_7mm_ub_turret"
  _use:t="gunsound_12_7mm_ub_turret_aircraft"
  gun__shootNodeName:t="flare1"
  gun__maxAmmo:i=190
  turret__aimNodeName:t="turret1"
  turret__limit:p4=-42.0, 40.0, 0.0, 40.0
  turret__yawSpeed:r=500.0
  turret__pitchSpeed:r=500.0
  turret__lastRelativeDir:p3=-1.0, 0.0, 0.0

  "turret__limitsDeadzone:list<p4>"{
    lim0:p4=-20.0, -14.0, -20.0, 7.0
    lim1:p4=14.0, 20.0, -20.0, 7.0
  }
}

