  footprints__max_count:i=512
  footprints__remove_threshold:i=384
  footprints__max_view_distance_squared:r=900.0
  footprints__depth:r=0.4
  footprints__group_dist:r=0.01
  footprints__trail_fading_speed:r=0.05
  footprints__lifetime:r=4.0
  footprints__fade_time_tick:r=0.1
  footprints__to_remove_count:i=0
  footprints__update_offset:i=0
  footprints__update_length:i=0

  "footprints__data:FootprintsData"{
  }

  "footprints__buf:UniqueBufWithShaderVar"{
  }

  "footprints__physmat_to_type_map:list<i>"{
  }

  "footprints__diffuse_tex:SharedTexWithShaderVar"{
  }

  "footprints__normal_tex:SharedTexWithShaderVar"{
  }
}

footprints{
  _singleton:b=yes
  _tags:t="render"
}