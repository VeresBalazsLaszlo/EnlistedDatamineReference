VehiclePhys{
  skipUpdateOnSleep:b=yes

  Mass{
    Empty:r=8800.0
    Fuel:r=200.0
    TakeOff:r=9000.0
    momentOfInertia:p3=2.0, 2.0, 4.0
    CenterOfGravity:p3=-0.38, 0.4, 0.0
    CenterOfGravityClampY:p2=0.0, 0.5
    AdvancedMass:b=no
    trackMass:r=40.0
    engineInertialMass:r=400.0
  }

  tracks{
    animationMultiplier:r=0.5
    height:r=0.0
    width:r=0.4
    trackPhysMat:t="wheel"
  }

  collisionProps{
    cls_turret:t="convex_hull"
    cls_body:t="convex_hull"
    cls_body_01:t="convex_hull"
    cls_body_02:t="convex_hull"
    cls_body_03:t="convex_hull"
  }

  engine{
    horsePowers:r=140.0
    maxRPM:r=2600.0
    minRPM:r=900.0
    rpmTau:r=1.9
  }

  mechanics{
    maxBrakeForce:r=30000.0
    driveGearRadius:r=0.5
    mainGearRatio:r=1.1
    sideGearRatio:r=5.5
    tracked:b=no

    gearRatios{
      ratio:r=-12.8
      ratio:r=0.0
      ratio:r=8.0
      ratio:r=6.0
      ratio:r=3.5
      ratio:r=2.2
      ratio:r=1.83
    }
  }

  floats{
    waterCoeff:r=0.5
  }

  suspension{
    suspensionOffsets:p3=-0.15, -0.12, 0.1
    defaultGearRadius:r=0.5
    defaultDampeningForce:p2=30000.0, 30000.0
    hasSuspensionOnDriveGear:b=yes
    dampeningRelaxationRatio:r=0.4
    dampeningCompressionRatio:r=0.15
    brokenWheelSteeringDeflection:r=-15.0
    recalcWtms:b=yes

    steeringNodes{
      wheel_r_01:t="bone_wheel_r_01"
      wheel_l_01:t="bone_wheel_l_01"
    }

    steeringDeflection{
      wheel_l_01:r=20.0
      wheel_r_01:r=20.0
      steeringTau:r=1000000.0
      steeringSpd:r=1.0
      steeringNeutralSpd:r=3.0
    }

    wheelsWidth{
      wheel_l_01:r=0.4
      wheel_l_drive:r=0.4
      wheel_r_01:r=0.4
      wheel_l_02:r=0.4
      wheel_r_02:r=0.4
      wheel_r_drive:r=0.4
    }

    driven{
      wheel_l_02:b=yes
      wheel_r_02:b=yes
      wheel_l_drive:b=yes
      wheel_r_drive:b=yes
    }

    wheelsDamageWeight{
      wheel_l_01:r=0.2
      wheel_r_01:r=0.2
      wheel_l_02:r=0.2
      wheel_r_02:r=0.2
      wheel_l_drive:r=0.2
      wheel_r_drive:r=0.2
    }
  }
}

