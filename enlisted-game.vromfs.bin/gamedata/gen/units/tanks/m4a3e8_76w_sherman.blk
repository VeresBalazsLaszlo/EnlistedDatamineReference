VehiclePhys{
  skipUpdateOnSleep:b=yes

  Mass{
    Empty:r=32600.0
    Fuel:r=300.0
    TakeOff:r=32900.0
    momentOfInertia:p3=2.5, 2.5, 6.0
    CenterOfGravity:p3=0.05, 0.5, 0.0
    CenterOfGravityClampY:p2=0.0, 0.7
    AdvancedMass:b=no
    trackMass:r=1250.0
  }

  tracks{
    animationMultiplier:r=0.62
    height:r=0.055
    width:r=0.5
    fricSideRot:p4=5.0, 0.0, 0.6, 0.3
    fricFrontal:p2=1.0, 0.8
    tracksTensionK:p3=5.0, 10.0, 6.0
    trackMesh:t="us_sherman_hvss_t_84_phys_track_line"
    trackLen:r=0.154
    trackCount:i=79
    trackFadeTime:r=1.1
    trackConnector:b=yes
    trackStartOffset:r=0.03
    trackEmitSparks:b=no
    trackMaxHeight:r=1.01
  }

  collisionProps{
    cls_turret_01:t="convex_hull"
    cls_body_01:t="convex_hull"
  }

  engine{
    horsePowers:r=500.0
    maxRPM:r=2600.0
    minRPM:r=700.0
  }

  mechanics{
    steerType:t="clutch_braking"
    maxBrakeForce:r=130000.0
    driveGearRadius:r=0.3
    mainGearRatio:r=3.74
    sideGearRatio:r=2.56

    gearRatios{
      ratio:r=-5.65
      ratio:r=0.0
      ratio:r=7.56
      ratio:r=3.11
      ratio:r=1.78
      ratio:r=1.11
      ratio:r=0.73
    }
  }

  suspension{
    suspensionOffsets:p3=-0.18, -0.16, 0.11
    defaultGearRadius:r=0.25
    topGearRadius:r=0.13
    frontBackGearRadius:r=0.28
    defaultDampeningForce:p2=120000.0, 120000.0
    dampeningRelaxationRatio:r=0.4
    dampeningCompressionRatio:r=0.15
    recalcWtms:b=yes
  }
}

