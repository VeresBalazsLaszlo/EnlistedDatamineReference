jp_type_3_ho_ni_i_pacific{
  _use:t="jp_type_3_ho_ni_i_common"
}

jp_type_3_ho_ni_i_common{
  _use:t="base_type_3_ho_ni_i"
  _use:t="jp_type_3_ho_ni_i_common_vehicle_sound"
  commanderCockpitFpsCamMaxAngle:p2=40.0, 5.0
  gunner_cam_limit__useCockpitDir:b=yes
  item__iconOffset:p2=-0.3, 0.1
  item__iconScale:r=1.7
  armorThicknessTurret:p3=25.0, 25.0, 0.0

  "attach_decorators__entities:list<eid>"{
  }

  "disableDMParts:list<t>"{
    part:t="gunner"
    part:t="commander"
    part:t="driver"
  }

  "turrets__initAmmoDistribution:array"{

    "ammo:object"{
      slot:i=0
      fill:b=yes
    }

    "ammo:object"{
      slot:i=1
      fill:b=yes
    }

    "ammo:object"{
      slot:i=2
      count:i=7
    }
  }

  "onlyRootDecorAttach:tag"{
  }

  "vehicle_seats__effectors:array"{
  }

  "vehicle_seats__seatsProvideOrder:tag"{
  }

  "vehicle_seats__seats:shared:array"{

    "seats:object"{
      name:t="commander"
      nextSeat:t="main_gunner"
      locName:t="vehicle_seats/commander"
      attachNode:t="commander"
      shouldHideOwner:b=no
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.474163, -0.390638, 0.788897] [0.442963, 0.880173, 0.169595] [-0.760745, 0.269083, 0.590485] [-0.14, 0.03, -0.25]]
      cameraType:t="commander"
      seatComponent:t="isDriver"
      cockpitTemplate:t="jp_type_3_ho_ni_i_commander_cockpit"
      receiveDamageFromDMPart:t="commander"
      seatAnimUpper:t="drive_passenger"
      seatAnimLower:t="drive_passenger"
      isHoldGunModeAllowed:b=no

      "effectors:object"{
        r.foot:t="pedal_rfoot_2"
        l.foot:t="pedal_lfoot_2"
      }

      "loaderTurretNames:array"{
        turret:t="turret_01"
      }
    }

    "seats:object"{
      name:t="main_gunner"
      locName:t="vehicle_seats/gunner"
      attachNode:t="gunner"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.8274, -0.390731, -0.403523] [0.351192, 0.920558, -0.171276] [0.438371, 6.7461e-08, 0.898854] [-0.37, 0.0, 0.0]]
      seatComponent:t="isGunner"
      nextSeat:t="driver"
      shouldHideOwner:b=no
      receiveDamageFromDMPart:t="gunner"
      cameraNodeName:t="bone_camera_gunner"
      cockpitTemplate:t="jp_type_3_ho_ni_i_gunner_cockpit"
      hatchRotationAxis:p3=1.5, 0.0, 0.0
      maxPosWithOpenHatch:r=0.3
      seatAnimUpper:t="drive_passenger"
      seatAnimLower:t="drive_passenger"

      "turretNames:array"{
        turret:t="turret_01"
      }

      "effectors:object"{
        l.hand:t="lefthand_1"
        r.foot:t="pedal_rfoot_1"
        l.foot:t="pedal_lfoot_1"
      }
    }

    "seats:object"{
      name:t="driver"
      locName:t="vehicle_seats/driver"
      seatOwnsEntityControl:b=yes
      attachNode:t="driver"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.974354, -0.224946, -0.0] [0.224946, 0.974354, 0.0] [0.0, -0.0, 0.999988] [-0.33, -0.28, 0.0]]
      seatComponent:t="isDriver"
      shouldHideOwner:b=no
      receiveDamageFromDMPart:t="driver"
      cameraNodeName:t="bone_camera_driver"
      cockpitTemplate:t="jp_type_3_ho_ni_i_driver_cockpit"
      seatAnimUpper:t="drive_passenger"
      seatAnimLower:t="drive_passenger"

      "effectors:object"{
        r.hand:t="righthand_3"
        l.hand:t="lefthand_3"
        r.foot:t="pedal_rfoot_3"
        l.foot:t="pedal_lfoot_3"
      }
    }
  }
}

jp_type_3_ho_ni_i_driver_cockpit{
  _use:t="base_driver_cockpit_no_slits"
  animchar__res:t="pzkpfw_iii_e_driver_char"
  cockpit__offset:p3=-0.2, -0.17, -0.05

  "cockpit__visibleVehicleNodeNames:list<t>"{
    node:t="ex_decor_r_01"
    node:t="track_r"
    node:t="hatch_02"
    node:t="ex_lantern_01"
    node:t="ex_decor_01"
    node:t="wheel_r_drive"
    node:t="ex_decor_l_01"
    node:t="gun_barrel"
  }

  "cockpit__slitForwardOffset:list<r>"{
    slit:r=-0.0
  }

  "cockpit__slitIsGun:list<b>"{
    slit:b=no
  }

  "cockpit__slitNodeNames:list<t>"{
    slit:t="cam_front"
  }
}

jp_type_3_ho_ni_i_gunner_cockpit{
  _use:t="base_gunner_cockpit"
  animchar__res:t="t_26_1940_gunner_char"
  cockpit__offset:p3=-0.0, -0.0, -0.0
  cockpit__minForwardOffset:r=-0.05

  "cockpit__cockpitOffsetBySlit:list<p3>"{
    slit:p3=-0.55, -0.05, 0.2
    slit:p3=-0.5, 0.55, 0.3
  }

  "cockpit__attachNodeNames:list<t>"{
    node:t="bone_camera_gunner"
    node:t="bone_turret"
  }

  "cockpit__attachNodeIndices:list<i>"{
  }

  "cockpit__visibleVehicleNodeNames:list<t>"{
    node:t="gun_barrel"
    node:t="root"
  }

  "cockpit__slitNodeNames:list<t>"{
    slit:t="cam_front_right"
    slit:t="cam_front"
  }

  "cockpit__slitForwardOffset:list<r>"{
    slit:r=0.22
    slit:r=0.2
  }

  "cockpit__slitIsGun:list<b>"{
    slit:b=yes
    slit:b=no
  }

  "cockpit__periscopeLimits:list<p4>"{
    slit:p4=-0.0, 0.0, 0.0, 0.0
    slit:p4=-90.0, 90.0, -0.0, 25.0
  }

  "cockpit__periscopeSpeed:list<p2>"{
    slit:p2=-1.0, -1.0
    slit:p2=35.0, 35.0
  }

  "cockpit__slitZoom:array"{

    "slit:list<r>"{
      zoom:r=1.9
      zoom:r=3.5
    }

    "slit:list<r>"{
      zoom:r=1.44
    }
  }

  "cockpit__slitZoomTime:list<r>"{
    slit:r=0.05
    slit:r=0.0
  }

  "cockpit__slitTemplates:list<t>"{
    slit:t="jp_120mm"
    slit:t="default_periscope"
  }

  "cockpit__slitEids:list<eid>"{
  }
}

jp_type_3_ho_ni_i_commander_cockpit{
  _use:t="base_commander_cockpit_no_slits"
  animchar__res:t="pzkpfw_iii_e_driver_char"
  cockpit__offset:p3=0.7, 1.95, -0.45

  "cockpit__cockpitOffsetBySlit:list<p3>"{
    item:p3=0.0, 0.0, 0.0
  }

  "cockpit__visibleVehicleNodeNames:list<t>"{
    node:t="gun_barrel"
    node:t="bone_gun"
  }

  "cockpit__slitNodeNames:list<t>"{
    slit:t="cam_front"
  }

  "cockpit__slitForwardOffset:list<r>"{
    slit:r=-0.04
  }

  "cockpit__slitIsGun:list<b>"{
    slit:b=yes
  }

  "cockpit__attachNodeNames:list<t>"{
    node:t="root"
  }

  "cockpit__attachNodeIndices:list<i>"{
  }

  "cockpit__slitZoom:array"{

    "slit:list<r>"{
      zoom:r=1.44
    }
  }
}