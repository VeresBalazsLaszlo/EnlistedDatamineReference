entity{
  _template:t="screen_mud_settings"
  enabled:b=no
  screen_mud__baseSplashSize:r=0.8
  screen_mud__minSplashSize:r=0.4
  screen_mud_albedo_value:p4=0.088, 0.056, 0.024, 0.0
  screen_mud_albedo2_value:p4=0.08, 0.04, 0.008, 0.0
  screen_mud_translucency_value:p4=0.045, 0.025, 0.008, 0.0
  screen_mud_tc_mul_value:r=1.75
  screen_mud_cutoff_threshold_value:r=0.6
  screen_mud_tc_mul2_value:r=5.0
  screen_mud_cutoff_threshold2_value:r=0.6
}

