  "motion_matching__weaponEnumVars:list<i>"{
  }

  "motion_matching__weaponTags:list<i>"{
  }
}

enl_soldier_mm_component{
  _use:t="motion_matching_animchar_component"
  _tags:t="render"
  motion_matching__blendTimeToAnimtree:r=0.3
  motion_matching__dataBaseTemplateName:t="enl_soldier_mm_database"
  mm_trajectory__wishLinearVelocity:p3=0.0, 0.0, 0.0
  mm_trajectory__wishRotation:p4=0.0, 0.0, 0.0, 1.0
  motion_matching__prevLowerAnimState:i=-1
  motion_matching__prevStandState:i=-1
  motion_matching__weaponTagIdx:i=-1
  motion_matching__turnOnSpotTimer:r=0.0

  "mm_trajectory__customUpdate:tag"{
  }
}

enl_female_soldier_mm_database{
  _use:t="enl_soldier_mm_database"
  _singleton:b=yes
  _tags:t="render"

  "data_bases_paths:list<t>"{
    path:t="gamedata/motion_matching/soldier_sprint_anim_list.blk"
    path:t="gamedata/motion_matching/soldier_run_anim_list.blk"
    path:t="gamedata/motion_matching/soldier_walk_anim_list.blk"
    path:t="gamedata/motion_matching/soldier_stand_anim_list.blk"
    path:t="gamedata/motion_matching/soldier_run_transitions_anim_list.blk"
    path:t="gamedata/motion_matching/soldier_crouch_anim_list.blk"
  }
}

empty_mm_database{
  _singleton:b=yes
}

enl_test_soldier_behaviour_with_mm{
  _use:t="dev_soldier"
  _use:t="motion_matching_test_behaviour"
}

enl_test_soldier_behaviour_without_mm{
  _use:t="enl_test_soldier_behaviour_with_mm"
  _tags:t="render"
  motion_matching__dataBaseTemplateName:t="empty_mm_database"
}