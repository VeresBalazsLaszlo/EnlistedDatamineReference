  _replicated:t="team__goalShowTime"
  _replicated:t="team__forceEnableBriefing"
  _replicated:t="team__freeTankTemplate"
  _replicated:t="team__freeTankSpawnsActive"
  _replicated:t="team__aircraftRequestAvailableAtTime"
  _replicated:t="team__aircraftRequestFromBoxAvailableAtTime"
