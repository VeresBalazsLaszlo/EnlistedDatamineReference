base_zeppelin_class_r{
  plane_phys_damage__blk:t="gamedata/units/zeppelin_class_r.blk"
  animchar__res:t="zeppelin_class_r_char"
}

zeppelin_class_r_wreckage{
  _use:t="base_zeppelin_class_r"
  _use:t="plane_wreckage"
  plane_wreckage__nodeName:t=""
  plane_wreckage__typeName:t=""
}

zeppelin_class_r_base{
  _use:t="plane_with_cockpit"
  _use:t="base_zeppelin_class_r"
  collres__res:t="zeppelin_class_r_collision"
  plane_net_phys__blk:t="gamedata/units/zeppelin_class_r.blk"
  damage_model__blk:t="gamedata/units/zeppelin_class_r.blk"
  plane_collision__blk:t="gamedata/units/zeppelin_class_r.blk"
  plane_anim__blk:t="gamedata/units/zeppelin_class_r.blk"
  plane_sight__blk:t="gamedata/units/zeppelin_class_r.blk"
  plane_input__autopilotImpl:t="Full"
  canUseRespawnbaseType:t="aircraft_assault"
  is_seaplane:b=no
  plane_wreckage__template:t="zeppelin_class_r_wreckage"
  killLogName:t="zeppelin"
  animchar__res:t="zeppelin_class_r_char"
  vehicle_seats_camera_nodes__defaultNode:t=""

  _group{
    _tags:t="render"
    animchar_camera_target__node_name:t=""
    animchar_camera_target__node_offset:p3=0.0, 0.0, 0.0
  }

  "vehicle_seats_can_acquire_controls:list<i>"{
  }

  "vehicle_seats__canAcquireControls:shared:object"{

    "driver:object"{
      movement:b=yes
      turrets:b=yes
    }

    "main_gunner:object"{
      turrets:b=yes
    }
  }

  "grid_obj__bigObject:tag"{
  }
}