domination_box_capzone_without_navmesh{
  _use:t="capzone_box_without_navmesh"
  _use:t="domination_capzone_narrator"
  capzone__autoDecap:b=no
  capzone__autoCap:b=no

  "capzone__capTime:r"{
    value:r=25.0
    _info:t="capzone__capTime"
  }

