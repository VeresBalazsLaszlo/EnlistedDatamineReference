orderedSelector{
  name:t="sub.personalOrderPointMove"

  reaction{
    event:t="onHit"

    sequencer{

      isReadyForAction{
        checkFence:b=yes
      }

      checkedChargeAttackReaction{
        from:t="onHit"
        moving:b=yes
      }

      recalculateTree{
      }
    }
  }

  reaction{
    event:t="onBulletNearby"

    sequencer{

      isReadyForAction{
        checkFence:b=yes
      }

      periodicTimer{
        timeParam:t="onBulletNearbyTimer"
        timePeriod:p2=2.0, 4.0
      }

      checkedChargeAttackReaction{
        from:t="onBulletNearby"
        moving:b=yes
      }

      recalculateTree{
      }
    }
  }

  reaction{
    event:t="onEnemyPlayerNear"

    sequencer{

      isReadyForAction{
        checkFence:b=yes
      }

      findDanger{
        paramName:t="shootEnemy"
        outSeeTimeParam:t="shootEnemyTime"
        radiusParamName:t="enemyDefendRadius"
        minDanger:r=0.1
        tag:t="human"
      }

      recalculateTree{
      }
    }
  }

  reaction{
    event:t="regularCheck"

    repeat{
      count:i=1

      subTree{
        name:t=""
        treeName:t="sub.chooseMaxStance"
      }

      subTree{
        name:t=""
        treeName:t="sub.deactivateWeapMod"
      }

      subTree{
        name:t=""
        treeName:t="sub.checkDowned"
      }

      subTree{
        name:t=""
        treeName:t="sub.checkBurning"
      }

      subTree{
        name:t=""
        treeName:t="sub.swimUpCheck"
      }

      subTree{
        name:t=""
        treeName:t="sub.tryToOpenDoors"
      }

      subTree{
        name:t=""
        treeName:t="sub.findDangerGrenade"
      }

      subTree{
        name:t=""
        treeName:t="sub.findDangerZone"
      }
    }
  }

  subTree{
    name:t=""
    treeName:t="sub.defendPointMoveToPosition"
  }
}

