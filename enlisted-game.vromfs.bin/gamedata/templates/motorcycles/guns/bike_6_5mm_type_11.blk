bike_6_5mm_type_11{
  _use:t="tankgun"
  _use:t="base_tankgun_machinegun"
  _use:t="base_7_7mm_type_97"
  _use:t="gun_switch_firing_mode_sound"
  _use:t="mgun_gun_aim_sound"
  _use:t="machinegun_gun_overheat_sound"
  _use:t="machinegun_gun_reload_sounds"
  turret__triggerGroup:i=0
  item__name:t="items/type_11_lmg"
  gun__blk:t="gamedata/weapons/type_11_lmg.blk"
  gun__locName:t="type_11_lmg"
  gun__shotFreq:r=8.33
  gun__maxAmmo:i=30
  gun__reloadTime:r=3.8
  gun__altReloadTime:r=2.5
  gun_shell_ejection__timeMult:r=0.35
  gun__length:r=0.4
  gun__recoilAmount:r=0.051
  gun__recoilDirAmount:r=0.67
  gun__recoilDir:r=0.0
  gun__visualRecoilMult:r=0.4
  gun__recoilControlMult:r=0.9
  gun__recoilOffsMult:r=0.1
  gun__isOverheat:b=no
  gun__overheat:r=0.0
  gun__overheatPerShot:r=0.0
  gun_spread__maxDeltaAngle:r=0.3

  "gun__ammoSetsInfo:shared:array"{

    "defaultSet:array"{

      "shell:object"{
        blk:t="gamedata/templates/motorcycles/guns/7_92x57_mauser_bike.blk"
        type:t="ap_i_ball"
      }
    }
  }

  _group{
    _tags:t="sound"
    gun_sound__forceOneshot:b=yes
  }

  "gun_sound__shotPath:shared:object"{
    _tags:t="sound"
    path:t="/weapon/mgun/nambu_type_96_lmg"
  }

  "sound_irqs:shared:object"{
    _tags:t="sound"

    "reload1:object"{
      path:t="/weapon/mgun/mg_34/reload1/change_ammo"
    }

    "reload2:object"{
      path:t="/weapon/mgun/mg_34/reload2/change_ammo"
    }

    "reload3:object"{
      path:t="/weapon/mgun/mg_34/reload3/change_ammo"
    }

    "reload4:object"{
      path:t="/weapon/mgun/mg_34/reload4/change_ammo"
    }

    "reload5:object"{
      path:t="/weapon/mgun/mg_34/reload5/change_ammo"
    }

    "reload6:object"{
      path:t="/weapon/mgun/mg_34/reload6/change_ammo"
    }

    "reload7:object"{
      path:t="/weapon/mgun/mg_34/reload7/change_ammo"
    }

    "boltAction:object"{
      path:t="/weapon/rifle/mauser98k/bolt_action"
    }
  }
}