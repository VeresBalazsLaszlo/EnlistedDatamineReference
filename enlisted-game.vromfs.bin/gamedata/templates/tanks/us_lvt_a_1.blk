        "r.hand:object"{
          rel_tm:m=[[0.486851, 0.856246, 0.172679] [-0.861759, 0.503121, -0.0651322] [-0.142648, -0.117098, 0.982823] [-0.423952, -0.072876, -0.039114]]
          node:t="gun_barrel_02"
