    "seats:object"{
      name:t="extra_gunner"
      locName:t="vehicle_seats/additional_gunner"
      attachNode:t="machine_gunner_02"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[-0.869336, 0.232938, 1.58213e-06] [0.233022, 0.869652, -4.12096e-07] [-1.63484e-06, 1.15748e-08, -0.900003] [0.04, 0.06, -0.06]]
