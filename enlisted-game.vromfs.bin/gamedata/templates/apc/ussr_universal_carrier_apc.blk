ussr_universal_carrier_dt_apc{
  _use:t="ussr_universal_carrier_dt_apc_common"
  _use:t="apc_settings"
  mobile_respawn__seatOffset:i=4

  "animchar__objTexReplace:object"{
    "uk_camo_very_dark_drab*":t="ussr_camo_green*"
  }
}

ussr_universal_carrier_dt_apc_common{
  _use:t="base_universal_carrier_dt"
  _use:t="forestall"
  _use:t="halftrack_seats"
  _use:t="uk_universal_carrier_apc_common_vehicle_sound"
  _use:t="vehicle_anim_steering_deflection"
  item__iconOffset:p2=0.1, 0.35
  item__iconScale:r=1.7
  cockpit__zoomOutFov:r=1.5
  cockpit__zoomInFov:r=2.0
  commanderCockpitFpsCamMaxAngle:p2=40.0, 5.0
  gunner_cam_limit__useCockpitDir:b=yes
  vehicle_commander_cam__attachToVehicle:b=yes

  "disableDMParts:list<t>"{
    part:t="gunner"
    part:t="loader"
    part:t="commander"
    part:t="machine_gunner"
    part:t="driver"
    part:t="ex_armor_r_07"
    part:t="ex_armor_l_07"
    part:t="ammo_body_07"
    part:t="ammo_body_06"
    part:t="ammo_body_08"
    part:t="ammo_body_09"
    part:t="ex_armor_l_06"
    part:t="ammo_body_04"
    part:t="ammo_body_05"
    part:t="shell"
    part:t="shell_01"
  }

  _group{
    _tags:t="server"

    "turret_control__hasTankAiGunners:tag"{
    }
  }

  _group{
    _tags:t="render"
    animchar_camera_target__node_name:t="bone_mg_h"
    animchar_camera_target__node_offset:p3=0.0, 1.0, 0.0
    animchar_camera_target__nodeIndex:i=-1
  }

  "vehicle_seats__effectors:array"{
  }

  "vehicle__isExplosionFatal:b"{
    _tags:t="server"
    value:b=yes
  }

  "vehicle_seats__seatsProvideOrder:tag"{
  }

