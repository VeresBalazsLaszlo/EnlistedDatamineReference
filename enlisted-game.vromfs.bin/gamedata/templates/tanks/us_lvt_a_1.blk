      "effectors:object"{

        "l.hand:object"{
          rel_tm:m=[[0.44389, -0.890154, 0.1029] [-0.231342, -0.00290065, 0.97287] [-0.865703, -0.455651, -0.207217] [-0.326141, 0.0474319, -0.0872154]]
          node:t="gun_barrel_02"
