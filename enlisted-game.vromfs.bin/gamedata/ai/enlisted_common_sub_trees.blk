  }

  setDebugSym{
    act:t="s10"
  }

  setDebugSym{
    act:t="s11"
  }

  orderedSelector{

    sequencer{

      findDanger{
        paramName:t="testEnemy"
        radiusParamName:t="enemyRadius"
        minDanger:r=-1.0
        tag:t="human"
      }

      selectStanceInCover{
        minStanceParam:t="minStance"
        maxStanceParam:t="maxStance"
        stanceParam:t="coverStance"
        safe:b=yes
      }

      changeStance{
        stanceName:t="stand"
        maxStanceParam:t="coverStance"
      }
    }

    sequencer{

      chooseRandomStance{
        stanceParam:t="standStance"
        minStance:i=1
        maxStance:i=2
      }

      changeStance{
        stanceName:t="stand"
        maxStanceParam:t="standStance"
      }
    }
  }

  orderedSelector{

    sequencer{

      findPotentialEnemyPos{
        posParam:t="potentialEnemyPos"
        minNoiseLevel:r=3.0
      }

      setIntVar{
        to:t="potentialPosType"
        value:i=1
      }
    }

    sequencer{

      periodicTimer{
        timeParam:t="findDangerAttrationPosTimer"
        timePeriod:p2=4.0, 6.0
      }

      findDangerAttractionPos{
        posParam:t="potentialEnemyPos"
        radius:r=0.0
        minNoiseLevel:r=3.0
      }
    }

    continue{
    }
  }

  orderedSelector{

    not{

      passedTimeSinceControlledByPlayer{
        time:r=30.0
      }
    }

    checkReloadWeapon{
      waitReloadFinish:b=no
      enoughAmmoRatio:r=0.9
      skipEnemyNearRadius:r=10.0
    }
  }

  orderedSelector{

    sequencer{

      ignoreChance{
        chance:r=0.1
      }

      checkAtTime{
        timeParam:t="rememberEnemyTime"
        range:p2=0.0, 25.0
      }

      not{

        checkDistance{
          posParam:t="rememberEnemyPos"
          radius:r=7.0
          yRadius:r=5.0
        }
      }

      checkTarget{
        targetUnitParam:t="rememberEnemy"
      }

      copyPoint3Var{
        to:t="potentialEnemyPos"
        from:t="rememberEnemyPos"
      }

      fixLookDirPos{
        posParam:t="potentialEnemyPos"
      }

      setDebugSym{
        act:t="s12"
      }

      parallel{

        wait{
          range:p2=5.0, 10.0
          resetable:b=yes
        }

        wanderLook{
          posParam:t="potentialEnemyPos"
          range:p2=0.2, 0.1
          maxStanceParam:t="coverStance"
        }

        subTree{
          treeName:t="sub.cycleCheckAllowedPos"
        }
      }
    }

    sequencer{

      findPotentialEnemyDirectionEntryPoint{
        posParam:t="potentialEnemyPos"
      }

      fixLookDirPos{
        posParam:t="potentialEnemyPos"
      }

      setDebugSym{
        act:t="s15"
      }

      parallel{

        wait{
          range:p2=5.0, 15.0
          resetable:b=yes
        }

        wanderLook{
          posParam:t="potentialEnemyPos"
          range:p2=0.2, 0.1
          maxStanceParam:t="coverStance"
        }

        subTree{
          treeName:t="sub.cycleCheckAllowedPos"
        }

        subTree{
          treeName:t="sub.cycleUpdateAttractionPos"
        }
      }
    }
  }

  setIntVar{
    to:t="potentialPosType"
    value:i=0
  }
}

