      cameraNodeName:t="root"
      directTurretControl:b=yes
      canPlaceManually:b=yes
      seatAnimUpper:t="drive_driver"
      seatAnimLower:t="drive_driver"

      "turretNames:array"{
        turret:t="turret_03"
