muzzle_ground_60mm{
  _use:t="turret_gun_flash_effect_base"
  _use:t="hit_env_affect_fx"
  wind_emitter__radius:r=3.0
  wind_emitter__duration:r=3.0
  wind_emitter__strength:r=3.0
  wind_emitter__phaseSin:b=yes
  wind_emitter__numWaves:i=5
  wind_emitter__phaseAttack:b=yes

  "wind_emitter__omni:tag"{
  }

  _group{
    _tags:t="render"
    effect__name:t="fire_muzzle_60_100mm_cmps_fx"
    effect__distance_scale:r=1.0
    effect__environmentDestructionRadius:r=4.0
  }
}

