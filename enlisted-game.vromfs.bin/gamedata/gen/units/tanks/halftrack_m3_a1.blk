PhysSys{

  group{
    find:t="^bone_suspension_(\w)_(\d+)_02"

    points{

      lever{
        limitMin:p3=0.0, 0.0, 0.0
        limitMax:p3=0.0, 0.0, 0.0
        name:t="bone_suspension_$1_02"
      }

      suspension_02_01{
        limitMin:p3=-0.5, -0.5, 0.0
        limitMax:p3=0.5, 0.5, 0.0
        name:t="bone_suspension_$1_$2_01"
      }

      suspension_02_02{
        limitMin:p3=-0.5, -0.5, 0.0
        limitMax:p3=0.5, 0.5, 0.0
        name:t="bone_suspension_$1_$2_02"
      }

      suspension_02_03{
        limitMin:p3=-0.5, -0.5, 0.0
        limitMax:p3=0.5, 0.5, 0.0
        name:t="bone_suspension_$1_$2_03"
      }

      suspension_02_04{
        limitMin:p3=-0.5, -0.5, 0.0
        limitMax:p3=0.5, 0.5, 0.0
        name:t="bone_suspension_$1_$2_04"
      }

      wheel_01{

        searchChildren{
          occurence:i=1
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          parent:t="suspension_02_02"
          find:t="bone_wheel_"
        }
      }

      wheel_02{

        searchChildren{
          occurence:i=2
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          parent:t="suspension_02_02"
          find:t="bone_wheel_"
        }
      }

      wheel_03{

        searchChildren{
          occurence:i=1
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          parent:t="suspension_02_04"
          find:t="bone_wheel_"
