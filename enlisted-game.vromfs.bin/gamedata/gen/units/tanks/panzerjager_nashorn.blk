VehiclePhys{
  skipUpdateOnSleep:b=yes

  Mass{
    Empty:r=24000.0
    Fuel:r=300.0
    TakeOff:r=23500.0
    momentOfInertia:p3=2.5, 2.5, 6.0
    CenterOfGravity:p3=0.4, 0.4, 0.0
    CenterOfGravityClampY:p2=0.0, 0.7
    AdvancedMass:b=yes
    trackMass:r=940.0
  }

  tracks{
    animationMultiplier:r=0.5
    tracksTensionK:p3=3.0, 8.0, 1.5
    trackMesh:t="ger_kgs61_400_120_phys_track_line"
    trackLen:r=0.12
    trackCount:i=100
    trackFadeTime:r=0.5
    trackCntPeriod:i=2
    trackMaxSinking:r=0.17
    trackMaxHeight:r=1.17
    trackStartOffset:r=0.19
    height:r=0.06
    width:r=0.4
  }

  collisionProps{
    cls_body:t="convex_hull"
    cls_body_01:t="convex_hull"
    cls_body_02:t="convex_hull"
    cls_body_03:t="convex_hull"
  }

  engine{
    horsePowers:r=300.0
    maxRPM:r=3000.0
    minRPM:r=600.0
  }

  mechanics{
    steerType:t="clutch_braking"
    maxBrakeForce:r=80000.0
    driveGearRadius:r=0.35
    mainGearRatio:r=1.2
    sideGearRatio:r=8.246

    gearRatios{
      ratio:r=-5.35
      ratio:r=0.0
      ratio:r=9.5
      ratio:r=6.0
      ratio:r=3.5
      ratio:r=2.5
      ratio:r=1.5
      ratio:r=1.0
    }
  }

  suspension{
    suspensionOffsets:p3=-0.1, -0.05, 0.05
    defaultGearRadius:r=0.23
    topGearRadius:r=0.125
    frontBackGearRadius:r=0.324
    defaultDampeningForce:p2=100000.0, 100000.0
    dampeningRelaxationRatio:r=0.4
    dampeningCompressionRatio:r=0.15
    wheel_r_drive:r=0.375
    wheel_l_drive:r=0.375
    wheel_r_back:r=0.32
    wheel_l_back:r=0.32
    recalcWtms:b=yes
  }
}

