VehiclePhys{
  skipUpdateOnSleep:b=yes

  Mass{
    Empty:r=2850.0
    Fuel:r=100.0
    TakeOff:r=2950.0
    momentOfInertia:p3=2.0, 2.0, 5.0
    CenterOfGravity:p3=-0.1, 0.4, 0.0
    CenterOfGravityClampY:p2=0.0, 0.7
    AdvancedMass:b=yes
    trackMass:r=40.0
    engineInertialMass:r=400.0
  }

  tracks{
    animationMultiplier:r=0.5
    height:r=0.0
    width:r=0.15
    trackPhysMat:t="wheel"
  }

  collisionProps{
    cls_body_01:t="convex_hull"
    cls_body_02:t="convex_hull"
  }

  engine{
    horsePowers:r=57.0
    maxRPM:r=2200.0
    minRPM:r=900.0
    rpmTau:r=1.9
  }

  mechanics{
    maxBrakeForce:r=9000.0
    driveGearRadius:r=0.375
    mainGearRatio:r=6.6
    sideGearRatio:r=1.05
    tracked:b=no

    gearRatios{
      ratio:r=-7.82
      ratio:r=0.0
      ratio:r=6.4
      ratio:r=3.09
      ratio:r=1.69
      ratio:r=1.0
    }
  }

  floats{
    waterCoeff:r=0.5
  }

  suspension{
    maxDisplacementOffsets:p2=-0.04, 0.05
    suspensionOffsets:p3=-0.23, -0.09, 0.15
    defaultGearRadius:r=0.375
    defaultDampeningForce:p2=9000.0, 9000.0
    hasSuspensionOnDriveGear:b=yes
    dampeningRelaxationRatio:r=0.2
    dampeningCompressionRatio:r=0.3
    brokenWheelSteeringDeflection:r=-15.0
    recalcWtms:b=yes

    steeringNodes{
      wheel_r_01:t="bone_wheel_r_01"
      wheel_l_01:t="bone_wheel_l_01"
    }

    steeringDeflection{
      wheel_l_01:r=35.0
      wheel_r_01:r=35.0
      steeringTau:r=1000000.0
      steeringSpd:r=1.0
      steeringNeutralSpd:r=3.0
    }

    wheelsWidth{
      wheel_l_drive_01:r=0.35
      wheel_l_drive:r=0.35
      wheel_r_drive_01:r=0.35
      wheel_r_drive:r=0.35
    }

    driven{
      wheel_l_drive:b=yes
      wheel_r_drive:b=yes
      wheel_l_drive_01:b=yes
      wheel_r_drive_01:b=yes
    }

    wheelsDamageWeight{
      wheel_l_01:r=0.45
      wheel_r_01:r=0.45
      wheel_l_drive_01:r=0.8
      wheel_r_drive_01:r=0.8
      wheel_l_drive:r=0.8
      wheel_r_drive:r=0.8
    }
  }
}

