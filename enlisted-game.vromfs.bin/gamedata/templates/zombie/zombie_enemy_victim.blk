zombie_normal_emissive_dim{
  _use:t="dynmat_params_base"

  "dynamic_material_channels_arr:array"{
    _tags:t="render"

    "dynamic_material_channel:object"{
      dynamic_material_type:t="emissive"
      dynmat_param__emissive_color:p4=1.0, 0.25, 0.15, 1.0
      dynmat_param__emission_albedo_mult:r=0.9
    }
  }
}

zombie_stuck_control{
  zombie_stuck_control__minPositionChange:r=4.0
  zombie_stuck_control__minPositionChangeTime:r=30.0
  zombie_stuck_control__lastPositionSaveTime:r=-1.0
  zombie_stuck_control__lastPosition:p3=0.0, 0.0, 0.0
}

zombie_rush_zombie_dead_victim{
  _use:t="zombie_rush_zombie_dead"
  paid_loot__pointsForKill:i=0
  paid_loot__pointsPerDamage:r=0.0
  paid_loot__soulsForKill:i=10
  paid_loot__soulsPerDamage:r=0.0
  dontShowKillAward:b=yes

  "noHitMark:tag"{
  }
}

dead_enlisted_zombie_soldier_victim{
  _use:t="dead_enlisted_zombie_soldier"
  paid_loot__pointsForKill:i=0
  paid_loot__pointsPerDamage:r=0.0
  paid_loot__soulsForKill:i=10
  paid_loot__soulsPerDamage:r=0.0
  dontShowKillAward:b=yes

  "noHitMark:tag"{
  }
}

zombie_walk_zombie_victim{
  _use:t="zombie_rush_zombie"
  _use:t="zombie_normal_emissive_dim"
  _use:t="zombie_stuck_control"
  entity__recreateToOnDeath:t="zombie_rush_zombie_dead_victim"
  navmesh_phys__maxWalkSpeed:r=3.2
  path_corridor_ai__slowDownCoef:r=0.3
  hitpoints__hp:r=20.0
  hitpoints__maxHp:r=20.0
  hitpoints__scaleHp:r=20.0
  hitpoints__hpThreshold:r=20.0
  hitpoints__hpRecoverySpd:r=0.0
  paid_loot__pointsForKill:i=0
  dontShowKillAward:b=yes
  paid_loot__pointsPerDamage:r=0.0
  paid_loot__soulsForKill:i=10
  paid_loot__soulsPerDamage:r=0.0

  "paid_loot__extraPointsForHeadshot:tag"{
  }

  "actions__actions:array"{

    "action:object"{
      name:t="stand_melee"
      state:t="attack"
      actionTime:r=0.5
      applyAt:r=0.6
      props:t="gamedata/actions_enlisted/zombie_claw.blk"
      irq:t="claw_attack"
      varName:t="attack_progress"
    }
  }
}

zombie_rush_zombie_victim{
  _use:t="zombie_walk_zombie_victim"
  navmesh_phys__maxWalkSpeed:r=3.8
}

