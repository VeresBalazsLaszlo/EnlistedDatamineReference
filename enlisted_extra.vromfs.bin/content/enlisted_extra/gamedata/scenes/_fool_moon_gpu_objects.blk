entity{
  _template:t="dagdp_level_settings"
  dagdp__max_objects:i=10000
}

entity{
  _template:t="dagdp_object_group_riex"
  dagdp__name:t="stone_small_a"

  "dagdp__params:object"{
    scale:p2=0.75, 0.25
    orientation:t="normal"
  }

  "dagdp__assets:object"{

    "generic_stone_small_a:object"{
      weight:r=1.0
    }

    "generic_stone_small_b:object"{
      weight:r=1.0
    }

    "generic_stone_small_c:object"{
      weight:r=1.0
    }

    "generic_stone_small_d:object"{
      weight:r=1.0
    }

    "generic_stone_small_e:object"{
      weight:r=1.0
    }

    "generic_stone_small_f:object"{
      weight:r=1.0
    }
  }
}

entity{
  _template:t="dagdp_placer_heightmap"
  dagdp__name:t="stone_small_a_biomes"
  dagdp__density:r=0.01

  "dagdp__object_groups:list<t>"{
    item:t="stone_small_a"
  }

  "dagdp__biomes:list<i>"{
    item:i=0
    item:i=1
    item:i=2
    item:i=3
  }
}

