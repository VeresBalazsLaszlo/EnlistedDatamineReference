    }

    "slit:list<r>"{
      zoom:r=1.44
    }
  }

  "cockpit__slitTemplates:list<t>"{
    slit:t="it_se_75_18"
    slit:t="default_periscope"
  }

  "cockpit__slitEids:list<eid>"{
