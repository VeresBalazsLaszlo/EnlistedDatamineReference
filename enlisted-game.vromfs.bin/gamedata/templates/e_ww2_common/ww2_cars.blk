    part:t="wheel_r_back"
    part:t="wheel_r_front"
    part:t="wheel_r_drive"
    part:t="wheel_r_01"
    part:t="wheel_r_02"
    part:t="wheel_r_03"
    part:t="wheel_r_04"
    part:t="wheel_r_05"
    part:t="wheel_r_06"
    part:t="wheel_r_07"
    part:t="wheel_r_08"
