zombie_postfx_ovveride{
  zombie_damage_indicator__blockDuration:r=0.1
  zombie_damage_indicator__thresholds:p3=1.0, 1.0, 0.0
  zombie_damage_indicator__lightPulsationFreq:p4=0.1, 0.0, 0.0, 0.0
  zombie_damage_indicator__lightIntensities:p4=3.0, 0.0, 0.0, 0.0
  zombie_damage_indicator__mediumPulsationFreq:p4=0.1, 0.0, 0.0, 0.0
  zombie_damage_indicator__mediumIntensities:p4=3.0, 0.0, 0.0, 0.0
  zombie_damage_indicator__severePulsationFreq:p4=0.1, 0.0, 0.0, 0.0
  zombie_damage_indicator__severeIntensities:p4=3.0, 0.0, 0.0, 0.0
}