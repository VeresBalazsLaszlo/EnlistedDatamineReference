repeat{
  name:t="sub.orderReq"

  setDebugSym{
    beh:t="X0"
  }

  subTree{
    name:t=""
    treeName:t="sub.chooseMaxStance"
  }

  subTree{
    name:t=""
    treeName:t="sub.deactivateWeapMod"
  }

  subTree{
    name:t=""
    treeName:t="sub.swimUp"
  }

  subTree{
    name:t=""
    treeName:t="sub.selfExtinguish"
  }

  subTree{
    name:t=""
    treeName:t="sub.selfHealing"
  }

  subTree{
    name:t=""
    treeName:t="sub.dmgZoneEscape"
  }

  subTree{
    name:t=""
    treeName:t="sub.rethrowGrenade"
  }

  subTree{
    name:t=""
    treeName:t="sub.grenadeEscape"
  }

  subTree{
    name:t=""
    treeName:t="sub.bombEscape"
  }

  setIntVar{
    to:t="coverAttack"
    value:i=0
  }

  orderedSelector{

    orderedSelector{

      sequencer{

        subTree{
          name:t=""
          treeName:t="sub.enemyMelee"
        }

        setIntVar{
          to:t="mortarAttack"
          value:i=-1
        }
      }

      sequencer{

        findDanger{
          paramName:t="shootEnemy"
          outSeeTimeParam:t="shootEnemyTime"
          radiusParamName:t="enemyNearRadius"
          minDanger:r=0.1
          tag:t="human"
        }

        getTime{
          to:t="enemyNearTime"
        }

        setIntVar{
          to:t="mortarAttack"
          value:i=-1
        }

        subTree{
          treeName:t="sub.oneShootAttack"
        }
      }

      failed{

        sequencer{

          decreaseDangerLevel{
            paramName:t="dangerLevel"
            decreaseCoef:r=0.5
          }
        }
      }
    }

    subTree{
      name:t=""
      refId:t="orderType"
    }
  }
}

repeat{
  name:t="sub.parachuteBeh"

  freefallOrParachuteBeh{
  }
}

repeat{
  name:t="sub.vehicleBeh"

  checkVehicleSeats{
  }

  wait{
    range:p2=0.5, 1.5
    resetable:b=yes
  }

  exitHandler{

    repeatUntilFail{

      sequencer{

        canHoldWeaponInVehicle{
        }

        findDanger{
          paramName:t="shootEnemy"
          outSeeTimeParam:t="shootEnemyTime"
          radiusParamName:t="enemyRadius"
          minDanger:r=0.5
          tag:t="human"
        }

        chooseBestWeapon{
          targetParam:t="shootEnemy"
        }

        setIntVar{
          to:t="crouchStanceMax"
          value:i=1
        }

        join{

          success{

            sequencer{

              checkFriendlyFire{
                targetUnitParam:t="shootEnemy"
              }

              shootAtUnit{
                targetUnitParam:t="shootEnemy"
                shootTime:p2=0.2, 1.0
                cooldownTime:p2=0.1, 0.9
                minAimTime:p2=0.3, 0.4
                maxStanceParam:t="crouchStanceMax"
                lostTargetCooldownRange:p2=1.0, 3.0
                closeShootRange:p2=1.0, 7.0
                closeShootAngles:p2=50.0, 20.0
              }
            }
          }

          startAim{
          }
        }

        startAim{
        }

        checkReloadWeapon{
        }

        parallel{

          cycle{

            not{

              findDanger{
                paramName:t="shootEnemy"
                outSeeTimeParam:t="shootEnemyTime"
                radiusParamName:t="enemyRadius"
                minDanger:r=0.5
                tag:t="human"
              }
            }
          }

          wait{
            range:p2=1.0, 3.0
            resetable:b=yes
          }
        }

        orderedSelector{

          isInVehicle{
          }

          resetIsInVehicleTrigger{
          }
        }
      }
    }

    stopAim{
    }
  }

  orderedSelector{

    isInVehicle{
    }

    resetIsInVehicleTrigger{
    }
  }
}

