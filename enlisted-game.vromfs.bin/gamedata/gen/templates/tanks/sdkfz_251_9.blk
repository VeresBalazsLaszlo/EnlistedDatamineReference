base_sdkfz_251_9{
  _use:t="base_tank"
  _use:t="sdkfz_251_9_ammo_stowages"
  vehicle_mods__trackFrontalSlidingFrictionMult:r=5.0
  vehicle_mods__trackFrontalStaticFrictionMult:r=5.0
  killLogName:t="germ_sdkfz_251_9"
  animchar__res:t="sdkfz_251_9_char"
  animchar_fast_phys__res:t="sdkfz_251_9_fastphys"
  collres__res:t="sdkfz_251_9_collision"
  vehicle_net_phys__blk:t="gamedata/gen/units/tanks/sdkfz_251_9.blk:VehiclePhys"
  particle_phys__blk:t="gamedata/gen/units/tanks/sdkfz_251_9.blk:PhysSys"
  dmg_animchar__res:t="sdkfz_251_9_dmg_char"
  xray_resource__modelName:t="sdkfz_251_9"
  cockpit__zoomOutFov:r=7.2531
  cockpit__zoomInFov:r=7.7525
  cockpit__sightName:t="sight_model/sfl_zf_1a"
  cockpit__sightFov:r=8.0
  drowningHeight:r=2.0
  damage_model__blk:t="gamedata/gen/units/tanks/sdkfz_251_9.blk"
  item__name:t="items/germ_sdkfz_251_9"
  skin__template:t="sdkfz_251_9_skins"
  losable_turret__detachBone:t="bone_turret"
  losable_turret__detachCollNode:t="cls_turret"
  losable_turret__mass:r=4300.0
  losable_turret__deviation:r=0.4
  losable_turret__rotation:r=2.5
  fire_damage__openHatchesOnExplosion:b=yes

  animchar_fast_phys{
    _tags:t="gameClient"
  }

  _group{
    _tags:t="gameClient"
    chain_ik__blk:t="gamedata/gen/units/tanks/sdkfz_251_9.blk:chainIK"
  }

  "turret_gun_flash_fx__flashNodes:shared:array"{
    node:t="emtr_gun_flame"
    node:t="emtr_mg_flame_01"
  }

  "turret_gun_flash_fx__flashFx:shared:array"{
    fx:t="muzzle_ground_60mm"
    fx:t="muzzle_ground_8mm"
  }

  "turret_gun_flash_fx__flashFxScale:shared:array"{
    scale:r=1.0
    scale:r=1.0
  }

  "turret_control__emitterNodes:shared:array"{
    node:t="bone_gun_barrel"
    node:t="bone_mg_aa_v_01"
  }

  "turret_control__animVars:shared:array"{

    "vars:object"{
      curYawParamName:t="turret_01_yaw"
      curPitchParamName:t="gun_01_pitch"
      aimActiveParamName:t="aim_01_active"
      paramYawSpeed:t="turret_01_yaw_speed"
      paramYawSpeedMul:t="turret_01_yaw_mul"
      paramYawAccel:t="turret_01_yaw_accel"
      paramMinYawAngle:t="turret_01_min_yaw_angle"
      paramMaxYawAngle:t="turret_01_max_yaw_angle"
      paramMinPitchAngle:t="turret_01_min_pitch_angle"
      paramMaxPitchAngle:t="turret_01_max_pitch_angle"
      paramPitchSpeed:t="gun_01_pitch_speed"
      paramPitchSpeedMul:t="gun_01_pitch_mul"
      paramPitchAccel:t="gun_01_pitch_accel"
      wishYawParamName:t="gun_01_aim:targetYaw"
      wishPitchParamName:t="gun_01_aim:targetPitch"
      gunRecoilParamName:t="gun_01_recoil"
    }

    "vars:object"{
      curYawParamName:t="turret_02_yaw"
      curPitchParamName:t="gun_02_pitch"
    }
  }

  "turret_control__turretInfo:shared:array"{

    "turretInfo:object"{
      turretName:t="turret_01"
      gun:t="sdkfz_251_9_turret_01_75mm_kwk51+turret_with_several_types_of_shells+main_turret"
      barrelDm:t="gun_barrel"
      breechDm:t="cannon_breech"
      verDriveDm:t="drive_turret_v"
      horDriveDm:t="drive_turret_h"
      salt:i=1
    }

    "turretInfo:object"{
      turretName:t="turret_02"
      gun:t="sdkfz_251_9_turret_01_7_92mm_mg42"
      barrelDm:t="gun_barrel_01"
      salt:i=1
    }
  }
}

sdkfz_251_9_turret_01_75mm_kwk51{
  _use:t="tankgun_75mm_kwk51"
  gun__shootNodeName:t="bone_gun_barrel"
  turret__yawSpeed:r=14.0
  turret__pitchSpeed:r=4.0
  turret__lastRelativeDir:p3=1.0, 0.0, 0.0
  turret__aimNodeName:t="bone_turret"
  turret__limit:p4=-14.0, 14.0, -10.0, 16.0

  "gun__shellsAmmo:array"{
    ammo:i=10
    ammo:i=7
    ammo:i=7
    ammo:i=7
    ammo:i=7
  }
}

sdkfz_251_9_turret_01_7_92mm_mg42{
  _use:t="tankgun_7_92mm_mg42"
  gun__shootNodeName:t="emtr_mg_flame_01"

  "gun__shellsAmmo:array"{
    ammo:i=3000
  }
}

