germ_sdkfz_251_1_apc{
  _use:t="germ_sdkfz_251_1_apc_common"
  _use:t="apc_settings"

  "disableDMParts:list<t>"{
    part:t="bone_mg_aa_h_01"
    part:t="bone_mg_aa_v_01"
    part:t="gun_barrel_02"
    part:t="gunner"
    part:t="loader"
    part:t="commander"
    part:t="machine_gunner"
    part:t="driver"
  }
}

germ_sdkfz_251_1_apc_common{
  _use:t="base_sdkfz_251_1"
  _use:t="forestall"
  _use:t="halftrack_seats"
  _use:t="germ_sdkfz_251_1_common_vehicle_sound"
  _use:t="vehicle_anim_steering_deflection"
  commanderFpsCamMaxAngle:p2=40.0, 40.0
