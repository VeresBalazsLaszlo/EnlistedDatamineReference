germ_sdkfz_251_1_driver_cockpit{
  _use:t="base_driver_cockpit_no_slits"
  animchar__res:t="pzkpfw_iii_e_driver_char"
  cockpit__offset:p3=-0.1, -0.1, 0.01

  "cockpit__slitForwardOffset:list<r>"{
    slit:r=-0.07
    slit:r=-0.05
  }

  "cockpit__slitIsGun:list<b>"{
    slit:b=no
    slit:b=no
  }

  "cockpit__slitNodeNames:list<t>"{
    slit:t="cam_front"
    slit:t="cam_left"
  }
}

germ_sdkfz_251_1_passenger_cockpit{
