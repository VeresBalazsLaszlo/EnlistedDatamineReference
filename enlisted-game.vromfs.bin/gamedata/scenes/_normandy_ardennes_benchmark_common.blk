import{
  scene:t="gamedata/scenes/_common_sounds.blk"
}

import{
  scene:t="gamedata/scenes/_normandy_ardennes_gpu.blk"
}

import{
  scene:t="gamedata/scenes/_normandy_ardennes_biome_fx.blk"
}

entity{
  _template:t="normandy_level"
  level__blk:t="levels/normandy_ardennes.blk"

  "level__weatherChoice:object"{

    "weather_poor_a:object"{
      weight:r=1.0

      "level__timeVec:array"{
        level__timeVec:r=8.5
      }

      "entities:array"{

        "entities:object"{
          template:t="camera_rain_heavy_template"

          "components:object"{
            far_rain__speed:r=1.0
            rain_ripples__size:r=0.04
            drop_splashes__volumetricSplashScale:r=0.5
            far_rain__wind:r=8.0
            far_rain__density:r=10.0
            drop_splashes__spriteSplashScale:r=7.25
            drop_splashes__iterationTime:r=2.0
            far_rain__length:r=1.0
            wetness__strength:r=0.4
            far_rain__alpha:r=1.0
            puddles__growthLimit:r=0.03
            far_rain__width:r=1.0
            puddles__growthRate:r=0.2
            far_rain__alpha_fade_speed_begin:r=150.0
            far_rain__alpha_fade_speed_end:r=400.0
            drop_splashes__distance:r=20.0
          }
        }

        "entity:object"{
          template:t="lightning_animchar_manager"
        }

        "entity:object"{
          template:t="lightning_volumetric"
        }

        "entity:object"{
          template:t="lightning_panorama"
        }
      }
    }
  }
}

entity{
  _template:t="volfog_nbs"
  volfog_nbs__rootGraph:t="fog_normandy_morning.json"
}

entity{
  _template:t="envi_cover_nbs"
  envi_cover_nbs__rootGraph:t="envi_cover_manchuria.json"
}

entity{
  _template:t="door_mult_ent_generator"
  ri_extra_gen__blk:t="gamedata/normandy_doors.blk"
}

entity{
  _template:t="enemy_attack_marker"
}

entity{
  _template:t="normandy_ardens_minimap"
}

entity{
  _template:t="shaderVars"

  "shader_vars__vars:object"{
    hmap_displacement_up:r=0.3
    ocean1:c=67, 65, 42, 0
    ocean0:c=51, 45, 18, 0
    ocean_density:r=1.0
    puddle_hardness:r=12.0
    puddle_increase:r=-0.18
    puddle_flat_noise_normal_effect:r=0.015
    puddle_flat_normal_hardness:r=25.0
    land_selfillum_worldscale:r=0.9
    river1:c=67, 65, 42, 0
    river0:c=51, 45, 18, 0
    hmap_displacement_down:r=-0.15
    puddle_flat_hmap_reduce:r=-0.2
    autodetect_land_selfillum_color:p4=0.53, 0.0, 0.0, 0.16
    paint_details_tex:t="normandy_ardennes_color_tex_palette*"
    land_selfillum_strength:r=32.0
    water_color_noise_size:r=71.0
    puddle_flat_noise_height_reduce:r=0.09
    river_density:r=1.0
  }
}

entity{
  _template:t="envi_cover_template"
  envi_cover_rt:b=yes
  envi_cover_reflectance:r=2.5
  envi_cover_intensity_map_left_top_right_bottom:p4=-2048.0, 2048.0, 2048.0, -2048.0
  envi_cover_normal_mask_threshold:r=0.5
  envi_cover_intensity_map:t="normandy_ardennes_det_snow_cover_tex_m*"
  envi_cover_translucency:r=1.0
  envi_cover_noise_high_frequency:r=8.0
  envi_cover_normal_infl:r=0.3
  envi_cover_normal:p4=0.0, 1.0, 0.1, 0.0
  envi_cover_smoothness:r=0.1
  envi_cover_albedo:p4=0.8, 0.961, 1.0, 0.0
}

entity{
  _template:t="bloom"
}

entity{
  _template:t="postfx_roundctrl"

  "post_fx:object"{
  }
}

