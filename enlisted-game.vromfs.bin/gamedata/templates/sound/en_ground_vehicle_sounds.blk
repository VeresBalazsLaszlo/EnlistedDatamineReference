en_projectile_hit_vehicle_fx_sound{
  _use:t="projectile_hit_entity_fx_sound"

  "projectile_hit_entity_fx_sound__paths:shared:object"{
    _tags:t="sound"

    "stopped:object"{

      "bullet:object"{
        watched:t="player/vehicle/tank/impacts/hit_small_fail"
        other:t="enemy/vehicle/tank/impacts/hit_small_fail"
      }

      "shell:object"{
        watched:t="player/vehicle/tank/impacts/hit_mid_fail"
        other:t="enemy/vehicle/tank/impacts/hit_mid_fail"
      }
    }

    "unstopped:object"{

      "bullet:object"{
        watched:t="player/vehicle/tank/impacts/hit_small_fail"
        other:t="enemy/vehicle/tank/impacts/hit_small_fail"
      }

      "shell:object"{
        watched:t="player/vehicle/tank/impacts/hit_mid"
        other:t="enemy/vehicle/tank/impacts/hit_mid"
      }
    }

    "rico:object"{

      "bullet:object"{
        watched:t="player/vehicle/tank/impacts/rico_bullet"
        other:t="enemy/vehicle/tank/impacts/rico_bullet"
      }

      "shell:object"{
        watched:t="player/vehicle/tank/impacts/rico_shell"
        other:t="enemy/vehicle/tank/impacts/rico_shell"
      }
    }
  }
}

