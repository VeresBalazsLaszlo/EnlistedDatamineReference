base_p_40e_ussr{
  plane_phys_damage__blk:t="gamedata/units/p_40e_ussr.blk"
  animchar__res:t="p_40e_char"
}

p_40e_ussr_wreckage{
  _use:t="base_p_40e_ussr"
  _use:t="plane_wreckage"
  plane_wreckage__nodeName:t=""
  plane_wreckage__typeName:t=""
}

p_40e_ussr_base{
  _use:t="plane_with_cockpit"
  _use:t="base_p_40e_ussr"
  collres__res:t="p_40e_collision"
  plane_net_phys__blk:t="gamedata/units/p_40e_ussr.blk"
  damage_model__blk:t="gamedata/units/p_40e_ussr.blk"
  plane_collision__blk:t="gamedata/units/p_40e_ussr.blk"
  plane_anim__blk:t="gamedata/units/p_40e_ussr.blk"
  plane_sight__blk:t="gamedata/units/p_40e_ussr.blk"
  canUseRespawnbaseType:t="aircraft_fighter"
  is_seaplane:b=no
  plane_wreckage__template:t="p_40e_ussr_wreckage"
  killLogName:t="p_40e_ussr"
  animchar__res:t="p_40e_char"
  vehicle_seats_camera_nodes__defaultNode:t=""

  _group{
    _tags:t="render"
    animchar_camera_target__node_name:t=""
    animchar_camera_target__node_offset:p3=0.0, 0.0, 0.0
  }

  "vehicle_seats_can_acquire_controls:list<i>"{
  }

  "vehicle_seats__canAcquireControls:shared:object"{

    "driver:object"{
      movement:b=yes
      turrets:b=yes
    }

    "main_gunner:object"{
      turrets:b=yes
    }
  }
}