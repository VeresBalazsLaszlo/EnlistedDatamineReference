let getSquadArmy = @(squadId) squadsPresentation.findindex(@(v) squadId in v)

let getSquadPresentation = @(squadId, armyId = null)
  squadsPresentation?[armyId ?? getSquadArmy(squadId)][squadId]

return {
  squadsPresentation
  getSquadPresentation
  getSquadArmy
}