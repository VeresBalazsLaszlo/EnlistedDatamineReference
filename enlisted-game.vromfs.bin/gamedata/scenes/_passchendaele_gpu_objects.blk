  dagdp__max_objects:i=10000
}

entity{
  _template:t="dagdp_object_group_riex"
  dagdp__name:t="trenches"

  "dagdp__params:object"{
    scale:p2=0.975, 0.025
    orientation:t="normal"
  }

  "dagdp__assets:object"{

    "debris_metal_can_a:object"{
      weight:r=1.0
    }

    "debris_metal_can_b:object"{
      weight:r=1.0
    }

    "sandbag_single_a:object"{
      weight:r=5.0
