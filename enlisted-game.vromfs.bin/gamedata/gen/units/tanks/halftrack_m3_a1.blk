        from:t="suspension_02_03"
        movePoint:b=no
        moveEdgeNodes:b=no
      }

      projection{
        point:t="suspension_02_02"
        from:t="wheel_01"
        to:t="wheel_02"
        moveEdge:b=yes
      }

      projection{
        point:t="suspension_02_04"
        from:t="wheel_03"
        to:t="wheel_04"
        moveEdge:b=yes
      }

      projection{
        moveEdge:b=yes
        point:t="lever"
        from:t="suspension_02_01"
        to:t="suspension_02_02"
      }

      projection{
        moveEdge:b=yes
        point:t="lever"
        from:t="suspension_02_03"
        to:t="suspension_02_04"
      }

      projection{
        moveEdge:b=yes
        point:t="lever"
        from:t="suspension_02_01"
        to:t="suspension_02_03"
      }

      projection{
        movePoint:b=no
        moveEdge:b=yes
        moveEdgeNodes:b=no
        point:t="lever"
        from:t="suspension_02_01"
        to:t="suspension_02_03"
      }

      direction{
        moveNodes:b=yes
        rotateSecond:b=no
        moveSecond:b=yes
        moveOnly:b=no
        point:t="suspension_02_02"
        to:t="wheel_02"
        from:t="wheel_01"
      }

      direction{
        moveNodes:b=yes
        movePoint:b=yes
        moveEdge:b=no
        moveEdgeNodes:b=yes
        point:t="suspension_02_04"
        from:t="wheel_03"
        to:t="wheel_04"
      }

      direction{
        moveNodes:b=yes
        rotateSecond:b=no
        moveSecond:b=yes
        moveOnly:b=no
        point:t="lever"
        from:t="suspension_02_01"
        to:t="suspension_02_02"
      }

      direction{
