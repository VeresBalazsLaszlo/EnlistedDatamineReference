    segment{
      radiusScale:r=1.05
      penetrationScale:r=1.2
      damageScale:r=1.3
      angles:p2=20.0, 160.0
      countPortion:r=0.5
    }

    segment{
      radiusScale:r=1.05
      penetrationScale:r=1.2
      damageScale:r=1.3
      angles:p2=200.0, 340.0
      countPortion:r=0.5
    }

    segment{
      radiusScale:r=1.05
      penetrationScale:r=1.2
      damageScale:r=1.3
      angles:p2=0.0, 359.0
      countPortion:r=0.2
    }
  }
}

shatterDamage{
  breachConeAngle:r=45.0
}

visual{
  range_percent_of_ammo:p2=100.0, 0.0
