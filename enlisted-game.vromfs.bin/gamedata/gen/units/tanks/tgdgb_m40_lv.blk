PhysSys{

  group{
    find:t="^bone_suspension_(._\d\d)$"

    points{

      lever{
        limitMin:p3=0.0, 0.0, 0.0
        limitMax:p3=0.0, 0.0, 0.0
        name:t="bone_suspension_$1"
      }

      wheel{

        searchChildren{
          occurence:i=1
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          parent:t="lever"
          find:t="bone_wheel_"
        }
      }

      suspension_02{
        limitMin:p3=0.0, -1.0, 0.0
        limitMax:p3=0.0, 1.0, 0.0
        name:t="bone_suspension_$1_02"
      }

      suspension_03{
        limitMin:p3=0.0, -1.0, 0.0
        limitMax:p3=0.0, 1.0, 0.0
        name:t="bone_suspension_$1_03"
      }

      suspension_04{
        limitMin:p3=0.0, 0.0, 0.0
        limitMax:p3=0.0, 0.0, 0.0
        name:t="bone_suspension_$1_04"
      }
    }

    constraints{

      edge{
        to:t="wheel"
        from:t="lever"
      }

      edge{
        to:t="wheel"
        from:t="suspension_02"
      }

      edge{
        rotateSecond:b=yes
        moveSecond:b=no
        to:t="suspension_04"
        from:t="suspension_03"
      }

      edge{
        rotateSecond:b=yes
        to:t="suspension_02"
        from:t="suspension_03"
      }
    }
  }

  group{
    find:t="bone_suspension_(\w)_back_(\d+)$"

    points{

      lever{
        limitMin:p3=0.0, 0.0, 0.0
        limitMax:p3=0.0, 0.0, 0.0
        name:t="bone_suspension_$1_back_$2"
      }

      wheel{

        searchChildren{
          occurence:i=1
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          parent:t="lever"
          find:t="bone_wheel_"
        }
      }
    }

    constraints{

      edge{
        to:t="wheel"
        from:t="lever"
      }
    }
  }
}

