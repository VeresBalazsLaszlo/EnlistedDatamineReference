ussr_t_28_n2_premium{
  _use:t="ussr_t_28_common"
  item__name:t="items/ussr_t_28_n2_premium"

  "animchar__objTexSet:object"{

    "t_28_body_c*:object"{
      "t_28_skin_body_c*":t="camo_skin_tex"
    }

    "t_28_turret_c*:object"{
      "t_28_skin_turret_c*":t="camo_skin_tex"
    }
  }
}