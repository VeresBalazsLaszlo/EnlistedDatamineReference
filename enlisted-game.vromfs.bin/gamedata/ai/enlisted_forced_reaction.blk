                yRadius:r=3.0
              }
            }

            success{

              moveToPos{
                posParam:t="hidePos"
                distThreshold:r=0.35
                avoidAiObstacles:b=no
                timeToStuck:r=2.0
                strafeNearDist:r=3.0
                jumpDownTraceCheck:p3=0.4, 1.0, 0.15
                rotateDistThreshold:r=0.5
                rotateFactors:p4=0.5, 0.3, 0.3, 0.1
                rotateStartTime:r=0.5
              }
            }
          }

          orderedSelector{

            isAgentPlayerBot{
            }

            checkDistance{
              posParam:t="reactPos"
              radiusParam:t="enemyNearRadius"
              yRadius:r=3.0
            }
          }

          orderedSelector{

            checkDistance{
              posParam:t="rememberEnemyPos"
              radius:r=7.0
              yRadius:r=5.0
            }

            rotateToPoint{
              posParam:t="rememberEnemyPos"
              aimSpeedCoef:r=0.9
              maxSimAngle:p2=60.0, 80.0
              strafeChance:r=0.9
              strafeTimes:p2=0.4, 0.6
              minSimAngle:r=5.0
              minSimSpeedCoef:r=0.5
            }
          }

          checkReloadWeapon{
            waitReloadFinish:b=yes
          }

          getTime{
            to:t="shootEnemyTime"
          }

          getTime{
            to:t="rememberEnemyTime"
          }

          copyIntVar{
            to:t="shootEnemy"
            from:t="reactEid"
          }

          copyIntVar{
            to:t="rememberEnemy"
            from:t="shootEnemy"
          }

          setPosFromEntity{
            to:t="rememberEnemyPos"
            from:t="shootEnemy"
          }
        }

        sequencer{

          checkDelayedReaction{
            ofType:t="turn_payback"
          }

          setDebugSym{
            act:t="d70"
            r:i=70
          }

          setDebugSym{
            act:t="d71"
          }

          isReadyForAction{
          }

          not{

            isLeader{
            }
          }

          checkReloadWeapon{
            checkOnly:b=yes
          }

          detachFromStationaryGun{
          }

          changeStance{
            stanceName:t="crouch"
            maxStanceParam:t="maxStance"
          }

          rotateToPoint{
            posParam:t="reactPos"
            aimSpeedCoef:r=0.9
            maxSimAngle:p2=60.0, 80.0
            strafeChance:r=0.9
            strafeTimes:p2=0.4, 0.6
            minSimAngle:r=5.0
            minSimSpeedCoef:r=0.5
          }

          wait{
            range:p2=0.5, 1.0
            resetable:b=yes
          }

          orderedSelector{

            isAgentPlayerBot{
            }

            checkDistance{
              posParam:t="reactPos"
              radiusParam:t="enemyNearRadius"
              yRadius:r=3.0
            }
          }

          getTime{
            to:t="shootEnemyTime"
          }

          getTime{
            to:t="rememberEnemyTime"
          }

          copyIntVar{
            to:t="shootEnemy"
            from:t="reactEid"
          }

          copyIntVar{
            to:t="rememberEnemy"
            from:t="shootEnemy"
          }

          setPosFromEntity{
            to:t="rememberEnemyPos"
            from:t="shootEnemy"
          }

          setIntVar{
            to:t="minStance"
            value:i=1
          }

          setIntVar{
            to:t="maxStance"
            value:i=2
          }
        }

        sequencer{

          checkDelayedReaction{
            ofType:t="panic_run"
          }

          setDebugSym{
            act:t="d99"
            r:i=99
          }
        }

        sequencer{

          checkDelayedReaction{
            ofType:t="panic_crawl"
          }

          setDebugSym{
            act:t="d99"
            r:i=99
          }
        }
      }
    }

    resetDelayedReaction{
    }
  }
}

orderedSelector{
  name:t="sub.checkForcedReaction.hideJustNow"

  isVarsIntEqual{
    lhs:t="coverAttack"
    rhs_value:i=0
  }

  sequencer{

    getCoverPosAndDir{
      coverIndexParam:t="coverAttackCover"
      coverSlotParam:t="coverAttackCoverSlot"
      outPosParam:t="coverPos"
    }

    subTree{
      treeName:t="sub.hideToCoverAttackCover"
    }
  }

  sequencer{

    setIntVar{
      to:t="maxStance"
      value:i=1
    }

    detachFromStationaryGun{
    }

    changeStance{
      stanceName:t="crawl"
      maxStanceParam:t="maxStance"
    }
  }
}

sequencer{
  name:t="sub.checkForcedReaction.resetAttacks"

  setIntVar{
    to:t="coverAttack"
    value:i=0
  }

  setIntVar{
    to:t="regroupToPit"
    value:i=0
  }

  setRealVar{
    to:t="dangerLevel"
    value:r=2.0
  }
}

sequencer{
  name:t="sub.checkForcedReaction.findHidePos"

  getAgentAIPos{
    outPosParam:t="selfPos"
  }

  copyPoint3Var{
    from:t="selfPos"
    to:t="hidePos"
  }

  copyPoint3Var{
    from:t="hidePos"
    to:t="wishPosition"
  }

  setIntVar{
    to:t="hiddenPos"
    value:i=0
  }

  orderedSelector{

    sequencer{

      isInCover{
      }

      setIntVar{
        to:t="hiddenPos"
        value:i=1
      }
    }

    sequencer{

      findCoverForCoverAttack{
        targetParam:t="reactEid"
        approachPosParam:t="reactPos"
      }

      getCoverPosAndDir{
        coverIndexParam:t="coverAttackCover"
        coverSlotParam:t="coverAttackCoverSlot"
        outPosParam:t="hidePos"
      }

      setIntVar{
        to:t="coverAttack"
        value:i=0
      }

      setIntVar{
        to:t="hiddenPos"
        value:i=1
      }

      orderedSelector{

        not{

          isDowned{
          }
        }

        checkDistance{
          posParam:t="hidePos"
          radius:r=5.0
          yRadius:r=1.0
        }
      }

      checkDistance{
        posParam:t="hidePos"
        otherPosParam:t="reactPos"
        radius:r=25.0
        yRadius:r=2.5
      }
    }

    sequencer{

      findCoverAroundPoint{
        invertToCenter:b=yes
        centerParam:t="reactPos"
        radius:r=15.0
        coverPosParam:t="hidePos"
        minDist:r=0.0
        maxOccupied:i=5
      }

      orderedSelector{

        not{

          isDowned{
          }
        }

        checkDistance{
          posParam:t="hidePos"
          radius:r=5.0
          yRadius:r=1.0
        }
      }

      checkDistance{
        posParam:t="hidePos"
        otherPosParam:t="reactPos"
        radius:r=15.0
        yRadius:r=2.5
      }

      setIntVar{
        to:t="hiddenPos"
        value:i=1
      }
    }

    sequencer{

      checkCover{
      }

      getCoverPosition{
        coverPosParam:t="hidePos"
      }

      checkDistance{
        posParam:t="hidePos"
        otherPosParam:t="reactPos"
        radius:r=15.0
        yRadius:r=2.5
      }
    }

    continue{
    }
  }
}

