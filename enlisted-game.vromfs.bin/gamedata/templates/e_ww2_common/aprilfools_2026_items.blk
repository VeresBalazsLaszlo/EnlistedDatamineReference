  cockpit__scale:p3=0.08, 0.08, 1.4
}

ger_ww1_gasmask_weapon_item{
  _use:t="item"
  _use:t="animchar"
  _use:t="weapon_slot_attachable"
  animchar__res:t="ger_ww1_gasmask_weapon_char"
  collres__res:t="ger_ww1_gasmask_weapon_collision"
  item__uniqueName:t="ger_ww1_gasmask_weapon_item"
  animchar_render__enabled:b=yes
  gun__visible:b=yes
  human_gun_attached:b=no
  gun_attach__slot:t="weapon"
  gun_attach__mainSlotId:i=-1
  gun_attach__alternativeSlot:t="weapon"
  gun_attach__altSlotId:i=-1
  gas_mask__animEnumName:t="ger_ww1_gasmask_weapon"
  gas_mask__animEnumValue:i=-1
  gas_mask__faceItemTemplate:t="ger_ww1_gasmask_item"

  "gasMask:tag"{
  }

  "attachmentUpdate:tag"{
  }

  "gun__owner:eid"{
  }
}

