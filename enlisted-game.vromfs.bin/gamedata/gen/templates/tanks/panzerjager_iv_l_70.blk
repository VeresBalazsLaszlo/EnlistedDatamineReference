base_panzerjager_iv_l_70{
  _use:t="base_tank"
  _use:t="panzerjager_iv_l_70_ammo_stowages"
  _use:t="vehicle_physical_tracks"
  killLogName:t="germ_pz_iv_l70"
  animchar__res:t="panzerjager_IV_L_70_char"
  animchar_fast_phys__res:t="panzerjager_IV_L_70_fastphys"
  collres__res:t="panzerjager_IV_L_70_collision"
  vehicle_net_phys__blk:t="gamedata/gen/units/tanks/panzerjager_iv_l_70.blk:VehiclePhys"
  particle_phys__blk:t="gamedata/gen/units/tanks/panzerjager_iv_l_70.blk:PhysSys"
  dmg_animchar__res:t="panzerjager_IV_L_70_dmg_char"
  xray_resource__modelName:t="panzerjager_IV_L_70"
  cockpit__zoomOutFov:r=7.2531
  cockpit__zoomInFov:r=7.7525
  cockpit__sightName:t="sight_model/sfl_zf_1a"
  cockpit__sightFov:r=8.0
  drowningHeight:r=1.48
  damage_model__blk:t="gamedata/gen/units/tanks/panzerjager_iv_l_70.blk"
  item__name:t="items/germ_pz_iv_l70"
  physical_tracks__blk:t="gamedata/gen/units/tanks/panzerjager_iv_l_70.blk"
  turret_control__grenadeLauncherSalvoSize:i=1
  skin__template:t="panzerjager_iv_l_70_skins"
  losable_turret__detachBone:t="bone_turret"
  losable_turret__detachCollNode:t="cls_turret_01"
  losable_turret__mass:r=4300.0
  losable_turret__deviation:r=0.4
  losable_turret__rotation:r=2.5
  fire_damage__openHatchesOnExplosion:b=yes

  animchar_fast_phys{
    _tags:t="gameClient"
  }

  "turret_gun_flash_fx__flashNodes:shared:array"{
    node:t="emtr_gun_flame"
    node:t="emtr_mg_flame_01"
    node:t="emtr_mortar_flame_01"
  }

  "turret_gun_flash_fx__flashFx:shared:array"{
    fx:t="muzzle_ground_80mm"
    fx:t="muzzle_ground_8mm"
    fx:t="muzzle_ground_8mm"
  }

  "turret_gun_flash_fx__flashFxScale:shared:array"{
    scale:r=1.0
    scale:r=1.0
    scale:r=1.0
  }

  "turret_control__emitterNodes:shared:array"{
    node:t="bone_gun_barrel"
    node:t="bone_mg_gun_h_twin"
    node:t="emtr_mortar_flame_01"
  }

  "turret_control__animVars:shared:array"{

    "vars:object"{
      curYawParamName:t="turret_01_yaw"
      curPitchParamName:t="gun_01_pitch"
      aimActiveParamName:t="aim_01_active"
      paramYawSpeed:t="turret_01_yaw_speed"
      paramYawSpeedMul:t="turret_01_yaw_mul"
      paramYawAccel:t="turret_01_yaw_accel"
      paramMinYawAngle:t="turret_01_min_yaw_angle"
      paramMaxYawAngle:t="turret_01_max_yaw_angle"
      paramMinPitchAngle:t="turret_01_min_pitch_angle"
      paramMaxPitchAngle:t="turret_01_max_pitch_angle"
      paramPitchSpeed:t="gun_01_pitch_speed"
      paramPitchSpeedMul:t="gun_01_pitch_mul"
      paramPitchAccel:t="gun_01_pitch_accel"
      wishYawParamName:t="gun_01_aim:targetYaw"
      wishPitchParamName:t="gun_01_aim:targetPitch"
      gunRecoilParamName:t="gun_01_recoil"
    }

    "vars:object"{
      curYawParamName:t="turret_02_yaw"
      curPitchParamName:t="gun_02_pitch"
      aimActiveParamName:t="aim_02_active"
      paramYawSpeed:t="turret_02_yaw_speed"
      paramYawSpeedMul:t="turret_02_yaw_mul"
      paramYawAccel:t="turret_02_yaw_accel"
      paramMinYawAngle:t="turret_02_min_yaw_angle"
      paramMaxYawAngle:t="turret_02_max_yaw_angle"
      paramMinPitchAngle:t="turret_02_min_pitch_angle"
      paramMaxPitchAngle:t="turret_02_max_pitch_angle"
      paramPitchSpeed:t="gun_02_pitch_speed"
      paramPitchSpeedMul:t="gun_02_pitch_mul"
      paramPitchAccel:t="gun_02_pitch_accel"
      wishYawParamName:t="gun_02_aim:targetYaw"
      wishPitchParamName:t="gun_02_aim:targetPitch"
    }

    "vars:object"{
      curYawParamName:t="turret_03_yaw"
      curPitchParamName:t="gun_03_pitch"
    }
  }

  "turret_control__turretInfo:shared:array"{

    "turretInfo:object"{
      turretName:t="turret_01"
      gun:t="panzerjager_iv_l_70_turret_01_75mm_pak42+turret_with_several_types_of_shells+main_turret"
      barrelDm:t="gun_barrel"
      breechDm:t="cannon_breech"
      verDriveDm:t="drive_turret_v"
      horDriveDm:t="drive_turret_h"
      salt:i=1
    }

    "turretInfo:object"{
      turretName:t="turret_02"
      gun:t="panzerjager_iv_l_70_turret_02_7_92mm_mg42"
      barrelDm:t="gun_barrel_01"
      salt:i=1
    }

    "turretInfo:object"{
      turretName:t="turret_03"
      needsAssignedGunner:b=no
      turretGroup:t="smoke"
      gun:t="panzerjager_iv_l_70_turret_03_91mm_germ_smoke_mortar_launcher"
      salt:i=1
    }
  }

  "losable_turret__detachCollNodes:list<t>"{
    node:t="cls_turret_01"
    node:t="cls_turret_02"
  }
}

panzerjager_iv_l_70_turret_01_75mm_pak42{
  _use:t="tankgun_75mm_pak42"
  gun__shootNodeName:t="bone_gun_barrel"
  turret__yawSpeed:r=8.0
  turret__pitchSpeed:r=4.0
  turret__aimNodeName:t="bone_turret"
  turret__limit:p4=-12.0, 12.0, -7.0, 15.0

  "gun__shellsAmmo:array"{
    ammo:i=19
    ammo:i=18
    ammo:i=18
  }
}

panzerjager_iv_l_70_turret_02_7_92mm_mg42{
  _use:t="tankgun_7_92mm_mg42"
  gun__shootNodeName:t="bone_mg_gun_h_twin"
  turret__yawSpeed:r=5.5
  turret__pitchSpeed:r=4.0
  turret__aimNodeName:t="bone_mg_gun_h_twin"
  turret__limit:p4=-5.0, 5.0, -6.0, 15.0

  "gun__shellsAmmo:array"{
    ammo:i=300
    ammo:i=300
  }
}

panzerjager_iv_l_70_turret_03_91mm_germ_smoke_mortar_launcher{
  _use:t="tankgun_91mm_germ_smoke_mortar_launcher"
  gun__shootNodeName:t="emtr_mortar_flame_01"
  gun__maxAmmo:i=6
  gun__shotFreq:r=1.0

  "gun__shellsAmmo:array"{
    ammo:i=3
    ammo:i=3
  }
}

panzerjager_iv_l_70_ammo_stowages{
  _tags:t="server"
  _use:t="vehicle_ammo_stowages"

  "ammo_stowage__stowageTemplates:shared:list<t>"{
    stowage:t="panzerjager_iv_l_70_ammo_stowage_1"
  }
}

panzerjager_iv_l_70_ammo_stowage_1{
  _use:t="ammo_stowage"

  "ammo_stowage__clusterTemplates:shared:list<t>"{
    cluster:t="panzerjager_iv_l_70_ammo_cluster_1_1"
  }

  "ammo_stowage__turretNames:shared:list<t>"{
    gun:t="turret_01"
  }
}

panzerjager_iv_l_70_ammo_cluster_1_1{
  _use:t="ammo_cluster"
  ammo_cluster__isShell:b=yes

  "ammo_cluster__slotNames:shared:list<t>"{
    part:t="ammo_body_l_02"
    part:t="ammo_body_r_02"
    part:t="ammo_body_l_01"
    part:t="ammo_body_r_01"
    part:t="ammo_body_l_03"
    part:t="ammo_body_l_04"
    part:t="ammo_body_r_03"
  }

  "ammo_cluster__slotsMaxAmmo:list<i>"{
    count:i=10
    count:i=10
    count:i=10
    count:i=10
    count:i=8
    count:i=4
    count:i=3
  }
}