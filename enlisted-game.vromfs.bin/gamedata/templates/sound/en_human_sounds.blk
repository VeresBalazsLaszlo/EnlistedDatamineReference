common_human_sound_components{
  _use:t="watched_sound"
  _use:t="sound_event_group"
  _use:t="sound_control"
  _use:t="sound_player_components"

  _group{
    _tags:t="sound"
    sound_control__range:r=100.0
  }

  "human_animchar_sound:HumanAnimcharSound"{
    _tags:t="sound"
  }

  "humanSound:tag"{
    _tags:t="sound"
  }
}

base_human_steps_sound_generator{

  _group{
    _tags:t="sound"
    human_steps_sound_generator__lastStepAt_cooldown:p2=-1.0, 0.0
    human_steps_sound_generator__walkRunSprint_stand_intervals:p3=10.0, 10.0, 10.0
    human_steps_sound_generator__walkRunSprint_crouch_intervals:p3=10.0, 10.0, 10.0
    human_steps_sound_generator__enableForVisible:b=no
    human_steps_sound_generator__enableForInvisible:b=no
    human_steps_sound_generator__enableAlways:b=no
  }
}

human_steps_sound_occlusion{

  _group{
    _tags:t="sound"
    human_steps_sound_occlusion__blobRadius:r=0.5

    "human_steps_sound_occlusion__blob:SoundOcclusionBlob"{
    }
  }
}

base_human_steps_sound{
  _use:t="sound_biome_puddle_queries"
  _use:t="base_human_steps_sound_generator"
  _use:t="human_steps_sound_occlusion"

  _group{
    _tags:t="sound"
    human_steps_sound__lastTimeOnGround:r=0.0
    human_steps_sound__smid:i=-1
    human_steps_sound__waterDepth:r=0.0
    human_steps_sound__physStates:i=-1
    human_steps_sound__irqObjIdx:i=-1
    human_steps_sound__moveState:i=0
    human_steps_sound__animSpeed:r=0.0
    human_steps_sound__ministepsIsMoving:b=no
    human_steps_sound__animSpeedMul:r=1.0
    human_steps_sound__traceStepOffsetLen:p2=1.0, 2.0
    human_steps_sound__distanceToVolumeFriendly:p4=0.0, 0.0, 0.1, 0.1
    human_steps_sound__distanceToVolumeEnemy:p4=0.0, 0.0, 1.0, 1.0
    human_steps_sound__farawayThresholdSq:r=2500.0
    human_steps_sound__fallSpeedCollThreshold:r=10.0
    human_steps_sound__ministepsWalkIrq:t="right_crouchWalk"
    human_steps_sound__ministepsCrawlIrq:t="right_crawl"
    human_steps_sound__ministepsCooldown:r=1.0
    human_steps_sound__tag:t=""

    "human_steps_sound__stepIdx:u32"{
      value:i=0
    }

    "human_steps_sound__path:shared:object"{
    }

    "human_steps_sound__descs:shared:object"{
    }

    "human_steps_sound__irqs:shared:array"{
    }

    "human_steps_sound__jumpFx:shared:object"{
    }

    "human_steps_sound__stepFx:shared:object"{
    }
  }
}

human_gasmask_sound{

  _group{
    _tags:t="sound"
    human_gasmask_sound__watchedPath:t="snapshots/filter_gm"
    human_gasmask_sound__otherFlag:t="gasmask"
    human_gasmask_sound__putonPath:t="player/walker/ww2_soldier/items/gasmask/wear_on"
    human_gasmask_sound__takeoffPath:t="player/walker/ww2_soldier/items/gasmask/wear_off"

    "human_gasmask_sound__watchedEvent:SoundEvent"{
    }
  }
}

play_invisible_animations_near_listener{

  _group{
    _tags:t="sound"
    animchar__alwaysVisibleInRadiusSq:r=100.0
  }
}

base_human_sound{
  _use:t="common_human_sound_components"
  _use:t="play_invisible_animations_near_listener"
  _use:t="human_sound_geomtree_nodes"
  _use:t="human_voice_effects"
  _use:t="human_melee_sound"
  _use:t="human_build_sound"
  _use:t="base_human_melee_impact_sound"
  _use:t="base_human_steps_sound"
  _use:t="human_hit_net_sound"
  _use:t="base_human_voice_sound"
  _use:t="human_voice_sound_occlusion"
  _use:t="human_death_sound"
  _use:t="human_hit_cry_sound"
  _use:t="human_melee_charge_speech_enable"
  _use:t="human_coverme_speech_enable"
  _use:t="human_sound_net_equipment_tags"
  _use:t="human_gasmask_sound"
  _use:t="sound_preset"

  "human_voice_effect__allOrderedEffects:shared:list<t>"{
    _tags:t="sound"
    id:t="dead"
    id:t="underwater"
    id:t="holdBreath"
    id:t="downed"
    id:t="drink"
    id:t="burn"
    id:t="fallcry"
    id:t="cough"
  }

  _group{
    _tags:t="sound"
    human_steps_sound_generator__walkRunSprint_stand_intervals:p3=1.15, 1.2, 1.6
    human_steps_sound_generator__walkRunSprint_crouch_intervals:p3=0.5, 0.85, 0.85
    human_steps_sound_generator__enableForVisible:b=yes
    human_steps_sound_generator__enableForInvisible:b=yes
  }

  _group{
    _tags:t="sound"
    sound_biome_puddle_queries__puddleQueryToDepth:p4=0.4, 0.8, 0.0, 0.05
  }

  "using_item_sound__path:shared:object"{
    _tags:t="sound"
    path:t="/walker/ww2_soldier/items/healing/activate"
  }
}

