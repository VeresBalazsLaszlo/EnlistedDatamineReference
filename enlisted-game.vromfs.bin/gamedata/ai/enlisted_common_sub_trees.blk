      minDistToSprint:r=5.0
      lookVisc:r=0.1
      tryClimbing:b=yes
      maxStanceParam:t="maxStance"
      stuckDirParam:t="stuckDir"
      incLadders:b=yes
      strafeNearDist:r=2.5
      timeToStuck:r=0.9
      incObstacles:b=yes
      avoidAiObstacles:b=no
      rotateDistThreshold:r=0.5
      rotateFactors:p4=0.5, 0.3, 0.3, 0.2
      rotateStartTime:r=0.4
      finalLookSetup:p4=1.0, 5.0, 4.0, 0.2
      finalLookPosParam:t="finalLookPos"
      distThreshold:r=1.0
      jumpDownTraceCheck:p3=0.4, 1.0, 0.15
    }
  }

  sequencer{

    setDebugSym{
      act:t="z3"
    }

    detachFromStationaryGun{
    }

    moveToPos{
      posParam:t="wishPosition"
      sprintTimerRange:p2=10.0, 20.0
      minDistToSprint:r=5.0
      lookVisc:r=0.1
      tryClimbing:b=yes
      maxStanceParam:t="maxStance"
      stuckDirParam:t="stuckDir"
      incLadders:b=yes
      strafeNearDist:r=2.5
      timeToStuck:r=0.9
      incObstacles:b=no
      avoidAiObstacles:b=no
      distThreshold:r=0.35
      rotateDistThreshold:r=0.5
      rotateFactors:p4=0.5, 0.3, 0.3, 0.1
      rotateStartTime:r=0.3
      finalLookSetup:p4=1.0, 5.0, 4.0, 0.2
      finalLookPosParam:t="finalLookPos"
      failOnPartialTime:r=0.8
      jumpDownTraceCheck:p3=0.4, 1.0, 0.15
    }
  }
}

