      }

      "hatchTurretNames:array"{
        turret:t="turret_03"
      }

      "effectors:object"{

        "l.hand:object"{
          rel_tm:m=[[-0.141022, 0.966429, 0.214772] [0.808329, 0.237654, -0.538633] [-0.571592, 0.0976475, -0.814708] [0.218658, 0.741803, -0.0619678]]
          node:t="commander"
        }

        "r.hand:object"{
          rel_tm:m=[[0.0324716, 0.967802, -0.249607] [0.882259, 0.089594, 0.462157] [0.46964, -0.235225, -0.850944] [0.214447, 0.753307, 0.214532]]
          node:t="commander"
