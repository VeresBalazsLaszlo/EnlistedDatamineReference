import{
  scene:t="gamedata/scenes/_tunisia_biome_fx.blk"
}

import{
  scene:t="gamedata/scenes/_tunisia_gpu_objects.blk"
}

import{
  scene:t="gamedata/scenes/halloween_event_missions/_tunisia_zombie_level_sounds.blk"
}

entity{
  _template:t="tunisia_level"
  level__blk:t="levels/tunisia_4x4_zombie_night.blk"
  level__timeOfDay:r=20.2
  level__loadExtraNavMeshes:t=""

  "level__weatherChoice:object"{

    "weather_clear_a:object"{
      weight:r=1.0

      "level__timeVec:array"{
        level__timeVec:r=20.2
        level__timeVec:r=20.1
        level__timeVec:r=20.0
      }
    }
  }
}

entity{
  _template:t="volfog_nbs"
  volfog_nbs__rootGraph:t="fog_dark_zone_winter.json"
}

entity{
  _template:t="envi_cover_nbs"
  envi_cover_nbs__rootGraph:t="envi_cover_manchuria.json"
}

entity{
  _template:t="shaderVars"

  "shader_vars__vars:object"{
    ocean1:p4=0.267, 0.251, 0.125, 0.0
    ocean0:p4=0.278, 0.247, 0.129, 0.0
    ocean_density:r=0.4
    puddle_hardness:r=33.0
    puddle_flat_noise_normal_effect:r=0.015
    puddle_flat_normal_hardness:r=45.0
    layered_fog_density:r=0.008
    river1:p4=0.192, 0.373, 0.235, 0.0
    river0:p4=0.58, 0.592, 0.38, 0.0
    puddle_flat_hmap_reduce:r=-0.0095
    leaves_ss_profile:p4=1.0, 1.0, 1.0, 0.0
    paint_details_tex:t="tunisia_wall_color_tex_palette*"
    layered_fog_height:r=100.0
    puddle_increase:r=-0.02
    water_color_noise_size:r=737.0
    puddle_flat_noise_height_reduce:r=0.09
    max_river_width:r=50.0
    river_density:r=0.4
    land_selfillum_strength:r=32.0
  }
}

entity{
  _template:t="wind"
  wind__strength:r=2.3
  wind__dir:r=0.0
}