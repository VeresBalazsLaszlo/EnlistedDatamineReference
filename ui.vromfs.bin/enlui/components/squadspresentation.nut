const ICON_EVENT = "ui/skin#icons/event_squad_icon.svg"

let mkGenSquad = @(armyId) @(id, override = {}) {
  nameLocId = $"squad/{id}"
  titleLocId = $"regiment/{id}"
  manageLocId = $"regiment/{id}"
  announceLocId = $"squadannounce/{id}"
  summaryLocId = $"squadsummary/{id}"
  icon = $"ui/skin#squads/{armyId}/{id}_icon.svg"
  image = $"ui/soldiers/{armyId}/{id}_image.avif"
  
}.__update(override)

