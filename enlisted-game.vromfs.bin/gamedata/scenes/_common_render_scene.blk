entity{
  _template:t="lens_flare_dynamic_lights_settings"
}

entity{
  _template:t="dynamic_light_lens_flare"
  dynamic_light_lens_flare__flare_config:t="lens_flares_dynamic_lights_cinematic"
}

entity{
  _template:t="lens_glow_config"
  enabled:b=yes
  lens_glow_config__bloom_offset:r=-0.0001
  lens_glow_config__bloom_multiplier:r=0.25
  lens_glow_config__lens_flare_offset:r=-0.0001
  lens_glow_config__lens_flare_multiplier:r=10.0
  lens_glow_config__texture_intensity_multiplier:r=10.0
  lens_glow_config__texture_tint:p3=1.0, 1.0, 1.0

  "lens_glow_config__texture_variants:array"{

    "texture_variant:object"{
      target_res:ip2=1920, 1080
      texture:t="lens_glow_tex"
    }
  }
}

