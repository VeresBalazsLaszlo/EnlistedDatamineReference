      }

      "explosive:list<t>"{
        type:t="he_ball"
        type:t="he_i_ball"
        type:t="he_t_ball"
        type:t="he_i_t_ball"
        type:t="he_i"
        type:t="he_t"
        type:t="he_i_t"
