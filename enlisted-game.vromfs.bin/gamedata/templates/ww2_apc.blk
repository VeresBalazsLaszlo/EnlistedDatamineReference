apc_settings{
  _use:t="mobile_respawn"
  _use:t="vehicle_marker_ui"
  _use:t="hud_vehicle_marker"
  spotDestroyStatName:t="apcSpot"
  mobile_respawn__occupiedSeats:i=0
  _tracked:t="mobile_respawn__occupiedSeats"
  mobile_respawn__seatOffset:i=6
  canUseRespawnbaseType:t="APC"
  destroyIfNoCrewLeft:b=no
  fire_damage__timeToExplosion:r=20.0
  item__iconYaw:r=25.0
  item__iconPitch:r=-3.0
  item__iconRoll:r=15.0
  vehicle_seats__exitTime:r=1.0
  vehicle_seats__enterTime:r=2.0
  driverFpsCamMaxAngle:p2=90.0, 50.0
  commanderFpsCamMaxAngle:p2=90.0, 50.0
  passengerFpsCamMaxAngle:p2=90.0, 50.0
  vehicle_kill_assist__stat:t="apcKillAssists"
  vehicle_kill_assist__crewStat:t="apcKillAssistsAsCrew"
  vehicle_kill_assist__engineerStat:t="builtGunApcKillAssists"
  vehicle_kill_assist__time:r=20.0
  vehicle_kill__award:t="apcKill"
  vehicle_kill__stat:t="apcKills"
  vehicle_kill__crewStat:t="crewApcKillAssists"
  vehicle_kill__engineerStat:t="builtGunApcKills"
  vehicle__mapIcon:t="truck_icon"
  user_point__icon:t="truck_icon"

  _group{
    _tags:t="render"
    exhaust_fx__fx:t="car_exhaust_template"
    exhaust_fx__brokenFx:t="car_broken_exhaust_template"
  }

  _group{
    _tags:t="server"
    friendly_fire__penaltyCooldown:r=5.0
    friendly_fire__damageThreshold:r=10.0

    "friendly_fire__lastPenaltyTime:object"{
    }
  }

  "ownedBySquad:eid"{
  }

  "ownedByPlayer:eid"{
  }

  "vehicleOffenders:object"{
    _tags:t="server"
  }
}