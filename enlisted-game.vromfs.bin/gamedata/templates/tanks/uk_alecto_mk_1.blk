uk_alecto_mk_1{
  _use:t="uk_alecto_mk_1_common"

  "turrets__initAmmoDistribution:array"{

    "ammo:object"{
      slot:i=0
      fill:b=yes
    }

    "ammo:object"{
      slot:i=1
      fill:b=yes
    }

    "ammo:object"{
      slot:i=2
      count:i=7
    }
  }
}

uk_alecto_mk_1_common{
  _use:t="base_alecto_mk_1"
  _use:t="uk_daimler_mk_2_common_vehicle_sound"
  _use:t="vehicle_anim_steering_deflection"
  commanderCockpitFpsCamMaxAngle:p2=40.0, 5.0
  gunner_cam_limit__useCockpitDir:b=yes
  gunnerFpsCamMaxAngle:p2=8.0, 5.0
  item__iconOffset:p2=0.1, 0.2
  item__iconScale:r=1.3

  "disableDMParts:list<t>"{
    part:t="gunner"
    part:t="loader"
    part:t="commander"
    part:t="machine_gunner"
    part:t="driver"
  }

  _group{
    _tags:t="render"
    animchar_camera_target__node_name:t="bone_camera_gunner"
    animchar_camera_target__node_offset:p3=0.0, 1.0, 0.0
    animchar_camera_target__nodeIndex:i=-1
  }

  "vehicle_seats__seatsProvideOrder:tag"{
  }

  "vehicle_seats__seats:shared:array"{

    "seats:object"{
      name:t="commander"
      nextSeat:t="main_gunner"
      locName:t="vehicle_seats/commander"
      attachNode:t="commander"
      shouldHideOwner:b=no
      maxPosWithOpenHatch:r=0.4
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.8802963, 0.0, 0.1871122] [-0.0, 0.8999722, 0.0] [-0.1871237, -0.0, 0.8803505] [-0.28, -0.31, -0.03]]
      cameraType:t="commander"
      seatComponent:t="isDriver"
      receiveDamageFromDMPart:t="commander"
      seatAnimUpper:t="drive_passenger"
      seatAnimLower:t="drive_passenger"
      cameraOffset:p3=-0.3, -0.4, -0.0
      isHoldGunModeAllowed:b=no

      "effectors:object"{
        r.hand:t="righthand_3"
        l.hand:t="lefthand_3"
        r.foot:t="pedal_rfoot_3"
        l.foot:t="pedal_lfoot_3"
      }
    }

    "seats:object"{
      name:t="main_gunner"
      locName:t="vehicle_seats/gunner"
      attachNode:t="gunner"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.9, 0.0, 0.0] [0.0, 0.9, 0.0] [0.0, 0.0, 0.9] [-0.24, -0.29, -0.05]]
      seatComponent:t="isGunner"
      nextSeat:t="driver"
      shouldHideOwner:b=no
      receiveDamageFromDMPart:t="gunner"
      cameraNodeName:t="bone_camera_gunner"
      cockpitTemplate:t="uk_alecto_mk_1_gunner_cockpit"
      isHoldGunModeAllowed:b=no

      "turretNames:array"{
        turret:t="turret_01"
      }

      "effectors:object"{
        r.hand:t="righthand_4"
        l.hand:t="lefthand_4"
        r.foot:t="pedal_rfoot_4"
        l.foot:t="pedal_lfoot_4"
      }
    }

    "seats:object"{
      name:t="driver"
      locName:t="vehicle_seats/driver"
      seatOwnsEntityControl:b=yes
      attachNode:t="driver"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.9, 0.0, 0.0] [0.0, 0.9, 0.0] [0.0, 0.0, 0.9] [-0.25, -0.3, 0.0]]
      seatComponent:t="isDriver"
      shouldHideOwner:b=no
      receiveDamageFromDMPart:t="driver"
      cameraNodeName:t="bone_camera_driver"
      cockpitTemplate:t="uk_alecto_mk_1_driver_cockpit"
      seatAnimUpper:t="drive_passenger"
      seatAnimLower:t="drive_passenger"
      isHoldGunModeAllowed:b=no

      "effectors:object"{
        r.foot:t="pedal_rfoot_1"
        l.foot:t="pedal_lfoot_1"

        "l.hand:object"{
          rel_tm:m=[[0.1505963, 0.7656964, -0.6253238] [-0.9749484, 0.2197693, 0.03430666] [0.1636953, 0.6044919, 0.7796111] [0.01336288, -0.2691956, 0.1416855]]
          node:t="bone_roll_driver"
        }

        "r.hand:object"{
          rel_tm:m=[[0.5836952, 0.6345291, 0.5066292] [-0.7758859, 0.6198106, 0.1176268] [-0.2393763, -0.4617445, 0.8541024] [-0.01674652, -0.2707367, -0.1474686]]
          node:t="bone_roll_driver"
        }
      }
    }

    "seats:object"{
      name:t="loader"
      canPlaceManually:b=no
      locName:t="vehicle_seats/loader"
      attachNode:t="loader"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.8912461, 0.0, -0.1252556] [0.0, 0.9000047, 0.0] [0.1252556, 0.0, 0.8912457] [-0.33, -0.31, 0.0]]
      seatComponent:t="isPassenger"
      shouldHideOwner:b=no
      receiveDamageFromDMPart:t="loader"
      cameraNodeName:t="bone_camera_driver"
      isHoldGunModeAllowed:b=no

      "loaderTurretNames:array"{
        turret:t="turret_01"
      }

      "effectors:object"{
        r.hand:t="righthand_2"
        l.hand:t="lefthand_2"
        r.foot:t="pedal_rfoot_2"
        l.foot:t="pedal_lfoot_2"
      }
    }
  }
}

uk_alecto_mk_1_gunner_cockpit{
  _use:t="base_gunner_cockpit"
  animchar__res:t="t_26_1940_gunner_char"
  cockpit__offset:p3=-0.5, 0.35, 0.33

  "cockpit__cockpitOffsetBySlit:list<p3>"{
    item:p3=-0.1, -0.1, -0.1
  }

  "cockpit__slitForwardOffset:list<r>"{
    slit:r=0.15
  }

  "cockpit__attachNodeNames:list<t>"{
    node:t="bone_gun_barrel"
  }

  "cockpit__attachNodeIndices:list<i>"{
  }

  "cockpit__visibleVehicleNodeNames:list<t>"{
    node:t="gun_barrel"
    node:t="bone_gun"
    node:t="bone_turret"
  }

  "cockpit__slitNodeNames:list<t>"{
    slit:t="cam_front_right"
  }

  "cockpit__slitIsGun:list<b>"{
    slit:b=yes
  }

  "cockpit__slitZoom:array"{

    "slit:list<r>"{
      zoom:r=4.5
      zoom:r=5.0
    }
  }

  "cockpit__slitZoomTime:list<r>"{
    slit:r=0.05
  }

  "cockpit__slitTemplates:list<t>"{
    slit:t="uk_no_33_mkii_s"
  }

  "cockpit__slitEids:list<eid>"{
  }
}

uk_alecto_mk_1_driver_cockpit{
  _use:t="base_driver_cockpit_no_slits"
  animchar__res:t="pzkpfw_iii_e_driver_char"
  cockpit__offset:p3=-0.33, -0.2, -0.0
  cockpit__minForwardOffset:r=-0.05
  cockpit__slitTransitionDuration:r=0.0
  cockpit__simplifiedRender:b=yes

  "cockpit__visibleVehicleNodeNames:list<t>"{
    node:t="track_l"
    node:t="track_r"
    node:t="@root"
    node:t="bone_turret"
    node:t="bone_gun"
    node:t="gun_barrel"
    node:t="optic_gun"
  }

  "cockpit__slitForwardOffset:list<r>"{
    slit:r=-0.05
  }

  "cockpit__slitIsGun:list<b>"{
    slit:b=no
  }

  "cockpit__slitNodeNames:list<t>"{
    slit:t="cam_front"
  }
}