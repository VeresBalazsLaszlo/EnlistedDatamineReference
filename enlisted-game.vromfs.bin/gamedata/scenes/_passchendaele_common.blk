entity{
  _template:t="water"
  shore__amplitude_to_length:r=800.0
  shore__hmap_size:r=512.0
  shore__parallelism_to_wind:r=0.5
  shore__rivers_width:r=30.0
  shore__texture_size:i=512
  shore__wave_gspeed:r=0.0
  shore__waves_dist:p4=20.0, 10.0, 1.0, 50.0
  shore__width_k:r=0.6
  waterTrail__useObstacle:b=yes
  water__level:r=0.0
  water__strength:r=0.0
  water__wind_dir:r=-90.0
  water__wind_strength:r=0.0
  water__smallWaterAIWalkHeight:r=0.5
  water__deepWaterAIAreaCost:r=2.0
  water__flowmap:b=yes
  water__flowmap_tex:t="manchuria_water_det_flowmap"
  water__flowmap_area:p4=-1024.0, 1024.0, 1024.0, -1024.0
  water__flowmap_foam_depth_max:r=3.0
  water__flowmap_foam_power:r=0.4
  water__flowmap_foam_scale:r=0.73
  water__flowmap_foam_softness:r=2.0
  water__flowmap_foam_speed_scale:r=6.5
  water__flowmap_foam_tiling:r=0.38
  water__flowmap_prebaked_speed:r=5.0
}

