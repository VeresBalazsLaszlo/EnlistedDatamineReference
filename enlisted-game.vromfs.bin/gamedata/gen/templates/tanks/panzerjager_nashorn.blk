base_panzerjager_nashorn{
  _use:t="base_tank"
  _use:t="panzerjager_nashorn_ammo_stowages"
  _use:t="vehicle_physical_tracks"
  killLogName:t="germ_panzerjager_nashorn"
  animchar__res:t="panzerjager_nashorn_char"
  animchar_fast_phys__res:t="panzerjager_nashorn_fastphys"
  collres__res:t="panzerjager_nashorn_collision"
  vehicle_net_phys__blk:t="gamedata/gen/units/tanks/panzerjager_nashorn.blk:VehiclePhys"
  particle_phys__blk:t="gamedata/gen/units/tanks/panzerjager_nashorn.blk:PhysSys"
  dmg_animchar__res:t="panzerjager_nashorn_dmg_char"
  xray_resource__modelName:t="panzerjager_nashorn"
  cockpit__zoomOutFov:r=7.7525
  cockpit__zoomInFov:r=14.3007
  cockpit__sightName:t="sight_model/zfl_zf_1a"
  cockpit__sightFov:r=7.35
  drowningHeight:r=2.352
  damage_model__blk:t="gamedata/gen/units/tanks/panzerjager_nashorn.blk"
  item__name:t="items/germ_panzerjager_nashorn"
  physical_tracks__blk:t="gamedata/gen/units/tanks/panzerjager_nashorn.blk"
  skin__template:t="panzerjager_nashorn_skins"
  losable_turret__detachBone:t="bone_turret"
  losable_turret__detachCollNode:t="cls_gun"
  losable_turret__mass:r=7000.0
  losable_turret__deviation:r=0.5
  losable_turret__rotation:r=0.5
  fire_damage__openHatchesOnExplosion:b=yes

  animchar_fast_phys{
    _tags:t="gameClient"
  }

  "turret_gun_flash_fx__flashNodes:shared:array"{
    node:t="emtr_gun_flame"
    node:t="emtr_mg_flame_01"
    node:t="emtr_mg_flame_02"
  }

  "turret_gun_flash_fx__flashFx:shared:array"{
    fx:t="muzzle_ground_100mm_brake"
    fx:t="muzzle_ground_8mm"
    fx:t="muzzle_ground_8mm"
  }

  "turret_gun_flash_fx__flashFxScale:shared:array"{
    scale:r=1.0
    scale:r=1.0
    scale:r=1.0
  }

  "turret_control__emitterNodes:shared:array"{
    node:t="bone_gun_barrel"
    node:t="bone_mg_v_01"
    node:t="bone_mg_v_02"
  }

  "turret_control__animVars:shared:array"{

    "vars:object"{
      curYawParamName:t="turret_01_yaw"
      curPitchParamName:t="gun_01_pitch"
      aimActiveParamName:t="aim_01_active"
      paramYawSpeed:t="turret_01_yaw_speed"
      paramYawSpeedMul:t="turret_01_yaw_mul"
      paramYawAccel:t="turret_01_yaw_accel"
      paramMinYawAngle:t="turret_01_min_yaw_angle"
      paramMaxYawAngle:t="turret_01_max_yaw_angle"
      paramMinPitchAngle:t="turret_01_min_pitch_angle"
      paramMaxPitchAngle:t="turret_01_max_pitch_angle"
      paramPitchSpeed:t="gun_01_pitch_speed"
      paramPitchSpeedMul:t="gun_01_pitch_mul"
      paramPitchAccel:t="gun_01_pitch_accel"
      wishYawParamName:t="gun_01_aim:targetYaw"
      wishPitchParamName:t="gun_01_aim:targetPitch"
      gunRecoilParamName:t="gun_01_recoil"
    }

    "vars:object"{
      curYawParamName:t="turret_02_yaw"
      curPitchParamName:t="gun_02_pitch"
      aimActiveParamName:t="aim_02_active"
      paramYawSpeed:t="turret_02_yaw_speed"
      paramYawSpeedMul:t="turret_02_yaw_mul"
      paramYawAccel:t="turret_02_yaw_accel"
      paramMinYawAngle:t="turret_02_min_yaw_angle"
      paramMaxYawAngle:t="turret_02_max_yaw_angle"
      paramMinPitchAngle:t="turret_02_min_pitch_angle"
      paramMaxPitchAngle:t="turret_02_max_pitch_angle"
      paramPitchSpeed:t="gun_02_pitch_speed"
      paramPitchSpeedMul:t="gun_02_pitch_mul"
      paramPitchAccel:t="gun_02_pitch_accel"
      wishYawParamName:t="gun_02_aim:targetYaw"
      wishPitchParamName:t="gun_02_aim:targetPitch"
    }

    "vars:object"{
      curYawParamName:t="turret_03_yaw"
      curPitchParamName:t="gun_03_pitch"
      aimActiveParamName:t="aim_03_active"
      paramYawSpeed:t="turret_03_yaw_speed"
      paramYawSpeedMul:t="turret_03_yaw_mul"
      paramYawAccel:t="turret_03_yaw_accel"
      paramMinYawAngle:t="turret_03_min_yaw_angle"
      paramMaxYawAngle:t="turret_03_max_yaw_angle"
      paramMinPitchAngle:t="turret_03_min_pitch_angle"
      paramMaxPitchAngle:t="turret_03_max_pitch_angle"
      paramPitchSpeed:t="gun_03_pitch_speed"
      paramPitchSpeedMul:t="gun_03_pitch_mul"
      paramPitchAccel:t="gun_03_pitch_accel"
      wishYawParamName:t="gun_03_aim:targetYaw"
      wishPitchParamName:t="gun_03_aim:targetPitch"
    }
  }

  "turret_control__turretInfo:shared:array"{

    "turretInfo:object"{
      turretName:t="turret_01"
      gun:t="panzerjager_nashorn_turret_01_88mm_pak43_open_turret+turret_with_several_types_of_shells+main_turret"
      barrelDm:t="gun_barrel"
      breechDm:t="cannon_breech"
      verDriveDm:t="drive_turret_v"
      horDriveDm:t="drive_turret_h"
      salt:i=1
    }

    "turretInfo:object"{
      turretName:t="turret_02"
      gun:t="panzerjager_nashorn_turret_02_7_92mm_mg34"
      barrelDm:t="gun_barrel_01"
      salt:i=1
    }

    "turretInfo:object"{
      turretName:t="turret_03"
      gun:t="panzerjager_nashorn_turret_03_7_92mm_mg34"
      barrelDm:t="gun_barrel_02"
      salt:i=1
    }
  }
}

panzerjager_nashorn_turret_01_88mm_pak43_open_turret{
  _use:t="tankgun_88mm_pak43_open_turret"
  gun__shootNodeName:t="bone_gun_barrel"
  turret__yawSpeed:r=12.0
  turret__pitchSpeed:r=4.0
  turret__aimNodeName:t="bone_turret"
  turret__limit:p4=-15.0, 15.0, -5.0, 20.0
  gun__shotFreq:r=0.15

  "gun__shellsAmmo:array"{
    ammo:i=10
    ammo:i=10
    ammo:i=10
    ammo:i=10
  }
}

panzerjager_nashorn_turret_02_7_92mm_mg34{
  _use:t="tankgun_7_92mm_mg34"
  gun__shootNodeName:t="bone_mg_v_01"
  turret__yawSpeed:r=90.0
  turret__pitchSpeed:r=90.0
  turret__aimNodeName:t="bone_mg_h_01"
  turret__limit:p4=-145.0, -45.0, -10.0, 2.0

  "gun__shellsAmmo:array"{
    ammo:i=1275
    ammo:i=1275
  }

  "controlledByTankAiGunnerWithBot:tag"{
  }
}

panzerjager_nashorn_turret_03_7_92mm_mg34{
  _use:t="tankgun_7_92mm_mg34"
  gun__shootNodeName:t="bone_mg_v_02"
  turret__yawSpeed:r=90.0
  turret__pitchSpeed:r=90.0
  turret__aimNodeName:t="bone_mg_h_02"
  turret__limit:p4=45.0, 145.0, -10.0, 2.0

  "gun__shellsAmmo:array"{
    ammo:i=1275
    ammo:i=1275
  }

  "controlledByTankAiGunnerWithBot:tag"{
  }
}

panzerjager_nashorn_ammo_stowages{
  _tags:t="server"
  _use:t="vehicle_ammo_stowages"

  "ammo_stowage__stowageTemplates:shared:list<t>"{
    stowage:t="panzerjager_nashorn_ammo_stowage_1"
  }
}

panzerjager_nashorn_ammo_stowage_1{
  _use:t="ammo_stowage"

  "ammo_stowage__clusterTemplates:shared:list<t>"{
    cluster:t="panzerjager_nashorn_ammo_cluster_1_1"
  }

  "ammo_stowage__turretNames:shared:list<t>"{
    gun:t="turret_01"
  }
}

panzerjager_nashorn_ammo_cluster_1_1{
  _use:t="ammo_cluster"
  ammo_cluster__isShell:b=yes

  "ammo_cluster__slotNames:shared:list<t>"{
    part:t="ammo_turret_01"
    part:t="ammo_turret_02"
    part:t="ammo_body_02"
    part:t="ammo_body_01"
  }

  "ammo_cluster__slotsMaxAmmo:list<i>"{
    count:i=8
    count:i=8
    count:i=4
    count:i=20
  }
}