import:t="motorcycles/guns/bike_7_92mm_bren.blk"
import:t="motorcycles/guns/bike_7_92mm_mg34.blk"
import:t="motorcycles/guns/bike_7_62mm_m1919a4.blk"
import:t="motorcycles/guns/bike_7_62mm_dp.blk"
import:t="motorcycles/guns/bike_7_62mm_ds39.blk"
import:t="motorcycles/guns/bike_7_7mm_type_89_te_4.blk"
import:t="motorcycles/guns/bike_14_5mm_ptrs41.blk"
import:t="motorcycles/guns/bike_6_5mm_type_11.blk"
