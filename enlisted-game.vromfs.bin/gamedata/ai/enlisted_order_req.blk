orderedSelector{
  name:t="sub.mortarAttackReq"

  isVarsIntEqual{
    lhs:t="mortarAttack"
    rhs_value:i=2
  }

  isVarsIntEqual{
    lhs:t="mortarAttack"
    rhs_value:i=-1
  }

  sequencer{

    reaction{
      event:t="onEnemyPlayerNear"

      sequencer{

        findDanger{
          paramName:t="shootEnemy"
          outSeeTimeParam:t="shootEnemyTime"
          radiusParamName:t="enemyNearRadius"
          minDanger:r=0.1
          tag:t="human"
        }

        setIntVar{
          to:t="mortarAttack"
          value:i=-1
        }

        setDebugSym{
          r:i=405
        }

        recalculateTree{
        }
      }
    }

    reaction{
      event:t="regularCheck"

      sequencer{

        isVarsIntEqual{
          lhs:t="mortarAttack"
          rhs_value:i=1
        }

        repeat{
          count:i=1

          subTree{
            name:t=""
            treeName:t="sub.chooseMaxStance"
          }

          subTree{
            name:t=""
            treeName:t="sub.deactivateWeapMod"
          }

          subTree{
            name:t=""
            treeName:t="sub.checkDowned"
          }

          subTree{
            name:t=""
            treeName:t="sub.checkBurning"
          }

          subTree{
            name:t=""
            treeName:t="sub.swimUpCheck"
          }

          subTree{
            name:t=""
            treeName:t="sub.tryToOpenDoors"
          }

          subTree{
            name:t=""
            treeName:t="sub.findDangerZone"
          }

          subTree{
            name:t=""
            treeName:t="sub.findDangerGrenade"
          }
        }
      }
    }

    detachFromStationaryGun{
    }

    findWeaponSlotWithTag{
      tag:t="mortar"
      toParam:t="mortarSlot"
      minAmmo:i=1
    }

    changeWeapon{
      param:t="mortarSlot"
    }

    wait{
      range:p2=1.0, 1.0
      resetable:b=yes
    }

    setCurrentAiAction{
      state:t="move"
    }

    setCurrentAiAction{
      state:t="attack"
    }

    copyPoint3Var{
      from:t="mortarAttackFromPos"
      to:t="wishPosition"
    }

    setIntVar{
      to:t="regroupToPit"
      value:i=0
    }

    setIntVar{
      to:t="mortarAttack"
      value:i=2
    }

    subTree{
      treeName:t="sub.tryMoveToWishPosition"
    }

    canShootAtPointWithMortar{
      gunSlotParam:t="mortarSlot"
      posParam:t="mortarAttackToPos"
      traceRatio:r=1.0
    }

    rotateToPoint{
      posParam:t="mortarAttackToPos"
      maxSimAngle:p2=50.0, 70.0
    }

    shootAtPointWithMortar{
      posParam:t="mortarAttackToPos"
      numShotsParam:t="mortarAttackShots"
    }
  }

  setIntVar{
    to:t="mortarAttack"
    value:i=-1
  }
}

orderedSelector{
  name:t="sub.useVehicleReq"

  sequencer{

    reaction{
      event:t="onEnemyPlayerNear"

      sequencer{

        findDanger{
          paramName:t="shootEnemy"
          outSeeTimeParam:t="shootEnemyTime"
          radiusParamName:t="enemyNearRadius"
          minDanger:r=0.1
          tag:t="human"
        }

        setDebugSym{
          r:i=405
        }

        recalculateTree{
        }
      }
    }

    reaction{
      event:t="regularCheck"

      repeat{
        count:i=1

        subTree{
          name:t=""
          treeName:t="sub.chooseMaxStance"
        }

        subTree{
          name:t=""
          treeName:t="sub.deactivateWeapMod"
        }

        subTree{
          name:t=""
          treeName:t="sub.checkDowned"
        }

        subTree{
          name:t=""
          treeName:t="sub.checkBurning"
        }

        subTree{
          name:t=""
          treeName:t="sub.swimUpCheck"
        }

        subTree{
          name:t=""
          treeName:t="sub.findDangerZone"
        }

        subTree{
          name:t=""
          treeName:t="sub.tryToOpenDoors"
        }

        subTree{
          name:t=""
          treeName:t="sub.findDangerGrenade"
        }
      }
    }

    setCurrentAiAction{
      state:t="move"
    }

    detachFromStationaryGun{
    }

    orderedSelector{

      sequencer{

        setPosFromEntity{
          to:t="wishPos"
          from:t="vehicleEid"
        }

        wait{
          range:p2=0.1, 0.3
          resetable:b=yes
        }

        moveToPos{
          posParam:t="wishPos"
          sprintTimerRange:p2=10.0, 20.0
          minDistToSprint:r=5.0
          tryClimbing:b=yes
          distThreshold:r=2.5
          avoidAiObstacles:b=no
          incLadders:b=yes
          jumpDownTraceCheck:p3=0.4, 1.0, 0.15
        }

        orderedSelector{

          useVehicle{
            targetUnitParam:t="vehicleEid"
          }

          resetShoulUseVehicleTrigger{
          }
        }
      }

      sequencer{

        setTransformPosFromEntity{
          to:t="wishPos"
          from:t="vehicleEid"
        }

        changeStance{
          stanceName:t="stand"
          maxStanceParam:t="maxStance"
        }

        changeStance{
          stanceName:t="stand"
          maxStanceParam:t="maxStanceOrder"
        }

        moveByDir{
          endPos:t="wishPos"
          duration:r=1.5
          distThresholsd:r=2.5
        }

        orderedSelector{

          useVehicle{
            targetUnitParam:t="vehicleEid"
          }

          resetShoulUseVehicleTrigger{
          }
        }
      }
    }
  }
}

exitHandler{
  name:t="sub.buildReq"

  orderedSelector{

    sequencer{

      reaction{
        event:t="onEnemyPlayerNear"

        sequencer{

          findDanger{
            paramName:t="shootEnemy"
            outSeeTimeParam:t="shootEnemyTime"
            radiusParamName:t="enemyNearRadius"
            minDanger:r=0.1
            tag:t="human"
          }

          setDebugSym{
            r:i=405
          }

          recalculateTree{
          }
        }
      }

      reaction{
        event:t="regularCheck"

        repeat{
          count:i=1

          subTree{
            name:t=""
            treeName:t="sub.chooseMaxStance"
          }

          subTree{
            name:t=""
            treeName:t="sub.deactivateWeapMod"
          }

          subTree{
            name:t=""
            treeName:t="sub.checkDowned"
          }

          subTree{
            name:t=""
            treeName:t="sub.checkBurning"
          }

          subTree{
            name:t=""
            treeName:t="sub.swimUpCheck"
          }

          subTree{
            name:t=""
            treeName:t="sub.findDangerZone"
          }

          subTree{
            name:t=""
            treeName:t="sub.tryToOpenDoors"
          }

          subTree{
            name:t=""
            treeName:t="sub.findDangerGrenade"
          }
        }
      }

      checkTarget{
        targetUnitParam:t="buildTarget"
        ignoreDead:b=no
      }

      orderedSelector{

        isVarsIntEqual{
          lhs:t="buildPositionFounded"
          rhs_value:i=1
        }

        findPointNearTarget{
          posParam:t="buildPosition"
          dist:p2=2.0, 2.5
          targetParam:t="buildTarget"
          traceTarget:b=no
          reusePrevPos:b=no
        }
      }

      orderedSelector{

        sequencer{

          findWeaponSlotWithTag{
            tag:t="buildingTool"
            toParam:t="buildToolSlot"
          }

          changeWeapon{
            param:t="buildToolSlot"
          }
        }

        continue{
        }
      }

      setIntVar{
        to:t="buildPositionFounded"
        value:i=1
      }

      setIntVar{
        to:t="buildTarget"
        value:i=0
      }

      setCurrentAiAction{
        state:t="move"
      }

      detachFromStationaryGun{
      }

      moveToPos{
        posParam:t="buildPosition"
        sprintTimerRange:p2=10.0, 20.0
        minDistToSprint:r=4.0
        distThreshold:r=0.5
        rotateDistThreshold:r=0.5
        rotateFactors:p4=0.5, 0.3, 0.3, 0.1
        rotateStartTime:r=0.5
        avoidAiObstacles:b=no
        incObstacles:b=no
        incLadders:b=yes
        jumpDownTraceCheck:p3=0.4, 1.0, 0.15
      }

      wait{
        range:p2=1.0, 1.0
        resetable:b=yes
      }

      parallel{

        reaction{
          event:t="regularCheck"

          repeat{
            count:i=1

            subTree{
              name:t=""
              treeName:t="sub.chooseMaxStance"
            }

            subTree{
              name:t=""
              treeName:t="sub.deactivateWeapMod"
            }

            subTree{
              name:t=""
              treeName:t="sub.checkDowned"
            }

            subTree{
              name:t=""
              treeName:t="sub.checkBurning"
            }

            subTree{
              name:t=""
              treeName:t="sub.swimUpCheck"
            }

            subTree{
              name:t=""
              treeName:t="sub.tryToOpenDoors"
            }

            subTree{
              name:t=""
              treeName:t="sub.findDangerZone"
            }

            subTree{
              name:t=""
              treeName:t="sub.findDangerGrenade"
            }

            sequencer{

              not{

                checkDistance{
                  posParam:t="buildPosition"
                  radius:r=1.5
                  yRadius:r=1.0
                }
              }

              setDebugSym{
                r:i=505
              }

              recalculateTree{
              }
            }
          }
        }

        lookAtTarget{
          targetUnitParam:t="buildTarget"
          rotateBody:b=yes
          allowDead:b=yes
        }

        interactWithBuildingTarget{
          targetUnitParam:t="buildTarget"
        }
      }

      chooseBestWeapon{
        targetParam:t="shootEnemy"
      }
    }

    sequencer{

      setIntVar{
        to:t="buildTarget"
        value:i=0
      }

      chooseBestWeapon{
        targetParam:t="shootEnemy"
      }
    }
  }

  chooseBestWeapon{
    targetParam:t="shootEnemy"
  }
}