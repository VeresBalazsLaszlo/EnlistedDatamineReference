entity{
  _template:t="local_tone_mapping"
  local_tone_mapping__hq_enabled:b=yes
  local_tone_mapping__hq_highlights_multiplier:r=2.25
  local_tone_mapping__hq_shadows_multiplier:r=0.25
  local_tone_mapping__hq_sigma:r=0.2
  local_tone_mapping__lq_highlights_multiplier:r=2.5
  local_tone_mapping__lq_shadows_multiplier:r=0.75
  local_tone_mapping__lq_display_mip:i=3
  local_tone_mapping__lq_sigma:r=0.2
  local_tone_mapping__middle_luminance:r=0.1
  local_tone_mapping__display_mip:i=4
}

