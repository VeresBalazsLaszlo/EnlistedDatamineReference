  }

  "soundStepSettings:tag"{
  }
}

human_idle_sound{

  _group{
    _tags:t="sound"

    "human_idle_sound__event:SoundEvent"{
    }

    "humanIdleSound:tag"{
    }

    "human_idle_sound__paths:shared:object"{
    }
  }
}

human_idle_active_sound{
  _use:t="human_idle_sound"
  _tracked:t="human_idle_sound__isActive"

  _group{
    _tags:t="sound"
    human_idle_sound__isActive:b=no
  }
}

human_voice_effects{
  _tracked:t="human_voice_effect__isActive"
  _tracked:t="human_voice_effect__activeEffects"

  _group{
    _tags:t="server"
    human_net_voice_effect__nextTime:r=0.0
    human_net_voice_effect__cooldown:r=1.0
    human_net_voice_effect__range:r=50.0
  }

  _group{
    _tags:t="sound"
    human_voice_effect__type:t=""
    human_voice_effect__oneshotType:t=""
    human_voice_effect__isInited:b=no
    human_voice_effect__isActive:b=no

    "human_voice_effect__activeEffects:object"{
    }

    "human_voice_effect__event:SoundEvent"{
    }

    "human_voice_effect__oneshotEvent:SoundEvent"{
    }

    "human_voice_effect__allOrderedEffects:shared:list<t>"{
    }
  }
}

human_voice_effect_assigned{

  _group{
    _tags:t="sound"
    human_voice_effect_assigned__effect:t=""
    human_voice_effect_assigned__onDisappear:t=""
  }
}

human_voice_effect_underwater{

  "humanVoiceEffectUnderwater:tag"{
    _tags:t="sound"
  }
}

base_human_collision_scrape_sound{
  human_collision_scrape_sound__descIdx:i=-1
  _replicated:t="human_collision_scrape_sound__descIdx"

  _group{
    _tags:t="server"

    "human_collision_scrape_net_sound__physmatIds:list<i>"{
    }

    "human_collision_scrape_net_sound__physmatNames:shared:list<t>"{
      name:t="bushes"
      name:t="bushes_fall"
      name:t="bushes_palm"
      name:t="bushes_dead"
      name:t="bushes_snow"
    }
  }

  _group{
    _tags:t="sound"
    human_collision_scrape_sound__speedToForce:p4=0.04, 3.0, 0.0, 1.0
    human_collision_scrape_sound__cooldown:r=0.1
    human_collision_scrape_sound__nextTime:r=0.0

    "human_collision_scrape_sound__descs:shared:array"{

      "bush:object"{
        path:t="/walker/ww2_soldier/collision/bush"
      }

      "bushesFall:object"{
        path:t="/walker/ww2_soldier/collision/bush"
      }

      "bushesPalm:object"{
        path:t="/walker/ww2_soldier/collision/bush"
      }

      "bushesDead:object"{
        path:t="/walker/ww2_soldier/collision/bush"
      }

      "bushesSnow:object"{
        path:t="/walker/ww2_soldier/collision/bush"
      }
    }
  }
}