        sequencer{

          checkAtTime{
            timeParam:t="shootEnemyTime"
            range:p2=0.0, 7.0
          }

          checkTarget{
            targetUnitParam:t="shootEnemy"
          }

          setPosFromEntity{
            to:t="lookPos"
            from:t="shootEnemy"
          }
        }

        sequencer{

          checkAtTime{
            timeParam:t="shootEnemyTime"
            range:p2=10.0, 1000000.0
          }

          findPotentialEnemyPos{
            posParam:t="lookPos"
            minNoiseLevel:r=3.0
          }
        }

        sequencer{

          checkAtTime{
            timeParam:t="shootEnemyTime"
            range:p2=10.0, 1000000.0
          }

          findDangerAttractionPos{
            posParam:t="lookPos"
            radius:r=0.0
            minNoiseLevel:r=3.0
          }
        }

        sequencer{

          checkAtTime{
            timeParam:t="shootEnemyTime"
            range:p2=10.0, 1000000.0
          }

          copyPoint3Var{
            to:t="lookPos"
            from:t="wishPosition"
          }
        }
      }

      orderedSelector{

        isLookingToPos{
          posParam:t="lookPos"
          offAngle:r=15.0
        }

        rotateToPoint{
          posParam:t="lookPos"
          aimSpeedCoef:r=0.9
          maxSimAngle:p2=60.0, 80.0
          pitchRange:p2=-5.0, 5.0
          minSimAngle:r=15.0
          minSimSpeedCoef:r=0.5
        }
      }

      setDebugSym{
        act:t="z10"
      }

      fixLookDirPos{
        posParam:t="lookPos"
        goodLookDist:r=10.0
      }
    }

    sequencer{

      isVarsIntEqual{
        lhs:t="dangerNearbyBeware"
        rhs_value:i=0
      }

      checkAtTime{
        timeParam:t="shootEnemyTime"
        range:p2=10.0, 1000000.0
      }

      orderedSelector{

        sequencer{

          or{

            not{

              isPointAhead{
                posParam:t="wishPosition"
              }
            }

            ignoreChance{
              chance:r=0.5
            }
          }

          sequencer{

            setDebugSym{
              act:t="z20"
            }

            orderedSelector{

              isLookingToPos{
                posParam:t="wishPosition"
                offAngle:r=15.0
              }

              rotateToPoint{
                posParam:t="wishPosition"
                aimSpeedCoef:r=0.9
                maxSimAngle:p2=75.0, 90.0
                pitchRange:p2=-5.0, 5.0
                minSimAngle:r=15.0
                minSimSpeedCoef:r=0.75
              }
            }
          }
        }

        sequencer{

          setDebugSym{
            act:t="z30"
          }

          orderedSelector{

            isLookingToPos{
              posParam:t="wishPosition"
              offAngle:r=15.0
            }

            rotateToPoint{
              posParam:t="wishPosition"
              aimSpeedCoef:r=0.9
              maxSimAngle:p2=75.0, 90.0
              pitchRange:p2=-5.0, 5.0
              minSimAngle:r=10.0
              minSimSpeedCoef:r=0.5
            }
          }
        }
      }
    }
  }
}

sequencer{
  name:t="sub.tryTurnToLastEnemyAfterMove"

  setDebugSym{
    act:t="z9"
  }

  orderedSelector{

    isVarsIntEqual{
      lhs:t="rememberEnemy"
      rhs_value:i=0
    }

    checkDistance{
      posParam:t="rememberEnemyPos"
      radius:r=2.0
      yRadius:r=3.0
    }

    not{

      checkAtTime{
        timeParam:t="rememberEnemyTime"
        range:p2=0.0, 15.0
      }
    }

    and{

      findDanger{
        paramName:t="otherEnemy"
        outSeeTimeParam:t="otherEnemyTime"
        radiusParamName:t="enemyRadius"
        minDanger:r=0.1
        tag:t="human"
      }

      not{

        isVarsIntEqual{
          lhs:t="otherEnemy"
          rhs:t="rememberEnemy"
        }
      }
    }

    orderedSelector{

      isLookingToPos{
        posParam:t="rememberEnemyPos"
        offAngle:r=15.0
      }

      rotateToPoint{
        posParam:t="rememberEnemyPos"
        aimSpeedCoef:r=0.5
        maxSimAngle:p2=60.0, 80.0
        minSimAngle:r=5.0
        minSimSpeedCoef:r=0.5
      }
    }
  }
}

sequencer{
  name:t="sub.moveToPosition"

  setDebugSym{
    act:t="z0"
  }

  wait{
    range:p2=0.1, 0.3
    resetable:b=yes
  }

  detachFromStationaryGun{
  }

  getAgentAIPos{
    outPosParam:t="moveFromPos"
  }

  orderedSelector{

    sequencer{

      orderedSelector{

        isOnNavmesh{
        }

        not{

          isVarsIntEqual{
            lhs:t="regroupToPit"
            rhs_value:i=0
          }
        }

        subTree{
          name:t=""
          treeName:t="sub.returnToNavmesh"
        }
      }

      subTree{
        treeName:t="sub.tryMoveToWishPosition"
      }

      setIntVar{
        to:t="resetAIPointsGenerator"
        value:i=1
      }

      success{

        subTree{
          treeName:t="sub.tryTurnToLastEnemyAfterMove"
        }
      }
    }

    sequencer{

      success{

        sequencer{

          isUnderwater{
          }

          findSwimUpPos{
            posParam:t="swimUpPos"
            swimUpDirParam:t="swimUpDir"
            radius:r=1.0
            tries:i=5
          }

          setDebugSym{
            act:t="z6"
          }

          setDebugSym{
            act:t="z7"
          }

          parallel{

            moveToPos{
              posParam:t="swimUpPos"
              sprintTimerRange:p2=10.0, 20.0
              minDistToSprint:r=10.0
              distThreshold:r=1.5
              avoidAiObstacles:b=yes
              jumpDownTraceCheck:p3=0.4, 1.0, 0.15
            }

            waitSwimUpPos{
              delay:r=0.1
              maxTime:r=4.0
              swimUpDirParam:t="swimUpDir"
            }
          }

          swimUp{
            swimUpDirParam:t="swimUpDir"
          }
        }
      }

      subTree{
        treeName:t="sub.tryMoveHarderToWishPosition"
      }

      setIntVar{
        to:t="resetAIPointsGenerator"
        value:i=1
      }
    }

    sequencer{

      or{

        isSwimming{
        }

        isUnderwater{
        }
      }

      not{

        checkDistance{
          posParam:t="wishPosition"
          radius:r=2.0
          yRadius:r=1.0
        }
      }

      setDebugSym{
        act:t="z8"
      }

      orderedSelector{

        moveByDir{
          endPos:t="wishPosition"
          duration:r=1.2
          distThresholsd:r=0.2
        }

        sequencer{

          findWayBackToNavmesh{
            outPosParam:t="outStuckPos"
          }

          moveByDir{
            endPos:t="outStuckPos"
            duration:r=1.2
            distThresholsd:r=0.2
          }
        }
      }

      setIntVar{
        to:t="resetAIPointsGenerator"
        value:i=1
      }
    }

    isUnderwater{
    }

    not{

      isVarsIntEqual{
        lhs:t="regroupToPit"
        rhs_value:i=0
      }
    }

    ifThenElse{

      and{

        isOnNavmesh{
        }

        not{

          isVarsIntEqual{
            lhs:t="resetAIPointsGenerator"
            rhs_value:i=2
          }
        }
      }

      failed{

        subTree{
          name:t=""
          treeName:t="sub.moveToUnstuck"
        }
      }

      failed{

        subTree{
          name:t=""
          treeName:t="sub.returnToNavmesh"
        }
      }
    }
  }
}

sequencer{
  name:t="sub.returnToNavmesh"

  wait{
    range:p2=0.1, 0.2
    resetable:b=yes
  }

  orderedSelector{

    sequencer{

      findWayBackToNavmesh{
        outPosParam:t="outStuckPos"
      }

      setDebugSym{
        act:t="z11"
      }

      setDebugSym{
        act:t="z12"
      }

      rotateToPoint{
        posParam:t="outStuckPos"
        aimSpeedCoef:r=0.9
        maxSimAngle:p2=70.0, 90.0
        forwBackChance:r=0.9
      }

      moveByDir{
        endPos:t="outStuckPos"
        duration:r=1.2
        distThresholsd:r=0.1
      }

      setIntVar{
        to:t="resetAIPointsGenerator"
        value:i=1
      }
    }

    setIntVar{
      to:t="resetAIPointsGenerator"
      value:i=1
    }
  }
}

sequencer{
  name:t="sub.moveToUnstuck"

  wait{
    range:p2=0.1, 0.2
    resetable:b=yes
  }

  orderedSelector{

    sequencer{

      getPointAroundAIPos{
        dirParam:t="stuckDir"
        outPosParam:t="outStuckPos"
        forwPosParam:t="outStuckForwPos"
        fromPosParam:t="moveFromPos"
        toPosParam:t="wishPosition"
        resetAIPointsGeneratorParam:t="resetAIPointsGenerator"
      }

      setDebugSym{
        act:t="z21"
      }

      setDebugSym{
        act:t="z22"
      }

      rotateToPoint{
        posParam:t="outStuckPos"
        aimSpeedCoef:r=0.9
        maxSimAngle:p2=70.0, 90.0
        forwBackChance:r=0.9
      }

      moveByDir{
        endPos:t="outStuckPos"
        duration:r=1.5
        distThresholsd:r=0.1
      }
    }

    setIntVar{
      to:t="resetAIPointsGenerator"
      value:i=2
    }
  }
}

sequencer{
  name:t="sub.stayInCover"

  reaction{
    event:t="userPointAdded"

    initPeriodicTimer{
      timeParam:t="findDangerAttrationPosTimer"
      timePeriod:p2=0.4, 0.9
    }
  }

  isInCover{
  }

  setCurrentAiAction{
    state:t="in_cover"
