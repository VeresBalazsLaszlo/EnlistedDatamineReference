    "templates:object"{
      preinited:b=yes
      relativeTm:m=[[0.999945, -0.00974138, -0.0076571] [-0.00767855, -0.00213998, -0.999918] [0.00972285, 0.999903, -0.00221468] [-1.4533, 0.705769, 0.671982]]
