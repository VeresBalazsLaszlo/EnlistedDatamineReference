    part:t="ammo_turret_09"
    part:t="ammo_turret_10"
  }

  "ammo_cluster__slotsMaxAmmo:list<i>"{
    count:i=1
    count:i=1
    count:i=1
    count:i=1
    count:i=1
    count:i=1
    count:i=1
    count:i=1
    count:i=1
    count:i=1
  }
}

