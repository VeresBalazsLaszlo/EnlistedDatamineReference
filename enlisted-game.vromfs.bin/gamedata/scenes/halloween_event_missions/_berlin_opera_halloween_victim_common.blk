entity{
  _template:t="berlin_level"
  level__blk:t="levels/battle_of_berlin_opera_halloween.blk"
  level__timeRange:p2=22.0, 23.0
  level__day:i=13
  level__month:i=6
  level__minimapDefaultVisibleRadius:i=75

  "level__weatherChoice:object"{
    weather_zombie_night_a:r=1.0
  }

  "level__timeVec:array"{
    level__timeVec:r=23.0
  }

  "level__renderFeaturesOverrides:object"{
    microdetails:b=yes
    clusteredLights:b=yes
    fullDeferred:b=yes
    contactShadows:b=yes
    wake:b=yes
    ripples:b=yes
    downsampledShadows:b=yes
  }
}

