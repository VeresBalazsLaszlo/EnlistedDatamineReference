    cls_body_01:r=0.5
    cls_turret_01:r=0.4
    cls_turret_02:r=0.1
  }

  tracks{
    animationMultiplier:r=0.68
    tracksTensionK:p3=5.0, 10.0, 3.5
    trackMesh:t="uk_cromwell_15_5_phys_track_line"
    trackLen:r=0.1
    trackCount:i=125
    trackFadeTime:r=1.1
    trackConnector:b=no
    trackEmitSparks:b=yes
    trackMaxHeight:r=1.1
    trackStartOffset:r=0.14
    height:r=0.062
    width:r=0.4
    trackMaxSinking:r=0.02
  }

  collisionProps{
    cls_turret_01:t="convex_hull"
    cls_turret_02:t="convex_hull"
    cls_body_01:t="convex_hull"
  }

  engine{
    horsePowers:r=600.0
    maxRPM:r=2550.0
    minRPM:r=600.0
  }

  mechanics{
    steerType:t="clutch_braking"
    maxBrakeForce:r=108000.0
    driveGearRadius:r=0.33
    mainGearRatio:r=0.874
    sideGearRatio:r=4.2
    neutralGearRatio:r=20.0

    gearRatios{
      ratio:r=-22.894
      ratio:r=0.0
      ratio:r=11.643
      ratio:r=4.593
      ratio:r=2.855
      ratio:r=1.807
      ratio:r=1.343
    }
  }

  suspension{
    suspensionOffsets:p3=-0.2, -0.17, 0.1
    defaultGearRadius:r=0.4
    frontBackGearRadius:r=0.2
    topGearRadius:r=0.1
    defaultDampeningForce:p2=81000.0, 81000.0
    dampeningRelaxationRatio:r=0.4
    dampeningCompressionRatio:r=0.15
    wheel_r_drive:r=0.305
    wheel_l_drive:r=0.305
    wheel_r_front:r=0.25
    wheel_l_front:r=0.25
    wheel_r_01:r=0.405
    wheel_r_02:r=0.405
    wheel_r_03:r=0.405
    wheel_r_04:r=0.405
    wheel_r_05:r=0.405
    wheel_r_06:r=0.405
    wheel_r_07:r=0.405
    wheel_l_01:r=0.405
    wheel_l_02:r=0.405
    wheel_l_03:r=0.405
    wheel_l_04:r=0.405
    wheel_l_05:r=0.405
    wheel_l_06:r=0.405
    wheel_l_07:r=0.405
    recalcWtms:b=yes
  }
}

