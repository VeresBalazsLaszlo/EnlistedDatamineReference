      hay:t="highgrass"
      ice:t="ice"
      metal_grid:t="metal"
      metal:t="metal"
      mud:t="mud"
      paper:t="concrete"
      pebbles:t="gravel"
      plastic:t="plastic"
      quarrySand:t="sand"
      quickSand:t="sand"
      road:t="concrete"
      roadAsphalt:t="concrete"
      roadConcrete:t="concrete"
      roadGravel:t="gravel"
      roadmud:t="mud"
      roadMud:t="mud"
      roadSand:t="sand"
      roadSnow:t="snow"
      roadSoil:t="grass"
      rocks:t="concrete"
      rocksSlippery:t="concrete"
      rubber:t="fabric"
      sand_slope:t="sand"
      sand:t="sand"
      sandbag:t="fabric"
      small_debris:t="gravel"
      small_decor:t="concrete"
      snow:t="snow"
      snowLower:t="snow"
      softSteelDoor:t="metal"
      softWoodDoor:t="wood"
