import{
  scene:t="gamedata/scenes/_common_sounds.blk"
}

entity{
  _template:t="ardennes_winter_ambient_sound"
}

entity{
  _template:t="sound_effect_generator"
  ri_extra_gen__blk:t="gamedata/normandy_sounds_ri_extra_gen.blk"
}

entity{
  _template:t="water_sound_field"
}

entity{
  _template:t="sound_field"

  "sound_field__biomeTypes:array"{

    "obj:object"{
      gameObject:t="biome_hill_sound_var"
      alpha2Value:p2=0.25, 1.0
    }

    "obj:object"{
      gameObject:t="biome_forest_sound_var"
      alpha2Value:p2=0.25, 1.0
      extent:r=15.0
    }

    "obj:object"{
      gameObject:t="biome_city_sound_var"
      alpha2Value:p2=0.5, 1.0
      extent:r=15.0
    }
  }

  "sound_field__vars:list<t>"{
    var:t="biome_high_hills"
    var:t="biome_forest"
    var:t="biome_city"
  }
}

entity{
  _template:t="compound_ambient_sound_type"
  compound_ambient_sound_type__soundType:t="factory_small"
  compound_ambient_sound_type__path:t="ambient/positioned/factory_small"
}

entity{
  _template:t="compound_ambient_sound_controller"

  "compound_ambient_sound_controller__soundTypes:list<t>"{
    name:t="factory_small"
  }
}