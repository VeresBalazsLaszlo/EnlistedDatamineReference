PhysSys{

  group{
    find:t="^bone_suspension_(._\d\d)$"

    points{

      lever{
        limitMin:p3=0.0, 0.0, 0.0
        limitMax:p3=0.0, 0.0, 0.0
        name:t="bone_suspension_$1"
      }

      suspension_01_01{
        limitMin:p3=-1.0, -1.0, 0.0
        limitMax:p3=1.0, 1.0, 0.0
        name:t="bone_suspension_$1_01"
      }

      wheel_01{

        searchChildren{
          occurence:i=1
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          parent:t="suspension_01_01"
          find:t="bone_wheel_"
        }
      }

      wheel_02{

        searchChildren{
          occurence:i=2
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          find:t="bone_wheel_"
          parent:t="suspension_01_01"
        }
      }
    }

    constraints{

      projection{
        point:t="suspension_01_01"
        from:t="wheel_02"
        to:t="wheel_01"
      }

      edge{
        from:t="lever"
        to:t="suspension_01_01"
        moveSecond:b=no
      }

      edge{
        to:t="wheel_01"
        from:t="suspension_01_01"
        moveNodes:b=no
      }

      direction{
        moveNodes:b=yes
        rotateSecond:b=no
        from:t="wheel_02"
        to:t="wheel_01"
        point:t="suspension_01_01"
      }
    }
  }

  group{
    find:t="^bone_suspension_(\w)_back_(\d+)$"

    points{

      lever{
        limitMin:p3=0.0, 0.0, 0.0
        limitMax:p3=0.0, 0.0, 0.0
        name:t="bone_suspension_$1_back_$2"
      }

      suspension_01_bac_01{
        limitMin:p3=-1.0, -1.0, 0.0
        limitMax:p3=1.0, 1.0, 0.0
        name:t="bone_suspension_$1_back_01_01"
      }

      wheel_01{

        searchChildren{
          occurence:i=1
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          parent:t="suspension_01_bac_01"
          find:t="bone_wheel_"
        }
      }

      wheel_02{

        searchChildren{
          occurence:i=2
          limitMin:p3=-1.0, -1.0, 0.0
          limitMax:p3=1.0, 1.0, 0.0
          parent:t="suspension_01_bac_01"
          find:t="bone_wheel_"
        }
      }
    }

    constraints{

      projection{
        point:t="suspension_01_bac_01"
        from:t="wheel_02"
        to:t="wheel_01"
      }

      edge{
        from:t="lever"
        to:t="suspension_01_bac_01"
        moveSecond:b=no
      }

      edge{
        to:t="wheel_02"
        from:t="suspension_01_bac_01"
        moveNodes:b=no
      }

      direction{
        moveNodes:b=yes
        rotateSecond:b=no
        from:t="wheel_02"
        to:t="wheel_01"
        point:t="suspension_01_bac_01"
      }
    }
  }
}