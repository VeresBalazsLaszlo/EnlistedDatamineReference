import:t="%gameBase/gamedata/templates/e_ww2_common/ww2_items.blk"

ger_ww1_gasmask_item{
  _use:t="attachable_face_equipment"
  _use:t="node_collapser"
  animchar__res:t="ger_ww1_gasmask_char"
  collres__res:t="ger_ww1_gasmask_collision"
  item__uniqueName:t="ger_ww1_gasmask_item"

  "gasMaskFace:tag"{
  }

  _group{
    _tags:t="render"

    "animchar_node_collapser__nodes:object"{
      "Bip01 Neck":t=""
      "Bip01 Head":t=""
    }
  }

  "skeleton_attach__remapParentSlots:list<t>"{
    slot:t="face"
  }
}

