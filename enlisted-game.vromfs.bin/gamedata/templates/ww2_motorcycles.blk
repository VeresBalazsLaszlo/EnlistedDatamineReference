    part:t="track_l_01"
    part:t="wheel_l_back"
    part:t="wheel_l_front"
    part:t="wheel_l_drive"
    part:t="wheel_r_back"
    part:t="wheel_r_front"
    part:t="wheel_r_drive"
    part:t="wheel_r_01"
    part:t="wheel_r_02"
    part:t="wheel_r_03"
    part:t="wheel_r_04"
    part:t="wheel_r_05"
    part:t="wheel_r_06"
    part:t="wheel_r_07"
    part:t="wheel_r_08"
    part:t="wheel_l_01"
    part:t="wheel_l_02"
    part:t="wheel_l_03"
    part:t="wheel_l_04"
    part:t="wheel_l_05"
    part:t="wheel_l_06"
    part:t="wheel_l_07"
    part:t="wheel_l_08"
  }

  "dm_parts__repairGroups:object"{
  }

  "dm_phys_parts__wheelsPartIds:list<i>"{
  }
}

bike_camera_setup{
  _use:t="tank_camera_setup"
  camName:t="bike_fps_cam"

  "camNames:array"{
    camNames:t="bike_fps_cam"
  }

  "defaultCameraTypes:shared:object"{
    driver:t="commander"
    commander:t="commander"
    passenger1:t="commander"
  }
}

bike_seat_fire_ready{
  _use:t="vehicle_seat_fire_ready"
  vehicle_seat__springConst:p3=70.0, 100.0, 15.0
  vehicle_seat__springDump:p3=8.0, 3.0, 2.0
  seat__useAimAngleLimits:b=no
  seat__aimAngleLimits:p4=0.0, 0.0, 0.0, 0.0
  seat__bindCamera:b=no

  "seat__hideCrosshair:tag"{
  }
}

bike_seat_commander{
  _use:t="vehicle_seat_commander"
  vehicle_seat__springConst:p3=30.0, 100.0, 25.0
  vehicle_seat__springDump:p3=5.0, 3.0, 2.0
  seat__useAimAngleLimits:b=no
  seat__aimAngleLimits:p4=0.0, 0.0, 0.0, 0.0
  seat__bindCamera:b=no
}

bike_seat_driver{
  _use:t="base_vehicle_seat"
  seats_order__canPlaceManually:b=yes
  seat_anim__upper:t="drive_driver"
  seat_anim__lower:t="drive_driver"
  vehicle_seat__springInverseRoll:b=yes
  vehicle_seat__springConst:p3=30.0, 100.0, 25.0
  vehicle_seat__springDump:p3=5.0, 3.0, 2.0
  seat__useAimAngleLimits:b=no
  seat__aimAngleLimits:p4=0.0, 0.0, 0.0, 0.0
  seat__bindCamera:b=no

  "commanderSeat:tag"{
  }
}

bike_phys_mods{
  vehicle_mods__extraMass:r=0.0
  vehicle_mods__maxMomentMult:r=1.0
  vehicle_mods__maxBrakeForceMult:r=1.0
  vehicle_mods__suspensionDampeningMult:r=1.0
  vehicle_mods__suspensionRestingMult:r=1.0
  vehicle_mods__suspensionMinLimitMult:r=1.0
  vehicle_mods__suspensionMaxLimitMult:r=1.0
}

bike_mods{
  _use:t="bike_phys_mods"

  "vehicle_mods__maxHorDriveMult:r"{
    _tags:t="server"
    value:r=1.0
  }

  "vehicle_mods__maxVerDriveMult:r"{
    _tags:t="server"
    value:r=1.0
  }
}