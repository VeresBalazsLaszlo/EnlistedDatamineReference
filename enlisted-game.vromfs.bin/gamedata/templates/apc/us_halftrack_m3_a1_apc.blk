ussr_halftrack_m3_a1_apc{
  _use:t="us_halftrack_m3_a1_apc"
  skin__template:t="ussr_halftrack_m3_a1_apc_skins"

  "animchar__objTexReplace:object"{
    "us_camo_olive*":t="ussr_camo_green*"
  }
}

us_halftrack_m3_a1_apc{
  _use:t="us_halftrack_m3_a1_apc_common"
  _use:t="apc_settings"

  "disableDMParts:list<t>"{
    part:t="gunner"
    part:t="commander"
    part:t="driver"
  }
}

us_halftrack_m3_a1_apc_common{
  _use:t="base_halftrack_m3_a1"
  _use:t="forestall"
  _use:t="halftrack_seats"
  _use:t="us_halftrack_m3_a1_common_vehicle_sound"
