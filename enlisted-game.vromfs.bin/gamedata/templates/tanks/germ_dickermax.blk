  armorThicknessTurret:p3=30.0, 20.0, 20.0

  "disableDMParts:list<t>"{
    part:t="gunner"
    part:t="loader"
    part:t="commander"
    part:t="machine_gunner"
    part:t="driver"
  }

  "onlyRootDecorAttach:tag"{
  }

  "attach_decorators__entities:list<eid>"{
  }

  "attach_decorators__templates:array"{

    "templates:object"{
      preinited:b=yes
      relativeTm:m=[[0.999961, -0.00773324, 0.00975084] [-0.00979625, -0.00598072, 0.999985] [-0.00767423, -0.999995, -0.00605522] [-1.44438, 0.924926, 0.664047]]
      template:t="tank_decor_box_01_decor"
      nodeName:t="root"
