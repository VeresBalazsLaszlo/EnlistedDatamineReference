VehiclePhys{
  skipUpdateOnSleep:b=yes

  Mass{
    Empty:r=24050.0
    Fuel:r=300.0
    TakeOff:r=24350.0
    momentOfInertia:p3=2.5, 2.5, 6.0
    CenterOfGravity:p3=0.2, 0.5, 0.0
    CenterOfGravityClampY:p2=0.0, 0.7
    AdvancedMass:b=yes
    trackMass:r=940.0
  }

  tracks{
    animationMultiplier:r=0.5
    tracksTensionK:p3=3.0, 8.0, 1.5
    trackMesh:t="ger_kgs61_400_120_phys_track_line"
    trackLen:r=0.12
    trackCount:i=93
    trackFadeTime:r=0.5
    trackCntPeriod:i=2
    trackMaxSinking:r=0.17
    trackMaxHeight:r=1.258
    trackStartOffset:r=0.11
    height:r=0.06
    width:r=0.4
  }

  collisionProps{
    cls_body_01:t="convex_hull"
    cls_turret:t="convex_hull"
  }

  engine{
    horsePowers:r=300.0
    maxRPM:r=3000.0
    minRPM:r=600.0
  }

  mechanics{
    steerType:t="clutch_braking"
    maxBrakeForce:r=92000.0
    driveGearRadius:r=0.425
    mainGearRatio:r=1.325
    sideGearRatio:r=9.0

    gearRatios{
      ratio:r=-5.35
      ratio:r=0.0
      ratio:r=8.5
      ratio:r=6.0
      ratio:r=3.5
      ratio:r=2.5
      ratio:r=1.5
      ratio:r=1.0
    }
  }

  suspension{
    suspensionOffsets:p3=-0.05, -0.05, 0.06
    defaultGearRadius:r=0.25
    topGearRadius:r=0.1
    frontBackGearRadius:r=0.4
    defaultDampeningForce:p2=95000.0, 95000.0
    dampeningRelaxationRatio:r=0.4
    dampeningCompressionRatio:r=0.15
    wheel_r_drive:r=0.3855
    wheel_r_back:r=0.375
    wheel_r_top_01:r=0.1545
    wheel_r_top_02:r=0.1545
    wheel_r_top_03:r=0.1545
    wheel_r_01:r=0.258
    wheel_r_02:r=0.258
    wheel_r_03:r=0.258
    wheel_r_04:r=0.258
    wheel_r_05:r=0.258
    wheel_r_06:r=0.258
    wheel_l_drive:r=0.3855
    wheel_l_back:r=0.375
    wheel_l_top_01:r=0.1545
    wheel_l_top_02:r=0.1545
    wheel_l_top_03:r=0.1545
    wheel_l_01:r=0.258
    wheel_l_02:r=0.258
    wheel_l_03:r=0.258
    wheel_l_04:r=0.258
    wheel_l_05:r=0.258
    wheel_l_06:r=0.258
    recalcWtms:b=yes
  }
}

