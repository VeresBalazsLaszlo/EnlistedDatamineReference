            maxOccupied:i=2
            traceVisible:b=yes
          }

          checkAllowedPosition{
            posParam:t="coverPos"
          }
        }

        sequencer{

          findCoverAroundPoint{
            centerParam:t="prevRegroupPos"
            radius:r=5.0
            possibleAngle:r=180.0
            coverPosParam:t="coverPos"
            minDist:r=2.0
            traceVisible:b=yes
          }

          checkAllowedPosition{
