hit_track_fx_group{

  "track_fx__info:object"{

    "track:object"{

      "group__dirt:object"{
        fx_bottom:t="tank_track_dirt_bottom"
        fx_top:t="tank_tracks_dirt_top"
      }

      "group__mud:object"{
        fx_bottom:t="tank_track_mud_bottom"
        fx_top:t="tank_tracks_mud_top"
      }

      "group__sand:object"{
        fx_bottom:t="tank_track_sand_bottom"
        fx_top:t="tank_tracks_sand_top"
      }

      "group__snow:object"{
        fx_bottom:t="tank_track_snow_bottom"
        fx_top:t="tank_tracks_snow_top"
      }

      "group__water:object"{
        fx_bottom:t="tank_track_water_bottom"
        fx_top:t="tank_tracks_water_top"
      }
    }

    "wheel:object"{

      "group__dirt:object"{
        fx_bottom:t="tank_track_dirt_bottom"
        fx_top:t="tank_tracks_dirt_top"
      }

      "group__mud:object"{
        fx_bottom:t="tank_track_mud_bottom"
        fx_top:t="tank_tracks_mud_top"
      }

      "group__sand:object"{
        fx_bottom:t="tank_track_sand_bottom"
        fx_top:t="tank_tracks_sand_top"
      }

      "group__snow:object"{
        fx_bottom:t="tank_track_snow_bottom"
        fx_top:t="tank_tracks_snow_top"
      }

      "group__water:object"{
        fx_bottom:t="tank_track_water_bottom"
        fx_top:t="tank_tracks_water_top"
      }
    }
  }

  "track_fx__default:object"{

    "track:object"{
      fx_bottom:t="tank_track_sand_bottom"
      fx_top:t="tank_tracks_sand_top"
    }

    "wheel:object"{
      fx_bottom:t="tank_track_sand_bottom"
      fx_top:t="tank_tracks_sand_top"
    }
  }
}