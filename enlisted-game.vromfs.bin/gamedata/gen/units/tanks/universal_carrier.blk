VehiclePhys{
  skipUpdateOnSleep:b=yes

  Mass{
    Empty:r=3190.0
    Fuel:r=91.0
    TakeOff:r=3750.0
    momentOfInertia:p3=2.0, 2.0, 5.0
    CenterOfGravity:p3=-0.1, 0.4, 0.0
    AdvancedMass:b=yes
    trackMass:r=200.0
    CenterOfGravityClampY:p2=0.0, 0.45
  }

  tracks{
    animationMultiplier:r=-0.5
    height:r=0.05
    width:r=0.28
  }

  collisionProps{
    cls_turret_01:t="convex_hull"
    cls_body:t="convex_hull"
  }

  engine{
    horsePowers:r=85.0
    maxRPM:r=3500.0
    minRPM:r=700.0
  }

  mechanics{
    steerType:t="clutch_braking"
    maxBrakeForce:r=20000.0
    driveGearRadius:r=0.23
    mainGearRatio:r=2.1
    sideGearRatio:r=2.88

    gearRatios{
      ratio:r=-7.32
      ratio:r=-14.22
      ratio:r=0.0
      ratio:r=12.2
      ratio:r=6.46
      ratio:r=4.91
      ratio:r=4.3
      ratio:r=2.6
      ratio:r=2.49
      ratio:r=1.71
      ratio:r=1.0
    }
  }

  suspension{
    suspensionOffsets:p3=-0.13, -0.11, 0.05
    defaultGearRadius:r=0.25
    topGearRadius:r=0.091
    frontBackGearRadius:r=0.24
    defaultDampeningForce:p2=9000.0, 9000.0
    dampeningRelaxationRatio:r=0.4
    dampeningCompressionRatio:r=0.15
    recalcWtms:b=yes
  }
}

