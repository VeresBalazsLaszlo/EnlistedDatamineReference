tank_losable_turret{
  _use:t="replicating"
  _replicated:t="losable_turret__lostBone"
  losable_turret__lostBone:t=""
  losable_turret__suppressDetach:b=no
  losable_turret__detachChance:r=1.0
  losable_turret__detachBone:t=""
  losable_turret__detachCollNode:t=""
  losable_turret__targetLaunchSpeed:r=15.0
  losable_turret__rotation:r=2.5
  losable_turret__deviation:r=0.5
  losable_turret__speedScale:p2=0.7, 1.3
  losable_turret__mass:r=4500.0
  losable_turret__ammoDetachThreshold:r=0.25
  losable_turret__tankMassFloor:r=12000.0
  losable_turret__spawnUpOffset:r=0.45
  losable_turret__turretTrailTemplate:t="tank_ammo_fire_turret_trail_template"
  losable_turret__barrelTrailTemplate:t="tank_ammo_fire_barrel_trail_template"

  "losable_turret__detachCollNodes:list<t>"{
  }
}

flying_turret_base{
  _use:t="destroyed_tank"
  _use:t="vehicle_damage_decals"
  _use:t="flying_turret_sound"
  _tracked:t="dmg_animchar__renderable"
  isExploded:b=yes
  animchar__res:t=""
  collres__res:t=""
  collres__performCopy:b=yes
  dmg_animchar__res:t=""
  dmg_animchar__renderable:b=no
  phys_obj_net_phys__blk:t="gamedata/units/debris/flying_turret.blk"
  start_vel:p3=0.0, 0.0, 0.0
  start_omega:p3=0.0, 0.0, 0.0
  flying_turret__bone:t=""
  flying_turret__comOffset:p3=0.0, 0.0, 0.0
  flying_turret__mass:r=0.0
  flying_turret__trailLingerTime:r=3.0
  flying_turret__lastFastTime:r=-1.0
  flying_turret__trailLingerEndTime:r=-1.0
  flying_turret__trailFxCleared:b=no
  flying_turret_fall_fx__effectTemplate:t="hit_tank_turret_effect"
  flying_turret_fall_fx__minSpeedDrop:r=3.0
  flying_turret_fall_fx__minSpeed:r=2.0
  flying_turret_fall_fx__cooldown:r=100000.0
  flying_turret_fall_fx__cooldownOnAppear:r=1.0
  flying_turret_fall_fx__prevSpeed:r=0.0
  flying_turret_fall_fx__nextTime:r=0.0

  "flyingTurret:tag"{
  }

  _group{
    _tags:t="render"

    "scorchable:tag"{
    }

    dmg_animchar{
    }

    "vehicle_fxs__effectsEids:list<eid>"{
    }

    "geomNodeIdRemapMain:list<i>"{
    }

    "geomNodeIdRemapDmg:list<i>"{
    }

    "geomNodeIdRemapDstr:list<i>"{
    }
  }

  "phys_obj__collisionPropsOverride:object"{
  }

  anim_phys{
  }

  phys_vars{
  }

