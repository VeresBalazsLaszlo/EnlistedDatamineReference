human_sound_geomtree_nodes{

  _group{
    _tags:t="sound"
    human_sound_geomtree_nodes__headNodeName:t="Bip01 Head"
    human_sound_geomtree_nodes__headNodeId:i=-1
  }
}

human_voice_sound_occlusion{

  _group{
    _tags:t="sound"
    human_voice_sound_occlusion__radius:r=0.5
    human_voice_sound_occlusion__attachRadius:r=0.5

    "human_voice_sound_occlusion__blob:SoundOcclusionBlob"{
    }
  }
}

sound_step_settings{
  _use:t="sound_physmat"
  _use:t="landmesh_biomes_to_sound_material"

  _group{
    _tags:t="sound"
    sound_step_settings__maxDistToFloor:r=0.2
  }

  _group{
    _tags:t="sound"

    "sound_physmat__soundMaterials:list<t>"{
      mat:t="grass"
      mat:t="concrete"
      mat:t="water"
      mat:t="wood"
