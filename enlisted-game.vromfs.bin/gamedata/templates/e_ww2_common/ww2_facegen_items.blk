eye_shader_vars{
  eye_iris_color_a_from:p4=0.2, 0.27, 0.25, 0.0
  eye_iris_color_a_to:p4=0.95, 0.95, 0.95, 0.0
  eye_iris_color_b_from:p4=0.25, 0.25, 0.25, 0.0
  eye_iris_color_b_to:p4=0.45, 0.25, 0.1, 0.0
  eye_iris_radius:r=0.03
  eye_parallax:r=0.2
  eye_reflectance:r=0.65
  eye_sclera_color_from:p4=0.62, 0.58, 0.58, 0.0
  eye_sclera_color_to:p4=0.44, 0.29, 0.29, 0.0
  eye_smoothness:r=0.97

  _group{
    eye_caustics_strength:r=1.3
    eye_caustics_light_lerp_factor:r=0.1
    eye_caustics_focal_point_offset:r=0.1
    eye_caustics_iris_radius:r=0.18
    eye_caustics_falloff_strength:r=0.6
    eye_caustics_concavity_scale:r=6.0
    _track:b=yes
  }
}

