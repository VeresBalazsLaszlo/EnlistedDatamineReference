      attachTm:m=[[0.882965, -0.469466, -0.0] [0.469466, 0.882965, 0.0] [0.0, -0.0, 1.00027] [-0.59, -0.3, -0.03]]
      seatComponent:t="isDriver"
      shouldHideOwner:b=no
