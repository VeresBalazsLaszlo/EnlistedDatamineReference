}

damage{

  explosive{
    radius:r=0.3
    offset:r=0.2
  }

  shatter{
    useRealShatters:b=yes
    countPortion:r=0.22
    damageType:t="shatter"

    segment{
      radiusScale:r=0.3
      penetrationScale:r=2.0
      damageScale:r=1.5
      angles:p2=0.0, 5.0
      countPortion:r=0.01
      onHitChanceMultFire:r=10.0
    }

    segment{
      radiusScale:r=0.15
      penetrationScale:r=2.0
      damageScale:r=1.0
      angles:p2=0.0, 29.0
      countPortion:r=0.03
      onHitChanceMultFire:r=10.0
    }

    segment{
      radiusScale:r=1.0
      penetrationScale:r=1.0
      damageScale:r=1.0
      angles:p2=30.0, 69.0
      countPortion:r=0.235
    }

    segment{
      radiusScale:r=0.25
      penetrationScale:r=1.7
      damageScale:r=1.5
      angles:p2=70.0, 110.0
      countPortion:r=0.075
      onHitChanceMultFire:r=50.0
    }

    segment{
      radiusScale:r=1.0
      penetrationScale:r=1.0
      damageScale:r=1.0
      angles:p2=111.0, 180.0
      countPortion:r=0.15
    }

    segment{
      radiusScale:r=1.0
      penetrationScale:r=1.0
      damageScale:r=1.0
      angles:p2=181.0, 249.0
      countPortion:r=0.15
    }

    segment{
      radiusScale:r=0.25
      penetrationScale:r=1.7
      damageScale:r=1.5
      angles:p2=250.0, 290.0
      countPortion:r=0.075
      onHitChanceMultFire:r=50.0
    }

    segment{
      radiusScale:r=1.0
      penetrationScale:r=1.0
      damageScale:r=1.0
      angles:p2=291.0, 329.0
      countPortion:r=0.235
    }

    segment{
      radiusScale:r=0.15
      penetrationScale:r=2.0
      damageScale:r=1.0
      angles:p2=330.0, 359.0
      countPortion:r=0.03
      onHitChanceMultFire:r=10.0
    }

    segment{
      radiusScale:r=0.3
