base_m4_sherman_calliope{
  _use:t="base_tank"
  _use:t="m4_sherman_calliope_ammo_stowages"
  _use:t="vehicle_physical_tracks"
  killLogName:t="us_m4_sherman_calliope"
  animchar__res:t="t34_sherman_calliope_char"
  animchar_fast_phys__res:t="t34_sherman_calliope_fastphys"
  collres__res:t="t34_sherman_calliope_collision"
  vehicle_net_phys__blk:t="gamedata/gen/units/tanks/m4_sherman_calliope.blk:VehiclePhys"
  particle_phys__blk:t="gamedata/gen/units/tanks/m4_sherman_calliope.blk:PhysSys"
  dmg_animchar__res:t="t34_sherman_calliope_dmg_char"
  xray_resource__modelName:t="t34_sherman_calliope"
  cockpit__zoomOutFov:r=2.7475
  cockpit__zoomInFov:r=5.3955
  cockpit__sightName:t="sight_model/default_tank_spg"
  cockpit__sightFov:r=20.0
  drowningHeight:r=1.6
  damage_model__blk:t="gamedata/gen/units/tanks/m4_sherman_calliope.blk"
  item__name:t="items/us_m4_sherman_calliope"
  physical_tracks__blk:t="gamedata/gen/units/tanks/m4_sherman_calliope.blk"
  resupply__cooldownOverride:r=1.5
  skin__template:t="m4_sherman_calliope_skins"

  animchar_fast_phys{
    _tags:t="gameClient"
  }

  _group{
    _tags:t="gameClient"
    chain_ik__blk:t="gamedata/gen/units/tanks/m4_sherman_calliope.blk:chainIK"
  }

  "turret_gun_flash_fx__flashNodes:shared:array"{
    node:t="emtr_gun_flame"
    node:t="bone_mg_twin_flame"
    node:t=""
    node:t="emtr_mg_flame_02"
  }

  "turret_gun_flash_fx__flashFx:shared:array"{
    fx:t="muzzle_ground_60mm"
    fx:t="muzzle_ground_8mm"
    fx:t=""
    fx:t="muzzle_ground_8mm"
  }

  "turret_gun_flash_fx__flashFxScale:shared:array"{
    scale:r=1.0
    scale:r=1.0
    scale:r=1.0
    scale:r=1.0
  }

  "turret_control__emitterNodes:shared:array"{
    node:t="bone_gun_barrel_01"
    node:t="bone_mg_twin_v"
    node:t="bone_gun_01"
    node:t="bone_mg_v_02"
  }

  "turret_control__animVars:shared:array"{

    "vars:object"{
      curYawParamName:t="turret_01_yaw"
      curPitchParamName:t="gun_01_pitch"
      aimActiveParamName:t="aim_01_active"
      paramYawSpeed:t="turret_01_yaw_speed"
      paramYawSpeedMul:t="turret_01_yaw_mul"
      paramYawAccel:t="turret_01_yaw_accel"
      paramMinYawAngle:t="turret_01_min_yaw_angle"
      paramMaxYawAngle:t="turret_01_max_yaw_angle"
      paramMinPitchAngle:t="turret_01_min_pitch_angle"
      paramMaxPitchAngle:t="turret_01_max_pitch_angle"
      paramPitchSpeed:t="gun_01_pitch_speed"
      paramPitchSpeedMul:t="gun_01_pitch_mul"
      paramPitchAccel:t="gun_01_pitch_accel"
      wishYawParamName:t="gun_01_aim:targetYaw"
      wishPitchParamName:t="gun_01_aim:targetPitch"
      gunRecoilParamName:t="gun_01_recoil"
      hasStabilizerParamName:t="gun_01_aim:hasStab"
      stabilizerPitchParamName:t="gun_01_aim:stabPitch"
      stabilizerErrorParamName:t="gun_01_aim:stabError"
      stabilizerPitchMultParamName:t="gun_01_aim:stabPitchMult"
    }

    "vars:object"{
      curYawParamName:t="turret_03_yaw"
      curPitchParamName:t="gun_03_pitch"
    }

    "vars:object"{
      curYawParamName:t="turret_01_yaw"
      curPitchParamName:t="gun_02_pitch"
    }

    "vars:object"{
      curYawParamName:t="turret_04_yaw"
      curPitchParamName:t="gun_04_pitch"
      aimActiveParamName:t="aim_04_active"
      paramYawSpeed:t="turret_04_yaw_speed"
      paramYawSpeedMul:t="turret_04_yaw_mul"
      paramYawAccel:t="turret_04_yaw_accel"
      paramMinYawAngle:t="turret_04_min_yaw_angle"
      paramMaxYawAngle:t="turret_04_max_yaw_angle"
      paramMinPitchAngle:t="turret_04_min_pitch_angle"
      paramMaxPitchAngle:t="turret_04_max_pitch_angle"
      paramPitchSpeed:t="gun_04_pitch_speed"
      paramPitchSpeedMul:t="gun_04_pitch_mul"
      paramPitchAccel:t="gun_04_pitch_accel"
      wishYawParamName:t="gun_04_aim:targetYaw"
      wishPitchParamName:t="gun_04_aim:targetPitch"
    }
  }

  "turret_control__turretInfo:shared:array"{

    "turretInfo:object"{
      turretName:t="turret_01"
      gun:t="m4_sherman_calliope_turret_01_75mm_m3+turret_with_several_types_of_shells+main_turret"
      barrelDm:t="gun_barrel"
      breechDm:t="cannon_breech"
      verDriveDm:t="drive_turret_v"
      horDriveDm:t="drive_turret_h"
      salt:i=1
    }

    "turretInfo:object"{
      turretName:t="turret_02"
      gun:t="m4_sherman_calliope_turret_02_7_62mm_m1919a4"
      barrelDm:t="gun_barrel_01"
      salt:i=1
    }

    "turretInfo:object"{
      turretName:t="turret_03"
      gun:t="m4_sherman_calliope_rocket"
      barrelDm:t="gun_barrel_02"
    }

    "turretInfo:object"{
      turretName:t="turret_04"
      gun:t="m4_sherman_calliope_turret_04_7_62mm_m1919a4"
      barrelDm:t="gun_barrel_03"
      salt:i=1
    }
  }
}

base_m8_rocket_projectile{
  _use:t="rocket_projectile"
  animchar__res:t="m8_rocket_char"

  "shell__concussionMaxRadius:r"{
    value:r=4.0
    _tags:t="server"
  }
}

m4_sherman_calliope_rocket{
  _use:t="base_tank_rocket_gun"
  gun__projectileTemplate:t="m8_rocket_projectile"
  gun__projectileDebugTemplate:t="m8_rocket_projectile+bomb_projectile_debug"
  item__name:t="guns/114mm_M8_rocket_launcher"
  gun__blk:t="gamedata/weapons/m4_sherman_calliope/m8_launcher.blk"
  gun__shotFreq:r=1.0
  gun__locName:t="114mm_M8_rocket_launcher"
  gun__shootNodeName:t="bone_rocket_01"
  gun__shootNodeEmitterGenFmt:t="bone_rocket_%02d"
  gun__shootNodeItemTemplate:t="m4_sherman_calliope_item"
  gun__maxAmmo:i=60
  gun__ammo:i=60

  "gun__ammoSetsInfo:shared:array"{

    "default:array"{

      "shell:object"{
        blk:t="gamedata/weapons/shells/m8_rocket_calliope.blk"
        name:t="114mm_M8_rocket_launcher"
        type:t="he_frag_tank"
      }
    }
  }

  "gun__shellsAmmoEids:list<eid>"{
  }

  "gun__shootNodeIds:list<i>"{
  }

  "gun__shellsAmmo:array"{
    ammo:i=60
  }
}

m4_sherman_calliope_item{
  _use:t="base_tank_rocket_item"
  animchar__res:t="m8_rocket_char"
}

m4_sherman_calliope_turret_01_75mm_m3{
  _use:t="tankgun_75mm_m3"
  gun__shootNodeName:t="bone_gun_barrel_01"
  turret__yawSpeed:r=24.0
  turret__pitchSpeed:r=4.0
  turret__aimNodeName:t="bone_turret"
  turret__limit:p4=-180.0, 180.0, -10.0, 25.0
  turret__stabilizerPitchFrictionMult:r=0.8
  turret__stabilizerPitchSpeedLimitKph:r=24.0

  "turret__stabilizerErrorByKphSpeedTable:list<p2>"{
    row:p2=5.0, 0.0
    row:p2=10.0, 0.05
    row:p2=12.0, 0.4
  }

  "gun__shellsAmmo:array"{
    ammo:i=21
    ammo:i=19
    ammo:i=19
    ammo:i=19
    ammo:i=19
  }
}

m4_sherman_calliope_turret_02_7_62mm_m1919a4{
  _use:t="tankgun_7_62mm_m1919a4"
  gun__shootNodeName:t="bone_mg_twin_v"

  "gun__shellsAmmo:array"{
    ammo:i=3000
  }
}

m4_sherman_calliope_turret_04_7_62mm_m1919a4{
  _use:t="tankgun_7_62mm_m1919a4"
  gun__shootNodeName:t="emtr_mg_flame_02"
  turret__yawSpeed:r=35.0
  turret__pitchSpeed:r=35.0
  turret__aimNodeName:t="bone_mg_h_02"
  turret__limit:p4=-10.0, 10.0, -10.0, 10.0

  "gun__shellsAmmo:array"{
    ammo:i=1500
    ammo:i=1500
  }
}

m4_sherman_calliope_ammo_stowages{
  _tags:t="server"
  _use:t="vehicle_ammo_stowages"

  "ammo_stowage__stowageTemplates:shared:list<t>"{
    stowage:t="m4_sherman_calliope_primary_ammo_stowage"
  }
}

m4_sherman_calliope_primary_ammo_stowage{
  _use:t="ammo_stowage"

  "ammo_stowage__clusterTemplates:shared:list<t>"{
