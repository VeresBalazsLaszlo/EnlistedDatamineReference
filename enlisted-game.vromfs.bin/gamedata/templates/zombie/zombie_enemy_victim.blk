zombie_luger_armored_victim{
  _use:t="base_zombie_armored_soldier"
  _use:t="zombie_stuck_control"
  agent_dangers__ignoreDowned:b=yes
  entity__recreateToOnDeath:t="dead_enlisted_zombie_soldier_victim"
  paid_loot__pointsForKill:i=0
  paid_loot__pointsPerDamage:r=0.0
  paid_loot__soulsForKill:i=20
  paid_loot__soulsPerDamage:r=0.0
  entity_mods__meleeDamageMult:r=0.3
  dontShowKillAward:b=yes
  killLogName:t="zombie/uber_armored"

  "paid_loot__extraPointsForHeadshot:tag"{
  }

  "human_weap__weapTemplates:object"{
    primary:t="p08_luger_zombie_gun"
  }

  "human_weap__weapInfo:array"{

    "human_weap__weapInfo:object"{
      reserveAmmoTemplate:t="p08_luger_magazine"
      numReserveAmmo:i=100
    }

    "human_weap__weapInfo:object"{
    }

    "human_weap__weapInfo:object"{
    }

    "human_weap__weapInfo:object"{
    }

    "human_weap__weapInfo:object"{
    }
  }

  _group{
    _tags:t="server"

    "human_weap__template_deps_list:list<t>"{
      item:t="p08_luger_magazine"
      item:t="p08_luger_zombie_gun"
    }
  }

  "walker_agent__distanceToShootError:shared:array"{

    "error:object"{
      distance:r=0.0
      min:p2=0.8, 1.0
      max:p2=1.0, 1.5
      maxEnd:p2=0.0, 0.0
    }

    "error:object"{
      distance:r=18.0
      min:p2=1.3, 1.6
      max:p2=1.5, 2.3
      maxEnd:p2=0.4, 0.7
    }

    "error:object"{
      distance:r=50.0
      min:p2=1.7, 1.8
      max:p2=2.0, 4.0
      maxEnd:p2=1.7, 2.0
    }

    "error:object"{
      distance:r=100.0
      min:p2=2.0, 4.0
      max:p2=5.0, 6.0
      maxEnd:p2=3.0, 3.0
    }
  }
}

