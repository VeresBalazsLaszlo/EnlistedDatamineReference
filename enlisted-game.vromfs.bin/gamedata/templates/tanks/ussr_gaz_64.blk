  _group{
    _tags:t="render"
    animchar_camera_target__node_name:t="bone_gun"
    animchar_camera_target__node_offset:p3=0.0, 1.0, 0.0
    animchar_camera_target__nodeIndex:i=-1
  }

  "heat_source__turretInfo:shared:array"{
