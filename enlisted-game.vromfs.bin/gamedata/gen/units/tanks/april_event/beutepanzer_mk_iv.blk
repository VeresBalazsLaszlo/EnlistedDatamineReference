        radius:r=0.05
      }

      wheel{
        pos:p3=0.4, 2.15, -0.858647
        radius:r=0.05
      }

      wheel{
        pos:p3=-0.65, 2.15, -0.858647
        radius:r=0.05
      }

      wheel{
        pos:p3=-1.5, 2.06, -0.858647
        radius:r=0.05
      }
    }

    trackLimiters{

      limiter{
        p1:p3=3.7, 1.8, 1.1
        p2:p3=2.0, 2.1, 1.1
      }

      limiter{
        p1:p3=2.0, 2.1, 1.1
        p2:p3=-0.7, 2.1, 1.1
      }

      limiter{
        p1:p3=-0.7, 2.1, 1.1
        p2:p3=-1.5, 2.0, 1.1
      }

      limiter{
        p1:p3=-1.5, 2.0, 1.1
        p2:p3=-2.4, 1.7, 1.1
      }

      limiter{
        p1:p3=-1.5, 2.0, 1.1
        p2:p3=-2.4, 1.7, 1.1
      }

      limiter{
        p1:p3=-2.4, 1.7, 1.1
        p2:p3=-4.0, 0.8, 1.1
      }

      limiter{
        p1:p3=3.7, 1.8, -1.1
        p2:p3=2.0, 2.1, -1.1
      }

      limiter{
        p1:p3=2.0, 2.1, -1.1
        p2:p3=-0.7, 2.1, -1.1
      }

      limiter{
        p1:p3=-0.7, 2.1, -1.1
