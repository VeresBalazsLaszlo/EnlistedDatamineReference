import:t="%gameBase/gamedata/templates/e_ww2_common/ww2_guns.blk"

gun_overheat_visual{

  _group{
    _tags:t="gameClient"
    gun__overheatPhysVarName:t="overheat"
    gun__overheatVarId:i=-1
    gun__overheatLastVisualVal:r=0.0
    gun__overheadIndicatorMax:r=355.0
  }
}

gun_overheat{
  _use:t="gun_overheat_speech_enable"
  gun__isOverheat:b=no
  gun__overheat:r=0.0
  gun__overheatReduce:r=0.05
  gun__overheatReduceOnOverheat:r=0.33
  gun__overheatPerShot:r=0.1
  _replicated:t="gun__overheat"
  _replicated:t="gun__isOverheat"
  _tracked:t="gun__isOverheat"
}

infinite_magazine{
  _use:t="item_magazine"
  ammo_holder__templateName:t="infinite_magazine"
  ammo_holder__ammoCount:i=100000
  item__proto:t="infinite_magazine"
  item__template:t="infinite_magazine"
  animchar__res:t="gewehr_43_ammo_char"
  collres__res:t="gewehr_41_ammo_collision"
}

railgun_projectile{
  _use:t="beam_projectile"

  _group{
    _tags:t="render"
    projectile_beam_tracer__id:i=-1
    projectile_beam_tracer__time:r=0.5
    projectile_beam_tracer__radius:r=2.2
    projectile_beam_tracer__headColor:p3=2.0, 255.0, 255.0
    projectile_beam_tracer__smokeColor:p4=0.5, 0.5, 0.5, 0.5
    projectile_beam_tracer__luminosity:r=35.0
    projectile_beam_tracer__fadeDist:r=3.0
    projectile_beam_tracer__beginFadeTime:r=0.05
    projectile_beam_tracer__endFadeTime:r=0.15
    projectile_beam_tracer__scrollSpeed:r=10.0
  }
}

blaster_base{
  _use:t="gun_overheat"
  _use:t="gun_overheat_visual"
  gun__overheatReduce:r=0.0
  gun__overheatReduceOnOverheat:r=2.0
  gun__overheatPerShot:r=0.3
  gun__zeroingDistance:r=10.0
  gun__ignoreWeaponVelocity:b=yes
  weap__sprintLerpFactor:r=1.0
  gun_deviation__omegaRange:p2=0.0, 0.0
  gun_deviation__omegaDevInc:p2=0.0, 0.0
  gun_deviation__movementRange:p2=0.0, 0.0
  gun_deviation__movementDevInc:p2=0.0, 0.0
  gun__shotFreq:r=9.0

  "gun__firingModes:array"{

    "mode:object"{
      modeType:t="burst"
      burstSize:i=4
    }
  }

  "gun__firingModeNames:array"{
    mode:t="semi_auto"
  }
}

blaster_gun_base{
  _use:t="space_blaster_muzzle_preset"
  _use:t="rifle_gun_aim_sound"
  gun__recoilAmount:r=0.0
  gun__visualRecoilMult:r=10000.0
  gun_shell_ejection__expireTime:r=0.0

  "gun_mods__slots:object"{

    "scope:object"{
      scope_pulsar_n870:t="scope_pulsar_n870"
    }
  }

  _group{
    _tags:t="sound"
    gun_sound__forceOneshot:b=yes
    gun_sound__forceOneshotEnemy:b=yes
  }

  "gun_sound__shotPath:shared:object"{
    _tags:t="sound"
    watched:t="events/moonbase/player/weapon/laser_rifle"
    other:t="events/moonbase/enemy/weapon/laser_rifle"
  }

  "sound_irqs:shared:object"{
    _tags:t="sound"

    "reload1:object"{
      watched:t="events/moonbase/player/weapon/laser_rifle/reload1/change_ammo"
      other:t="enemy/weapon/rifle/svt40/reload1/change_ammo"
    }

    "reload2:object"{
      watched:t="events/moonbase/player/weapon/laser_rifle/reload2/change_ammo"
      other:t="enemy/weapon/rifle/svt40/reload2/change_ammo"
    }

    "reload3:object"{
      watched:t="events/moonbase/player/weapon/laser_rifle/reload3/change_ammo"
      other:t="enemy/weapon/rifle/svt40/reload3/change_ammo"
    }

    "reload4:object"{
      watched:t="events/moonbase/player/weapon/laser_rifle/reload4/change_ammo"
      other:t="enemy/weapon/rifle/svt40/reload4/change_ammo"
    }

    "boltAction:object"{
      watched:t="events/moonbase/player/weapon/laser_rifle/bolt_action"
      other:t="enemy/weapon/rifle/svt40/bolt_action"
    }
  }

  "gun__ammoHolders:array"{
    ammoHolders:t="infinite_magazine"
  }

  "gun__shells:array"{
    shells:t="content/enlisted_extra/gamedata/weapons/bullets/blaster_bullet.blk"
  }
}

