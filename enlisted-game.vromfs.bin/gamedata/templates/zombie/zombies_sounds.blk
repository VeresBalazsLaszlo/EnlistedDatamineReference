blaster_zombie_gun_sound{
  _use:t="rifle_gun_aim_sound"

  _group{
    _tags:t="sound"
    gun_sound__forceOneshot:b=yes
  }

  "gun_sound__shotPath:shared:object"{
    _tags:t="sound"
    watched:t="events/moonbase/player/weapon/laser_mg"
    other:t="events/moonbase/enemy/weapon/laser_mg"
  }

  "sound_irqs:shared:object"{
    _tags:t="sound"

    "reload1:object"{
      watched:t="events/moonbase/player/weapon/laser_rifle/reload1/change_ammo"
      other:t="enemy/weapon/rifle/svt40/reload1/change_ammo"
    }

    "reload2:object"{
      watched:t="events/moonbase/player/weapon/laser_rifle/reload2/change_ammo"
      other:t="enemy/weapon/rifle/svt40/reload2/change_ammo"
    }

    "reload3:object"{
      watched:t="events/moonbase/player/weapon/laser_rifle/reload3/change_ammo"
      other:t="enemy/weapon/rifle/svt40/reload3/change_ammo"
    }

    "reload4:object"{
      watched:t="events/moonbase/player/weapon/laser_rifle/reload4/change_ammo"
      other:t="enemy/weapon/rifle/svt40/reload4/change_ammo"
    }

    "boltAction:object"{
      watched:t="events/moonbase/player/weapon/laser_rifle/bolt_action"
      other:t="enemy/weapon/rifle/svt40/bolt_action"
    }
  }
}

