      "effectors:object"{
        r.hand:t="righthand_5"
        l.hand:t="lefthand_5"
        r.foot:t="pedal_rfoot_5"
        l.foot:t="pedal_lfoot_5"
      }
    }

    "seats:object"{
      locName:t="vehicle_seats/radioman"
      attachNode:t="machine_gunner"
      ignoreAttachNodeRotation:b=yes
      attachTm:m=[[0.906316, -0.422616, -1.40075e-08] [0.421587, 0.904108, 0.0697566] [-0.0294802, -0.0632215, 0.997576] [-0.31, -0.2, 0.0]]
