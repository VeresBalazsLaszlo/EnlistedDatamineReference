PhysSys{
  find:t="^bone_suspension_(\w)_(\d+)$"

  points{

    lever{
      limitMin:p3=0.0, -1.0, 0.0
      limitMax:p3=0.0, 1.0, 0.0
      name:t="bone_suspension_c_$2"
    }

    wheel_r_01{

      searchChildren{
        occurence:i=1
        limitMin:p3=-1.0, -1.0, 0.0
        limitMax:p3=1.0, 1.0, 0.0
        parent:t="lever"
        find:t="bone_wheel_"
      }
    }

    wheel_l_01{

      searchChildren{
        occurence:i=2
        limitMin:p3=-1.0, -1.0, 0.0
        limitMax:p3=1.0, 1.0, 0.0
        parent:t="lever"
        find:t="bone_wheel_"
      }
    }
  }

  constraints{

    edge{
      to:t="wheel_r_01"
      from:t="lever"
    }

    edge{
      from:t="lever"
      to:t="wheel_l_01"
    }

    slider{
      moveNodes:b=yes
      rotateSecond:b=no
      moveSecond:b=yes
      moveOnly:b=no
      point:t="lever"
      from:t="wheel_l_01"
      to:t="wheel_r_01"
    }
  }
}

