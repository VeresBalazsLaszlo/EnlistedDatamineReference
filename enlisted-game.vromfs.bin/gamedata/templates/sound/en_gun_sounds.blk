  _group{
    _tags:t="sound"
    gun_shot_dry_sound__path:t="player/weapon/_common/shot_dry_small_cannon"
  }
}

gun_switch_firing_mode_sound{

  _group{
    _tags:t="sound"
    gun_switch_firing_mode_sound__path:t="player/weapon/_common/change_mode"
  }
}

gun_delayed_shot_sound{

  _group{
    _tags:t="sound"
    gun_delayed_shot_sound__nextTime:r=0.0
    gun_delayed_shot_sound__path:t=""
    gun_delayed_shot_sound__cooldown:r=0.0

    "gun_delayed_shot_sound__event:SoundEvent"{
    }
  }
}

base_gun_overheat_sound{

  _group{
    _tags:t="sound"
    gun_overheat_sound__gunOverheatToVar:p2=0.01, 1.0
    gun_overheat_sound__path:t=""

    "gun_overheat_sound__event:SoundEvent"{
    }
  }
}

machinegun_gun_overheat_sound{
  _use:t="base_gun_overheat_sound"

  _group{
    _tags:t="sound"
    gun_overheat_sound__path:t="player/vehicle/tank/common/mgun_overheat"
  }
}

cannon_gun_overheat_sound{
  _use:t="base_gun_overheat_sound"

  _group{
    _tags:t="sound"
    gun_overheat_sound__path:t="player/vehicle/tank/common/cannon_overheat"
  }
}

machinegun_gun_reload_sounds{

  _group{
    _tags:t="sound"
    gun_reload_sound__progressPath:t="player/vehicle/tank/common/reload_mgun_start"
    gun_reload_sound__readyPath:t="player/vehicle/tank/common/reload_mgun_end"
    gun_reload_sound__readyTimeOffset:r=0.3

    "gun_reload_sound__event:SoundEvent"{
    }
  }
}

cannon_gun_reload_sounds{

  _group{
    _tags:t="sound"
    gun_reload_sound__progressPath:t="player/vehicle/tank/common/reload_cannon_start"
    gun_reload_sound__readyPath:t="player/vehicle/tank/common/reload_cannon_end"
    gun_reload_sound__readyTimeOffset:r=0.5

    "gun_reload_sound__event:SoundEvent"{
    }
  }
}

gun_ready_to_shoot_sound{

  _group{
    _tags:t="sound"
    gun_ready_to_shoot_sound__duration:r=0.3
    gun_ready_to_shoot_sound__minTimeBetweenShots:r=2.0
    gun_ready_to_shoot_sound__path:t="player/vehicle/tank/common/reload_cannon_end"
  }
}

tankgun_cannon_reload_sounds{
  _use:t="cannon_gun_reload_sounds"
  _use:t="gun_ready_to_shoot_sound"
}

tankgun_cannon_overheat_sound{
  _use:t="cannon_gun_overheat_sound"
}

tankgun_machinegun_reload_sounds{
  _use:t="machinegun_gun_reload_sounds"
}

tankgun_machinegun_overheat_sound{
  _use:t="machinegun_gun_overheat_sound"
}

gun_owner_sound_group_for_gun_sound{

  "gun_owner_sound_event_group:SoundEventGroup"{
    _tags:t="sound"
  }
}

gun_sound_occlusion{

  _group{
    _tags:t="sound"

    "gun_sound__blob:SoundOcclusionBlob"{
    }
  }
}

gun_sound{
  _use:t="sound_irqs"
  _use:t="sound_tags"
  _use:t="pistol_gun_shot_dry_sound"
  _use:t="pistol_gun_aim_sound"
  _use:t="gun_sound_occlusion"
  _use:t="play_invisible_animations_near_listener"

  _group{
    gun_sound__forceOneshot:b=no
    gun_sound__forceOneshotEnemy:b=no
    gun_sound__shotLoopTimeout:r=0.0
    gun_sound__deltaTime:p4=1.0, 1.0, 1.0, 1.0
    gun_sound__playerTimeBetweenShotsMad:p2=2.0, 0.0
    gun_sound__netTimeBetweenShotsMad:p2=2.0, 0.1
    _tags:t="sound"

    "gun_sound__event:SoundEvent"{
    }
  }

  "gun_sound__shotPath:shared:object"{
    _tags:t="sound"
  }

  "gunSound:tag"{
  }
}

gun_sound_with_animchar{
  _use:t="gun_sound"

  "animchar_sound:AnimcharSound"{
    _tags:t="sound"
  }
}

turret_gun_sound{
  _use:t="gun_sound"
  _use:t="turret_gun_shot_dry_sound"
}

gun_bolt_action_sound{

  _group{
    _tags:t="sound"
    gun_bolt_action_sound__time:r=1.0
  }

  "gun_bolt_action_sound__irqs:shared:array"{
    _tags:t="sound"
  }
}

base_gun_aim_sound{

  _group{
    _tags:t="sound"

    "gun_aim_sound__onPath:shared:object"{
    }

    "gun_aim_sound__offPath:shared:object"{
    }
  }
}

antivehicle_gun_aim_sound{
  _use:t="base_gun_aim_sound"

  _group{
    _tags:t="sound"

    "gun_aim_sound__onPath:shared:object"{
      watched:t="player/walker/ww2_soldier/foley_mov/common/antivehicle/aim_on"
    }

    "gun_aim_sound__offPath:shared:object"{
      watched:t="player/walker/ww2_soldier/foley_mov/common/antivehicle/aim_off"
    }
  }
}

