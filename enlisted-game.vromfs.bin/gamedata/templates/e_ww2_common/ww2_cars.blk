civil_vehicle_templ{
  _use:t="vehicle"
  _use:t="hit_track_fx_group"
  _use:t="base_damage_model"
  _use:t="base_damage_model_fx"
  _use:t="base_damage_model_ai_points"
  _use:t="vehicle_engine_external_fire"
  _use:t="vehicle_fatal_explosion_external_fire"
  zones_visitor__triggerTag:t="vehicleTriggerable"
  _replicated:t="killer"
  _replicated:t="dm_state"
  _replicated:t="fire_damage_state"
  _replicated:t="fire_damage__isBurn"
  _replicated:t="isExploded"
  lastStatPos:p3=0.0, 0.0, 0.0
  collision_damage__threshold:r=5.0
  collision_damage__velDeltaMult:r=10.0
  collision_damage__velDeltaPower:r=2.0
  isExploded:b=no
  triggerDamageEffects:b=yes
  vehicle_seat_damage__minVelocity:r=5.0
  vehicle_seat_damage__velocityMult:r=0.5
  vehicle_seat_damage__maxDmgPercent:r=0.3
  explosion_fx__effectName:t="tank_explosion_template"
  explosion_fx__nodeName:t="emtr_explosion_center"
  explosion_fx__nodeId:i=-1
  _tracked:t="isExploded"
  fire_damage__isBurn:b=yes
  fire_damage__totalTime:r=0.0
  timeToExplosion:r=35.0
  fire_damage__update_burn_interval:r=1.0
  fire_damage__innerRadiusMult:r=2.0

  _group{
    _tags:t="render"
    exhaust_fx__fx:t="car_exhaust_template"
    exhaust_fx__brokenFx:t="car_broken_exhaust_template"
  }

  _group{
    _tags:t="input"

    "vehicle__steerTips:list<t>"{
      tip:t="Vehicle.Brake"
      tip:t="Vehicle.HandBrake"
      tip:t="Vehicle.Accel"
      tip:t="Vehicle.Steer"
      tip:t="Vehicle.Throttle"
      tip:t="Vehicle.Horn"
    }
  }

  _group{
    _tags:t="render"
    animchar_camera_target__node_name:t="bone_camera_driver"

    "engine_fire_fx__eids:list<eid>"{
    }

    "vehicle_fxs__effectsEids:list<eid>"{
    }
  }

  "dm_parts_repair_names:list<t>"{
    part:t="part:t="
    part:t="drive_turret_h"
    part:t="drive_turret_v"
    part:t="cannon_breech"
