  }

  selector{

    sequencer{

      findDanger{
        paramName:t="enemy"
        radiusParamName:t="enemyRadius"
        minDanger:r=0.6
        tag:t="human"
      }

      selectNode{
        name:t="attack"
      }
    }

    wait{
      range:p2=5.0, 10.0
      resetable:b=yes
    }
  }
}

sequencer{
  name:t="sub.nAttackPriorityTarget"

  success{

    sequencer{
      name:t="run_to_target"

      voiceEffect{
        effect:t="seeDanger"
        cooldownMinMax:p2=6.0, 10.0
      }

      checkDistanceToTarget{
        targetParam:t="walker_agent__targetEid"
        radius:r=10.0
      }

      sequencer{

        compareNode{
          lhs:t="walker_agent__targetEid"
          operator:t="!="
          rhs:i=0
        }

        nPhysCorridorMoveToTarget{
          vertExtent:r=10.0
          targetParam:t="walker_agent__targetEid"
          stopDist:r=1.3
          navLookAhead:r=0.75
        }
      }
    }
  }

  repeatUntilFail{

    orderedSelector{

      sequencer{

        compareNode{
          lhs:t="walker_agent__targetEid"
          operator:t="!="
          rhs:i=0
        }

        nPhysCorridorMoveToTarget{
          vertExtent:r=10.0
          targetParam:t="walker_agent__targetEid"
          forceToWalk:b=no
          stopDist:r=1.3
          navLookAhead:r=0.75
          loseInvisibleTarget:b=no
        }
      }

      findDestructableNearTarget{
        targetParam:t="walker_agent__targetEid"
        traceDist:r=3.0
      }
    }

    runAction{
      action:t="stand_melee"
    }

    parallel{

      nPhysStareAtEntity{
        targetParam:t="walker_agent__targetEid"
      }

      wait{
        range:p2=0.5, 1.0
        resetable:b=yes
      }
    }

    modifyNode{
      targetIntParam:t="enemy"
      operator:t="="
      arg:t="walker_agent__targetEid"
    }

    checkTarget{
      targetUnitParam:t="enemy"
    }
  }
}

sequencer{
  name:t="sub.recalculateTreeOnStuck"

  compareNode{
    lhs:t="stuck_detector_debug__enabled"
    operator:t=">"
    rhs:r=0.0
  }

  compareNode{
    lhs:t="stuck_detector__value"
    operator:t=">"
    rhs:r=0.6
  }

  modifyNode{
    target:t="stuck_detector__value"
    operator:t="="
    arg:r=0.0
  }

  modifyNode{
    target:t="walker_agent__targetEid"
    operator:t="="
    arg:r=0.0
  }

  setBlind{
    duration:p2=2.0, 5.0
  }

  recalculateTree{
  }
}

