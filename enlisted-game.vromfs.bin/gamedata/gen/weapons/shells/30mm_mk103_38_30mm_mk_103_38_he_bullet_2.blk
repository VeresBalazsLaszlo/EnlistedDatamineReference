    segment{
      radiusScale:r=1.05
      penetrationScale:r=1.0
      damageScale:r=1.0
      angles:p2=40.0, 140.0
      countPortion:r=0.9
    }

    segment{
      radiusScale:r=1.05
      penetrationScale:r=0.8
      damageScale:r=1.0
      angles:p2=140.0, 180.0
      countPortion:r=0.05
    }
  }
}

