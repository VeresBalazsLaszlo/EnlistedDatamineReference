    part:t="ex_decor_turret_03"
    part:t="ex_decor_01"
    part:t="ex_decor_03"
    part:t="ex_decor_04"
    part:t="ex_decor_05"
    part:t="ex_decor_06"
    part:t="ex_decor_07"
  }

  "turrets__initAmmoDistribution:array"{

    "ammo:object"{
      slot:i=0
      fill:b=yes
    }

    "ammo:object"{
      slot:i=1
      fill:b=yes
    }

    "ammo:object"{
      slot:i=3
      count:i=7
    }

    "ammo:object"{
      slot:i=4
      count:i=7
    }
  }
}

