    projectile_beam_tracer__fadeDist:r=0.0
    projectile_beam_tracer__beginFadeTime:r=0.1
    projectile_beam_tracer__endFadeTime:r=3.0
    projectile_beam_tracer__scrollSpeed:r=0.1
