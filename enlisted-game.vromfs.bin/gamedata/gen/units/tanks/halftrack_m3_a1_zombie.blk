        from:t="wheel_03"
        to:t="wheel_04"
        moveEdge:b=yes
      }

      projection{
        moveEdge:b=yes
        point:t="lever"
        from:t="suspension_02_01"
        to:t="suspension_02_02"
      }

      projection{
        moveEdge:b=yes
        point:t="lever"
        from:t="suspension_02_03"
        to:t="suspension_02_04"
      }

      projection{
        moveEdge:b=yes
        point:t="lever"
        from:t="suspension_02_01"
        to:t="suspension_02_03"
      }

      projection{
        movePoint:b=no
        moveEdge:b=yes
        moveEdgeNodes:b=no
