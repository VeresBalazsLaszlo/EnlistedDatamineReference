civil_vehicle_templ{
  _override:b=yes
  _use:t="vehicle_autodetect_team"
  _use:t="vehicle_marker_ui"
  _use:t="animchar_additional_data"
  team:i=-1
  vehicle__mapIcon:t="map_icon_car"
  user_point__icon:t="map_icon_car"
  isExploded:b=no
  _replicated:t="team"
  fatal_explosion_fire__endTime:r=-1.0
  fatal_explosion_fire__ttl:r=60.0

  "vehicle_seats_can_acquire_controls:list<i>"{
  }

  "vehicle_seats__canAcquireControls:shared:object"{

    "default:object"{
      movement:b=yes
    }
  }

  "disableVehicleResupply:tag"{
  }

  "scorchable:tag"{
    _tags:t="render"
  }

  "isFatalExplosionFxStarted:b"{
    _tags:t="render"
    value:b=yes
  }

  "isDestroyedFxStarted:b"{
    _tags:t="render"
    value:b=no
  }

  _group{
    _tags:t="render"

    "destroyed_fx__eids:list<eid>"{
    }

    "vehicle_fxs__effectsEids:list<eid>"{
    }
  }

  "engine_fire_fx__fx:array"{

    "fx:object"{

      "dmParts:array"{
        dmParts:t="engine"
      }

      "fx:array"{

        "fx:object"{
          name:t="tank_engine_fire_template"
          emitter:t="emtr_fire_engine"
        }

        "fx:object"{
          name:t="tank_engine_fire_template"
          emitter:t="emtr_fire_engine_01"
        }

        "fx:object"{
          name:t="tank_engine_fire_template"
          emitter:t="emtr_fire_engine_02"
        }

        "fx:object"{
          name:t="tank_engine_smoke_template"
          emitter:t="emtr_fire_engine"
        }

        "fx:object"{
          name:t="tank_engine_smoke_template"
          emitter:t="emtr_fire_engine_01"
        }

        "fx:object"{
          name:t="tank_engine_smoke_template"
          emitter:t="emtr_fire_engine_02"
        }
      }
    }
  }

  "destroyed_fx__fx:array"{

    "fx:object"{

      "dmParts:array"{
      }

      "fx:array"{

        "fx:object"{
          name:t="tank_smoke_small_template"
          emitter:t="emtr_fire_engine"
        }
      }
    }
  }
}

